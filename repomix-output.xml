        var nonMatching = _faker.With("my-test-stream");

        filter.IsMatch(matching).ShouldBeTrue();
        filter.IsMatch(nonMatching).ShouldBeFalse();
    }

    #endregion

    #region Null Checking

    [Test]
    public void evaluates_is_null_for_missing_property() {
