    }
    oneof checkpoint_after {
      int64 checkpoint_after_ticks = 6;
      int32 checkpoint_after_ms    = 15;
    }
    string consumer_strategy = 16;
  }

  enum ConsumerStrategy {
    DispatchToSingle = 0;
    RoundRobin       = 1;
    Pinned           = 2;
  }
}

