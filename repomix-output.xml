<file path="examples/processors/Processor.IoTMonitoring/TemperatureMonitorProcessor.cs">
using System.Collections.Concurrent;
using Kurrent.Processors;
using Microsoft.Extensions.Logging;
using Processor.IoTMonitoring.Events;

namespace Processor.IoTMonitoring;

/// <summary>
/// IoT sensor monitoring processor with threshold alerts and anomaly detection.
/// Demonstrates tumbling windows and real-time alerting patterns.
/// </summary>
public sealed class TemperatureMonitorProcessor : IRecordProcessor {
    const double HighTempThreshold = 80.0;  // Celsius
    const double LowTempThreshold = 10.0;   // Celsius
    const int WindowSize = 10;               // Number of readings for rolling window
    const double AnomalyStdDevMultiplier = 2.0;

    readonly ConcurrentDictionary<string, SensorState> _sensorStates = new();
    long _totalReadings;
    long _alertsRaised;

    public ValueTask ProcessRecords(ProcessRecordsContext context) {
        foreach (var record in context.Records) {
            if (record.Value is SensorReading reading) {
                ProcessReading(reading, context.Logger);
            }
        }

        return ValueTask.CompletedTask;
    }

    void ProcessReading(SensorReading reading, ILogger logger) {
        _totalReadings++;

        var state = _sensorStates.GetOrAdd(reading.SensorId, _ => new SensorState());

        // Add reading to rolling window
        state.AddReading(reading.Temperature);

        // Check threshold alerts
        CheckThresholdAlerts(reading, logger);

        // Check for anomalies (need at least 5 readings for meaningful stats)
        if (state.ReadingCount >= 5) {
            CheckAnomalyAlert(reading, state, logger);
        }

        logger.LogDebug(
            "Sensor {SensorId}: {Temp:F1}°C (avg: {Avg:F1}°C, readings: {Count})",
            reading.SensorId,
            reading.Temperature,
            state.Average,
            state.ReadingCount
        );
    }

    void CheckThresholdAlerts(SensorReading reading, ILogger logger) {
        if (reading.Temperature > HighTempThreshold) {
            _alertsRaised++;
            logger.LogWarning(
                "🔥 HIGH TEMPERATURE ALERT | Sensor: {SensorId} | Location: {Location} | Temp: {Temp:F1}°C (threshold: {Threshold}°C)",
                reading.SensorId,
                reading.Location,
                reading.Temperature,
                HighTempThreshold
            );
        } else if (reading.Temperature < LowTempThreshold) {
            _alertsRaised++;
            logger.LogWarning(
                "❄️ LOW TEMPERATURE ALERT | Sensor: {SensorId} | Location: {Location} | Temp: {Temp:F1}°C (threshold: {Threshold}°C)",
                reading.SensorId,
                reading.Location,
                reading.Temperature,
                LowTempThreshold
            );
        }
    }

    void CheckAnomalyAlert(SensorReading reading, SensorState state, ILogger logger) {
        var deviation = Math.Abs(reading.Temperature - state.Average);
        var threshold = state.StandardDeviation * AnomalyStdDevMultiplier;

        if (deviation > threshold && state.StandardDeviation > 0.1) {
            _alertsRaised++;
            logger.LogWarning(
                "⚠️ ANOMALY DETECTED | Sensor: {SensorId} | Temp: {Temp:F1}°C | Expected: {Avg:F1}°C ± {StdDev:F1}°C | Deviation: {Dev:F1}σ",
                reading.SensorId,
                reading.Temperature,
                state.Average,
                state.StandardDeviation,
                deviation / state.StandardDeviation
            );
        }
    }

    public ValueTask OnCheckpoint(CheckpointContext context) {
        context.Logger.LogInformation(
            "Checkpoint {CheckpointId} | Readings: {Readings} | Sensors: {Sensors} | Alerts: {Alerts}",
            context.CheckpointId,
            _totalReadings,
            _sensorStates.Count,
            _alertsRaised
        );

        return ValueTask.CompletedTask;
    }

    public ValueTask OnComplete(CompleteContext context) {
        context.Logger.LogInformation(
            "Completed | Total readings: {Readings}, Alerts raised: {Alerts}",
            _totalReadings,
            _alertsRaised
        );
        return ValueTask.CompletedTask;
    }

    sealed class SensorState {
        readonly Queue<double> _readings = new();
        double _sum;
        double _sumSquares;

        public int ReadingCount => _readings.Count;
        public double Average => ReadingCount > 0 ? _sum / ReadingCount : 0;

        public double StandardDeviation {
            get {
                if (ReadingCount < 2) return 0;
                var variance = (_sumSquares / ReadingCount) - (Average * Average);
                return variance > 0 ? Math.Sqrt(variance) : 0;
            }
        }

        public void AddReading(double temperature) {
            _readings.Enqueue(temperature);
            _sum += temperature;
            _sumSquares += temperature * temperature;

            // Maintain rolling window
            while (_readings.Count > WindowSize) {
                var removed = _readings.Dequeue();
                _sum -= removed;
                _sumSquares -= removed * removed;
            }
        }
    }
}
</file>

<file path="examples/processors/Processor.Leaderboard/LeaderboardProcessor.cs">
using System.Text.Json;
using Kurrent.Processors;
using Processor.Leaderboard.Events;
using StackExchange.Redis;

namespace Processor.Leaderboard;

/// <summary>
/// Real-time gaming leaderboard processor using Redis sorted sets.
/// Maintains per-game leaderboards with player rankings.
/// Demonstrates external state management with Redis.
/// </summary>
public sealed class LeaderboardProcessor(IConnectionMultiplexer redis) : IRecordProcessor {
    IDatabase Db => redis.GetDatabase();

    long _scoresProcessed;
    long _playersRegistered;

    public async ValueTask ProcessRecords(ProcessRecordsContext context) {
        foreach (var record in context.Records) {
            switch (record.Value) {
                case PlayerJoined player:
                    await RegisterPlayer(player, context.Logger);
                    break;

                case ScoreSubmitted score:
                    await ProcessScore(score, context.Logger);
                    break;
            }
        }
    }

    async ValueTask RegisterPlayer(PlayerJoined player, ILogger logger) {
        _playersRegistered++;

        var playerData = new PlayerInfo(
            player.PlayerId,
            player.DisplayName,
            player.Country,
            player.JoinedAt.ToString("O")
        );

        // Store player info as a hash
        var key = $"player:{player.PlayerId}";
        await Db.StringSetAsync(key, JsonSerializer.Serialize(playerData));

        logger.LogInformation(
            "🎮 PLAYER JOINED | {PlayerId}: {DisplayName} ({Country})",
            player.PlayerId,
            player.DisplayName,
            player.Country
        );
    }

    async ValueTask ProcessScore(ScoreSubmitted score, ILogger logger) {
        _scoresProcessed++;

        // Get leaderboard key for this game
        var leaderboardKey = $"leaderboard:{score.GameId}";

        // Get player's current best score (Redis sorted set stores highest score automatically with ZADD GT)
        var currentBest = await Db.SortedSetScoreAsync(leaderboardKey, score.PlayerId);

        // Only update if this is a new high score for the player
        if (!currentBest.HasValue || score.Score > currentBest.Value) {
            // Update the sorted set (score is the sort value, player is the member)
            await Db.SortedSetAddAsync(leaderboardKey, score.PlayerId, score.Score);

            // Get new rank (0-based, so add 1 for human-readable rank)
            var rank = await Db.SortedSetRankAsync(leaderboardKey, score.PlayerId, Order.Descending);

            // Get player display name
            var playerKey = $"player:{score.PlayerId}";
            var playerData = await Db.StringGetAsync(playerKey);
            var displayName = score.PlayerId;
            if (playerData.HasValue) {
                var player = JsonSerializer.Deserialize<PlayerInfo>(playerData.ToString());
                displayName = player?.DisplayName ?? score.PlayerId;
            }

            logger.LogInformation(
                "🏆 NEW HIGH SCORE | Game: {GameId} | Player: {Player} | Score: {Score:N0} | Rank: #{Rank}",
                score.GameId,
                displayName,
                score.Score,
                (rank ?? 0) + 1
            );

            // Log if player made it to top 10
            if (rank is <= 9) {
                logger.LogInformation(
                    "   └─ 🌟 {Player} is now in the TOP 10!",
                    displayName
                );
            }
        } else {
            logger.LogDebug(
                "Score {Score} for {Player} in {Game} - not a personal best (current: {Best})",
                score.Score,
                score.PlayerId,
                score.GameId,
                currentBest
            );
        }
    }

    public async ValueTask OnCheckpoint(CheckpointContext context) {
        // Get stats about the main leaderboard
        var mainLeaderboard = "leaderboard:main";
        var totalPlayers = await Db.SortedSetLengthAsync(mainLeaderboard);

        context.Logger.LogInformation(
            "Checkpoint {CheckpointId} | Scores: {Scores} | Players: {Players} | Leaderboard size: {Size}",
            context.CheckpointId,
            _scoresProcessed,
            _playersRegistered,
            totalPlayers
        );
    }

    public ValueTask OnComplete(CompleteContext context) {
        context.Logger.LogInformation(
            "Completed | Total scores: {Scores}, Players registered: {Players}",
            _scoresProcessed,
            _playersRegistered
        );
        return ValueTask.CompletedTask;
    }

    record PlayerInfo(string PlayerId, string DisplayName, string Country, string JoinedAt);
}
