<file path="src/Kurrent.Processors/Partitioning/DistributionManifest.cs">
using Kurrent.Client.Streams;
using Kurrent.Processors.Models;

namespace Kurrent.Client.Processors.Partitioning;

/// <summary>
/// The manifest of partition distribution across workers, including change tracking.
/// </summary>
/// <remarks>
/// A manifest captures both the current state (which worker owns which partitions)
/// and the delta from the previous state (what moved where). This enables efficient
/// rebalancing by knowing exactly which partitions need state transfer.
/// </remarks>
[PublicAPI]
public sealed record DistributionManifest {
    /// <summary>
    /// Empty manifest representing no distribution (initial state).
    /// </summary>
    public static readonly DistributionManifest Empty = new(
        new Dictionary<WorkerId, PartitionAssignment>(),
        []
    );

    /// <summary>
    /// Per-worker partition assignments with change tracking.
    /// </summary>
    public IReadOnlyDictionary<WorkerId, PartitionAssignment> Assignments { get; }

    /// <summary>
    /// Partition transfers that occurred during this distribution.
    /// </summary>
    public PartitionTransfer[] Transfers { get; }

    /// <summary>
    /// Returns true if no partitions are assigned to any worker.
    /// </summary>
    public bool IsEmpty => Assignments.Count == 0;

    /// <summary>
    /// Returns true if any partitions moved during this distribution.
    /// </summary>
    public bool HasChanges => Transfers.Length > 0;

    /// <summary>
    /// Gets the total number of partitions that moved.
    /// </summary>
    public int TotalMoved => Transfers.Sum(t => t.Partitions.Length);

    /// <summary>
    /// Creates a new distribution manifest.
    /// </summary>
    /// <param name="assignments">Per-worker partition assignments.</param>
    /// <param name="transfers">Partition transfers from previous state.</param>
    public DistributionManifest(
        IReadOnlyDictionary<WorkerId, PartitionAssignment> assignments,
        PartitionTransfer[] transfers
    ) {
        Assignments = assignments;
        Transfers = transfers;
    }

    /// <summary>
    /// Gets the assignment for a specific worker, or <see cref="PartitionAssignment.Empty"/> if not found.
    /// </summary>
    public PartitionAssignment this[WorkerId workerId] =>
        Assignments.TryGetValue(workerId, out var assignment) ? assignment : PartitionAssignment.Empty;
}

/// <summary>
/// Per-worker partition assignment with change tracking.
/// </summary>
/// <remarks>
/// Tracks which partitions a worker kept from the previous distribution,
/// which it gained, and which it lost. This enables efficient state transfer
/// during rebalancing.
/// </remarks>
/// <param name="Kept">Partitions retained from the previous assignment.</param>
/// <param name="Gained">Partitions newly assigned to this worker.</param>
/// <param name="Lost">Partitions removed from this worker.</param>
[PublicAPI]
public sealed record PartitionAssignment(
    Partition[] Kept,
    Partition[] Gained,
    Partition[] Lost
) {
    /// <summary>
    /// Empty assignment (no partitions).
    /// </summary>
    public static readonly PartitionAssignment Empty = new([], [], []);

    /// <summary>
    /// All partitions currently assigned to this worker (kept + gained).
    /// </summary>
    public Partition[] All => [..Kept, ..Gained];

    /// <summary>
    /// Returns true if partitions were gained or lost in this distribution.
    /// </summary>
    public bool HasChanges => Gained.Length > 0 || Lost.Length > 0;

    /// <summary>
    /// Total number of partitions currently assigned.
    /// </summary>
    public int Count => Kept.Length + Gained.Length;
}

/// <summary>
/// Describes a transfer of partitions from one worker to another.
/// </summary>
/// <param name="From">The worker losing the partitions (<see cref="WorkerId.None"/> if partitions are new).</param>
/// <param name="To">The worker gaining the partitions.</param>
/// <param name="Partitions">The partitions being transferred.</param>
[PublicAPI]
public sealed record PartitionTransfer(
    WorkerId From,
    WorkerId To,
    Partition[] Partitions
);
</file>

<file path="src/Kurrent.Processors/Partitioning/PartitionCalculator.cs">
using System.Buffers;
using System.Text;

namespace Kurrent.Client.Processors.Partitioning;

/// <summary>
/// Calculates which partition a key belongs to using a deterministic hash function.
/// </summary>
/// <remarks>
/// <para>
/// Partitions provide a fixed intermediate layer between keys and workers. Keys are mapped
/// to partitions deterministically, ensuring the same key always routes to the same partition.
/// </para>
/// <para>
/// <b>Thread Safety:</b> This class is thread-safe. All methods are pure functions with no shared state.
/// </para>
/// </remarks>
/// <example>
/// <code>
/// var calculator = PartitionCalculator.Default;
///
/// // Calculate partition for keys (0 to maxParallelism-1)
/// int partition1 = calculator.For("customer-123", maxParallelism: 128);
/// int partition2 = calculator.For("order-456", maxParallelism: 128);
///
/// // Same key always maps to same partition
/// Debug.Assert(calculator.For("customer-123", 128) == partition1);
/// </code>
/// </example>
[PublicAPI]
public sealed class PartitionCalculator(GenerateHashFromBytes hashGenerator) {
    /// <summary>
    /// Stack allocation threshold - keys shorter than this use stackalloc (zero allocation).
    /// </summary>
    const int StackAllocThreshold = 256;

    /// <summary>
    /// Default instance using XXHash (fastest with excellent distribution).
    /// </summary>
    public static readonly PartitionCalculator XXHash = new(HashGenerators.FromBytes.XXHash);

    /// <summary>
    /// Instance using MurmurHash3 (industry standard used by Kafka, Flink, Cassandra).
    /// </summary>
    public static readonly PartitionCalculator MurmurHash3 = new(HashGenerators.FromBytes.MurmurHash3);

    /// <summary>
    /// Calculates the partition number for a given key.
    /// </summary>
    /// <param name="key">The partition key (e.g., stream ID, customer ID).</param>
    /// <param name="maxParallelism">The total number of partitions (1 to 32768).</param>
    /// <returns>A partition number in the range [0, maxParallelism).</returns>
    /// <remarks>
    /// <para>
    /// The same key always maps to the same partition for a given maxParallelism.
    /// This ensures state locality: all records with the same key are processed by the same worker.
    /// </para>
    /// </remarks>
    public int Calculate(string key, int maxParallelism) {
        ArgumentNullException.ThrowIfNull(key);
        ArgumentOutOfRangeException.ThrowIfLessThan(maxParallelism, 1);
        ArgumentOutOfRangeException.ThrowIfGreaterThan(maxParallelism, 32768);

        var hash = ComputeHash(key, hashGenerator);

        return (int)(hash % maxParallelism);

        static uint ComputeHash(string key, GenerateHashFromBytes hashGenerator) {
            var maxByteCount = Encoding.UTF8.GetMaxByteCount(key.Length);

            // Fast path: stackalloc for small keys (zero allocation)
            if (maxByteCount <= StackAllocThreshold) {
                Span<byte> buffer = stackalloc byte[maxByteCount];
                var byteCount = Encoding.UTF8.GetBytes(key, buffer);
                return hashGenerator(buffer[..byteCount]);
            }

            // Slow path: rent from pool for large keys
            var rentedBuffer = ArrayPool<byte>.Shared.Rent(maxByteCount);
            try {
                var byteCount = Encoding.UTF8.GetBytes(key, rentedBuffer);
                return hashGenerator(rentedBuffer.AsSpan(0, byteCount));
            }
            finally {
                ArrayPool<byte>.Shared.Return(rentedBuffer);
            }
        }
    }

    /// <summary>
    /// Calculates the partition number for a given key (UTF-8 bytes).
    /// </summary>
    /// <param name="keyBytes">The partition key as UTF-8 bytes.</param>
    /// <param name="maxParallelism">The total number of partitions (1 to 32768).</param>
    /// <returns>A partition number in the range [0, maxParallelism).</returns>
    public int Calculate(ReadOnlySpan<byte> keyBytes, int maxParallelism) {
        ArgumentOutOfRangeException.ThrowIfLessThan(maxParallelism, 1);
        ArgumentOutOfRangeException.ThrowIfGreaterThan(maxParallelism, 32768);

        var hash = hashGenerator(keyBytes);
        return (int)(hash % maxParallelism);
    }
}
</file>

<file path="src/Kurrent.Processors/Partitioning/RangeStrategy.cs">
using Kurrent.Client.Streams;
using Kurrent.Processors.Models;

namespace Kurrent.Client.Processors.Partitioning;

/// <summary>
/// Distribution strategy that assigns contiguous partition ranges to workers.
/// </summary>
/// <remarks>
/// <para>
/// This strategy distributes partitions as contiguous ranges based on worker order.
/// It's deterministic and produces balanced assignments, but causes high partition
/// movement during rebalancing when workers join or leave.
/// </para>
/// <para>
/// <b>Best for:</b> Initial assignment, testing, scenarios where determinism is more
/// important than minimizing movement.
/// </para>
/// <para>
/// <b>Example with 12 partitions and 3 workers:</b>
/// <list type="bullet">
///   <item>Worker A: [0, 1, 2, 3] (4 partitions)</item>
///   <item>Worker B: [4, 5, 6, 7] (4 partitions)</item>
///   <item>Worker C: [8, 9, 10, 11] (4 partitions)</item>
/// </list>
/// </para>
/// </remarks>
[PublicAPI]
public sealed class RangeStrategy : IDistributionStrategy {
    /// <summary>
    /// Singleton instance of the range strategy.
    /// </summary>
    public static readonly RangeStrategy Instance = new();

    RangeStrategy() { }

    /// <inheritdoc />
    public DistributionManifest Distribute(
        DistributionManifest current,
        WorkerId[] workers,
        int maxParallelism
    ) {
        ArgumentOutOfRangeException.ThrowIfLessThan(maxParallelism, 1);
        ArgumentOutOfRangeException.ThrowIfGreaterThan(maxParallelism, 32768);

        if (workers.Length == 0)
            return DistributionManifest.Empty;

        // Build reverse lookup from current manifest: partition → owner
        var previousOwner = BuildOwnerLookup(current);

        // Calculate new assignments using contiguous ranges
        var newAssignments = new Dictionary<WorkerId, PartitionAssignment>();
        var transfers = new List<PartitionTransfer>();
        var transferGroups = new Dictionary<(WorkerId from, WorkerId to), List<Partition>>();

        var workerCount = workers.Length;
        var basePartitions = maxParallelism / workerCount;
        var remainder = maxParallelism % workerCount;
        var currentPartition = 0;

        for (var i = 0; i < workerCount; i++) {
            var workerId = workers[i];
            var partitionCount = basePartitions + (i < remainder ? 1 : 0);

            var kept = new List<Partition>();
            var gained = new List<Partition>();

            for (var j = 0; j < partitionCount; j++) {
                var partition = Partition.From(currentPartition++);
                var prevOwner = previousOwner.GetValueOrDefault(partition, WorkerId.None);

                if (prevOwner == workerId) {
                    kept.Add(partition);
                } else {
                    gained.Add(partition);
                    AddToGroup(transferGroups, (prevOwner, workerId), partition);
                }
            }

            // Calculate lost partitions for this worker
            var lost = new List<Partition>();
            if (current.Assignments.TryGetValue(workerId, out var prevAssignment)) {
                var newPartitions = new HashSet<Partition>(kept.Concat(gained));
                foreach (var partition in prevAssignment.All) {
                    if (!newPartitions.Contains(partition))
                        lost.Add(partition);
                }
            }

            newAssignments[workerId] = new PartitionAssignment(
                [..kept],
                [..gained],
                [..lost]
            );
        }

        // Handle workers that were removed (all their partitions are lost)
        foreach (var (workerId, prevAssignment) in current.Assignments) {
            if (!newAssignments.ContainsKey(workerId)) {
                newAssignments[workerId] = new PartitionAssignment(
                    [],
                    [],
                    prevAssignment.All
                );
            }
        }

        // Convert transfer groups to array
        var transferArray = transferGroups
            .Select(kvp => new PartitionTransfer(kvp.Key.from, kvp.Key.to, [..kvp.Value]))
            .ToArray();

        return new DistributionManifest(newAssignments, transferArray);
    }

    static Dictionary<Partition, WorkerId> BuildOwnerLookup(DistributionManifest manifest) {
        var lookup = new Dictionary<Partition, WorkerId>();
        foreach (var (workerId, assignment) in manifest.Assignments) {
            foreach (var partition in assignment.All)
                lookup[partition] = workerId;
        }
        return lookup;
    }

    static void AddToGroup(
        Dictionary<(WorkerId from, WorkerId to), List<Partition>> groups,
        (WorkerId from, WorkerId to) key,
        Partition partition
    ) {
        if (!groups.TryGetValue(key, out var list))
            groups[key] = list = [];
        list.Add(partition);
    }
}
</file>

<file path="src/Kurrent.Processors/Partitioning/StickyStrategy.cs">
using Kurrent.Client.Streams;
using Kurrent.Processors.Models;

namespace Kurrent.Client.Processors.Partitioning;

/// <summary>
/// Distribution strategy that minimizes partition movement during rebalancing.
/// </summary>
/// <remarks>
/// <para>
/// This strategy keeps existing partition assignments stable and only redistributes
/// orphaned partitions (from removed workers or newly added partitions) to the
/// least-loaded workers. This minimizes state transfer during scaling operations.
/// </para>
/// <para>
/// <b>Best for:</b> Production rebalancing when workers join or leave, scenarios
/// where minimizing partition movement is more important than perfectly balanced loads.
/// </para>
/// <para>
/// <b>Algorithm:</b>
/// <list type="number">
///   <item>Existing workers keep their current partitions</item>
///   <item>Orphaned partitions (from removed workers) are collected</item>
///   <item>New partitions (if maxParallelism increased) are collected</item>
///   <item>Orphaned/new partitions are distributed to least-loaded workers</item>
/// </list>
/// </para>
/// </remarks>
[PublicAPI]
public sealed class StickyStrategy : IDistributionStrategy {
    /// <summary>
    /// Singleton instance of the sticky strategy.
    /// </summary>
    public static readonly StickyStrategy Instance = new();

    StickyStrategy() { }

    /// <inheritdoc />
    public DistributionManifest Distribute(
        DistributionManifest current,
        WorkerId[] workers,
        int maxParallelism
    ) {
        ArgumentOutOfRangeException.ThrowIfLessThan(maxParallelism, 1);
        ArgumentOutOfRangeException.ThrowIfGreaterThan(maxParallelism, 32768);

        if (workers.Length == 0)
            return DistributionManifest.Empty;

        var workerSet = new HashSet<WorkerId>(workers);
        var transferGroups = new Dictionary<(WorkerId from, WorkerId to), List<Partition>>();

        // Track partitions per worker: kept partitions and load for balancing
        var workerKept = new Dictionary<WorkerId, List<Partition>>();
        var workerGained = new Dictionary<WorkerId, List<Partition>>();
        var workerLost = new Dictionary<WorkerId, List<Partition>>();

        foreach (var worker in workers) {
            workerKept[worker] = [];
            workerGained[worker] = [];
            workerLost[worker] = [];
        }

        // Collect orphaned partitions and determine kept partitions
        var orphanedPartitions = new List<(Partition partition, WorkerId previousOwner)>();
        var assignedPartitions = new HashSet<Partition>();

        foreach (var (workerId, assignment) in current.Assignments) {
            if (workerSet.Contains(workerId)) {
                // Worker still exists - keep its partitions
                foreach (var partition in assignment.All) {
                    if (partition.Value < maxParallelism) {
                        workerKept[workerId].Add(partition);
                        assignedPartitions.Add(partition);
                    } else {
                        // Partition no longer exists (maxParallelism decreased)
                        workerLost[workerId].Add(partition);
                    }
                }
            } else {
                // Worker removed - its partitions are orphaned
                workerLost[workerId] = [];
                foreach (var partition in assignment.All) {
                    if (partition.Value < maxParallelism) {
                        orphanedPartitions.Add((partition, workerId));
                        assignedPartitions.Add(partition); // Track to avoid double-counting as "new"
                    }
                    workerLost[workerId].Add(partition);
                }
            }
        }

        // Collect new partitions (if maxParallelism increased)
        for (var i = 0; i < maxParallelism; i++) {
            var partition = Partition.From(i);
            if (!assignedPartitions.Contains(partition))
                orphanedPartitions.Add((partition, WorkerId.None));
        }

        // Distribute orphaned partitions to least-loaded workers
        foreach (var (partition, previousOwner) in orphanedPartitions) {
            var leastLoadedWorker = GetLeastLoadedWorker(workers, workerKept, workerGained);
            workerGained[leastLoadedWorker].Add(partition);
            AddToGroup(transferGroups, (previousOwner, leastLoadedWorker), partition);
        }

        // Build assignments
        var newAssignments = new Dictionary<WorkerId, PartitionAssignment>();

        foreach (var worker in workers) {
            newAssignments[worker] = new PartitionAssignment(
                [..workerKept[worker]],
                [..workerGained[worker]],
                workerLost.TryGetValue(worker, out var lost) ? [..lost] : []
            );
        }

        // Include removed workers with their losses
        foreach (var (workerId, _) in current.Assignments) {
            if (!workerSet.Contains(workerId) && workerLost.TryGetValue(workerId, out var lost)) {
                newAssignments[workerId] = new PartitionAssignment([], [], [..lost]);
            }
        }

        var transferArray = transferGroups
            .Select(kvp => new PartitionTransfer(kvp.Key.from, kvp.Key.to, [..kvp.Value]))
            .ToArray();

        return new DistributionManifest(newAssignments, transferArray);
    }

    static WorkerId GetLeastLoadedWorker(
        WorkerId[] workers,
        Dictionary<WorkerId, List<Partition>> kept,
        Dictionary<WorkerId, List<Partition>> gained
    ) {
        WorkerId leastLoaded = workers[0];
        var minLoad = kept[leastLoaded].Count + gained[leastLoaded].Count;

        for (var i = 1; i < workers.Length; i++) {
            var worker = workers[i];
            var load = kept[worker].Count + gained[worker].Count;
            if (load < minLoad) {
                minLoad = load;
                leastLoaded = worker;
            }
        }

        return leastLoaded;
    }

    static void AddToGroup(
        Dictionary<(WorkerId from, WorkerId to), List<Partition>> groups,
        (WorkerId from, WorkerId to) key,
        Partition partition
    ) {
        if (!groups.TryGetValue(key, out var list))
            groups[key] = list = [];
        list.Add(partition);
    }
}
