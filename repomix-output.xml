<file path="proto/kurrentdb/protocol/v2/streams/errors.proto">
// ******************************************************************************************
// This protocol is UNSTABLE in the sense of being subject to change.
// ******************************************************************************************

edition = "2023";

package kurrentdb.protocol.v2.streams.errors;

option csharp_namespace = "KurrentDB.Protocol.V2.Streams.Errors";

import "kurrent/rpc/rpc.proto";

// Error codes specific to the Streams API.
// These errors represent failure modes when working with streams of records.
enum StreamsError {
  // Default value. This value is not used.
  // An error code MUST always be set to a non-zero value.
  // If an error code is not explicitly set, it MUST be treated as
  // an internal server error (INTERNAL).
  STREAMS_ERROR_UNSPECIFIED = 0;

  // The requested stream does not exist in the database.
  //
  // Common causes:
  // - Stream name typo or incorrect stream identifier
  // - Stream was never created (no events appended yet)
  // - Stream was deleted and not yet recreated
  //
  // Client action: Verify the stream name is correct. Create the stream by appending to it.
  // Recoverable by creating the stream first (append with NO_STREAM expected revision).
  STREAMS_ERROR_STREAM_NOT_FOUND = 1 [(kurrent.rpc.error) = {
    status_code: NOT_FOUND,
    has_details: true
  }];

  // The stream already exists when an operation expected it not to exist.
  //
  // Common causes:
  // - Attempting to create a stream that already has events
  // - Using NO_STREAM expected revision on an existing stream
  // - Race condition with concurrent stream creation
  //
  // Client action: Use the existing stream or use a different expected revision.
  // Recoverable by adjusting the expected revision or using the existing stream.
  STREAMS_ERROR_STREAM_ALREADY_EXISTS = 2 [(kurrent.rpc.error) = {
    status_code: ALREADY_EXISTS,
    has_details: true
  }];

  // The stream has been soft deleted.
  // Soft-deleted streams are hidden from stream lists but can be restored by appending to them.
  //
  // Common causes:
  // - Stream was explicitly soft-deleted via delete operation
  // - Attempting to read from a soft-deleted stream
  //
  // Client action: Restore the stream by appending new events, or accept that the stream is deleted.
  // Recoverable by appending to the stream to restore it.
  STREAMS_ERROR_STREAM_DELETED = 3 [(kurrent.rpc.error) = {
    status_code: FAILED_PRECONDITION,
    has_details: true
  }];

  // The stream has been tombstoned (permanently deleted).
  // Tombstoned streams cannot be restored and will never accept new events.
  //
  // Common causes:
  // - Stream was explicitly tombstoned via tombstone operation
  // - Administrative deletion of sensitive data
  // - Attempting to write to or read from a tombstoned stream
  //
  // Client action: Stream is permanently removed. Create a new stream with a different name if needed.
  // Not recoverable - the stream cannot be restored.
  STREAMS_ERROR_STREAM_TOMBSTONED = 4 [(kurrent.rpc.error) = {
    status_code: FAILED_PRECONDITION,
    has_details: true
  }];

  // The expected revision does not match the actual stream revision.
  // This is an optimistic concurrency control failure.
  //
  // Common causes:
  // - Another client modified the stream concurrently
  // - Client has stale state about the stream revision
  // - Race condition in distributed system
  //
  // Client action: Fetch the current stream revision and retry with the correct expected revision.
  // Recoverable by reading the current state and retrying with proper optimistic concurrency control.
  STREAMS_ERROR_STREAM_REVISION_CONFLICT = 5 [(kurrent.rpc.error) = {
    status_code: FAILED_PRECONDITION,
    has_details: true
  }];

  // The same stream appears multiple times in a single append session.
  // This is currently not supported to prevent complexity with expected revisions and ordering.
  //
  // Common causes:
  // - Accidentally appending to the same stream twice in one session
  // - Application logic error in batch operations
  //
  // Client action: Remove duplicate streams from the append session or split into multiple sessions.
  // Recoverable by restructuring the append session to reference each stream only once.
  STREAMS_ERROR_STREAM_ALREADY_IN_APPEND_SESSION = 8 [(kurrent.rpc.error) = {
    status_code: ABORTED
  }];

  // An append session was started but no append requests were sent before completing the stream.
  //
  // Common causes:
  // - Client completed the stream without sending any AppendRequest messages
  // - Application logic error
  //
  // Client action: Ensure at least one AppendRequest is sent before completing the stream.
  // Recoverable by properly implementing the append session protocol.
  STREAMS_ERROR_APPEND_SESSION_NO_REQUESTS = 9 [(kurrent.rpc.error) = {
    status_code: FAILED_PRECONDITION
  }];

  // A single record being appended exceeds the maximum allowed size.
  //
  // Common causes:
  // - Record payload is too large (exceeds server's max record size configuration)
  // - Excessive metadata in properties
  // - Large binary data without chunking
  //
  // Client action: Reduce record size, split large payloads across multiple records, or increase server limits.
  // Recoverable by reducing record size or adjusting server configuration.
  STREAMS_ERROR_MAX_APPEND_RECORD_SIZE_EXCEEDED = 6 [(kurrent.rpc.error) = {
    status_code: INVALID_ARGUMENT,
    has_details: true
  }];

  // The total size of all records in a single append session exceeds the maximum allowed transaction size.
  //
  // Common causes:
  // - Too many records in a single append session
  // - Combined payload size exceeds server's max transaction size
  // - Attempting to write very large batches
  //
  // Client action: Split the append into multiple smaller transactions.
  // Recoverable by reducing the number of records per append session.
  STREAMS_ERROR_MAX_APPEND_TRANSACTION_SIZE_EXCEEDED = 7 [(kurrent.rpc.error) = {
    status_code: ABORTED,
    has_details: true
  }];

  STREAMS_ERROR_RECORD_NOT_FOUND = 10 [(kurrent.rpc.error) = {
    status_code: NOT_FOUND
  }];

  STREAMS_ERROR_LOG_POSITION_NOT_FOUND = 11 [(kurrent.rpc.error) = {
    status_code: NOT_FOUND
  }];

  STREAMS_ERROR_STREAM_REVISION_NOT_FOUND = 12 [(kurrent.rpc.error) = {
    status_code: NOT_FOUND
  }];

  // One or more consistency checks failed during an AppendRecords operation.
  // The transaction is aborted — no records are written.
  //
  // Common causes:
  // - A stream revision check found the stream at a different revision than expected
  // - A stream referenced in a revision check does not exist, was deleted, or was tombstoned
  // - A query-based check evaluated to false
  //
  // Client action: Inspect the ConsistencyCheckFailedErrorDetails to determine which checks
  // failed and why, then correct the request or refresh local state and retry.
  // Recoverable by reading the current state and resubmitting with updated checks.
  STREAMS_ERROR_CONSISTENCY_CHECK_FAILED = 13 [(kurrent.rpc.error) = {
    status_code: FAILED_PRECONDITION,
    has_details: true
  }];
}

// Details for CONSISTENCY_CHECK_FAILED errors.
//
// Contains a map of all checks that failed, keyed by their zero-based index
// in the original AppendRecordsRequest.consistency_checks list.
// Only failed checks are included; passing checks are omitted.
message ConsistencyCheckFailedErrorDetails {
  // Map from the check index (position in consistency_checks) to its failure details.
  // Enables the client to correlate each failure back to the specific check that was sent.
  map<uint32, ConsistencyCheckError> failed_checks = 1;
}

// Failure details for a single consistency check.
//
// Mirrors the ConsistencyCheck oneof: a revision check produces RevisionCheckError,
// a query check produces QueryCheckError.
message ConsistencyCheckError {
  oneof type {
    // Failure details when a stream revision check did not hold.
    RevisionCheckError revision = 1;

    // Failure details when a query-based check evaluated to false.
    QueryCheckError query = 2;
  }

  // A stream revision check failed because the actual state did not satisfy the expected value.
  //
  // The actual_revision field reports the stream's state:
  //   >= 0   : The stream exists and is at this revision
  //   -1     : The stream does not exist (NO_STREAM)
  //   -10    : The stream has been soft-deleted (DELETED)
  //   -100   : The stream has been tombstoned (TOMBSTONED)
  //
  // Note: ANY (-2) and EXISTS (-4) are never returned as actual_revision values.
  // When a stream exists, the server returns the actual revision number (>= 0).
  message RevisionCheckError {
    // The name of the stream that failed the check.
    string stream = 1;

    // The actual state of the stream at the time the check was evaluated.
    // Non-negative values (>= 0) are real revision numbers.
    // Negative values are RevisionConstants sentinels: -1 (NO_STREAM), -10 (DELETED), -100 (TOMBSTONED).
    sint64 actual_revision = 2;
  }

  // A query-based consistency check evaluated to false.
  // No additional details are currently provided.
  message QueryCheckError { }
}

// Details for STREAM_REVISION_CONFLICT errors.
message StreamRevisionConflictErrorDetails {
  // The name of the stream that had a revision conflict.
  string stream = 1;

  // The expected revision that was provided in the append request.
  sint64 expected_revision = 2;

  // The actual current revision of the stream.
  sint64 actual_revision = 3;
}

// Details for APPEND_RECORD_SIZE_EXCEEDED errors.
message AppendRecordSizeExceededErrorDetails {
  // The name of the stream where the append was attempted.
  string stream = 1;

  // The identifier of the record that exceeded the size limit.
  string record_id = 2;

  // The actual size of the record in bytes.
  int32 size = 3;

  // The maximum allowed size of a single record in bytes.
  int32 max_size = 4;
}

// Details for APPEND_TRANSACTION_SIZE_EXCEEDED errors.
message AppendTransactionSizeExceededErrorDetails {
  // The actual size of the transaction in bytes.
  int32 size = 1;

  // The maximum allowed size of an append transaction in bytes.
  int32 max_size = 2;
}

// Details for STREAM_ALREADY_IN_APPEND_SESSION errors.
message StreamAlreadyInAppendSessionErrorDetails {
  // The name of the stream that appears multiple times.
  string stream = 1;
}

// Details for STREAM_NOT_FOUND errors.
message StreamNotFoundErrorDetails {
  // The name of the stream that was not found.
  string stream = 1;
}

// Details for STREAM_ALREADY_EXISTS errors.
message StreamAlreadyExistsErrorDetails {
  // The name of the stream that already exists.
  string stream = 1;
}

// Details for STREAM_DELETED errors.
message StreamDeletedErrorDetails {
  // The name of the stream that was deleted.
  string stream = 1;
}

// Details for STREAM_TOMBSTONED errors.
message StreamTombstonedErrorDetails {
  // The name of the stream that was tombstoned.
  string stream = 1;
}
</file>

<file path="proto/kurrentdb/protocol/v2/streams/streams.proto">
// ******************************************************************************************
// This protocol is UNSTABLE in the sense of being subject to change.
// ******************************************************************************************

edition = "2023";

package kurrentdb.protocol.v2.streams;

option csharp_namespace = "KurrentDB.Protocol.V2.Streams";

import "google/protobuf/struct.proto";
import "google/protobuf/timestamp.proto";
import "kurrent/rpc/rpc.proto";

import "kurrentdb/protocol/v2/streams/shared.proto";

service StreamsService {
  // Appends records to multiple streams atomically within a single transaction.
  //
  // This is a client-streaming RPC where the client sends multiple AppendRequest messages
  // (one per stream) and receives a single AppendSessionResponse upon commit.
  //
  // Guarantees:
  // - Atomicity: All writes succeed or all fail together
  // - Optimistic Concurrency: Expected revisions are validated for all streams before commit
  // - Ordering: Records within each stream maintain send order
  //
  // Current Limitations:
  // - Each stream can only appear once per session (no multiple appends to same stream)
  //
  // Example flow:
  //   1. Client opens stream
  //   2. Client sends AppendRequest for stream "orders" with 3 records
  //   3. Client sends AppendRequest for stream "inventory" with 2 records
  //   4. Client completes the stream
  //   5. Server validates, commits, returns AppendSessionResponse with positions
  //
  // Common errors (automatically apply to all operations):
  // - UNAUTHENTICATED: No valid authentication credentials
  // - ACCESS_DENIED: User lacks write permission
  // - NOT_LEADER_NODE: Server is not the cluster leader
  // - INTERNAL: Internal server error
  // - UNAVAILABLE: Service unavailable
  // - BAD_REQUEST: Request contains invalid data
  rpc AppendSession(stream AppendRequest) returns (AppendSessionResponse) {
    option (kurrent.rpc.possible_errors) =
      "NOT_FOUND,"
      "ALREADY_EXISTS,"
      "DELETED,"
      "STREAM_TOMBSTONED,"
      "STREAM_REVISION_CONFLICT,"
      "STREAM_ALREADY_IN_APPEND_SESSION,"
      "APPEND_SESSION_NO_REQUESTS,"
      "MAX_APPEND_RECORD_SIZE_EXCEEDED,"
      "MAX_APPEND_TRANSACTION_SIZE_EXCEEDED";
  }

  // Appends records to multiple streams atomically within a single transaction.
  //
  // This is a unary RPC where the client sends a single AppendRecordsRequest containing
  // all records and consistency checks, and receives a single AppendRecordsResponse.
  //
  // Records specify their target stream individually via the AppendRecord.stream field,
  // allowing a single request to write to multiple streams.
  //
  // Guarantees:
  // - Atomicity: All records across all streams are committed or all fail together
  // - Ordering: Records within each stream maintain their order from the request
  //
  // Consistency checks are evaluated before commit. They can validate:
  // - Stream revisions: A specific stream must be at an expected revision
  // - Queries: Arbitrary server-side expressions that must hold true
  //
  // Example flow:
  //   1. Client builds request with records targeting "orders" and "inventory" streams
  //   2. Client adds consistency checks (e.g., "orders" must be at revision 5)
  //   3. Client sends the request
  //   4. Server validates consistency checks, commits, returns stream revisions and position
  //
  // Common errors (automatically apply to all operations):
  // - UNAUTHENTICATED: No valid authentication credentials
  // - ACCESS_DENIED: User lacks write permission
  // - NOT_LEADER_NODE: Server is not the cluster leader
  // - INTERNAL: Internal server error
  // - UNAVAILABLE: Service unavailable
  // - BAD_REQUEST: Request contains invalid data
  rpc AppendRecords(AppendRecordsRequest) returns (AppendRecordsResponse);
}

// Request to append records to one or more streams atomically.
//
// All records are committed in a single transaction. Each record specifies
// its target stream via AppendRecord.stream. Consistency checks are evaluated
// before any records are written.
message AppendRecordsRequest {
  // The records to append.
  // Each record specifies its target stream via the AppendRecord.stream field.
  // Records targeting the same stream maintain their order from this list.
  repeated AppendRecord records = 1;

  // Optional consistency checks evaluated before commit.
  // If any check fails, the entire transaction is aborted.
  // Can include stream revision checks and/or query-based conditions.
  repeated ConsistencyCheck consistency_checks = 2;
}

// Response from a successful AppendRecords operation.
//
// Contains the resulting revision for each stream that was written to,
// and the global commit position of the transaction.
message AppendRecordsResponse {
  // The resulting revision for each stream that received records.
  // One entry per distinct stream written to, in no guaranteed order.
  repeated StreamRevision revisions = 1;

  // The global commit position of the last record written in this transaction.
  // Can be used for read-your-writes consistency or progress tracking.
  sint64 position = 2;
}

// A pre-commit condition that must hold true for the transaction to succeed.
//
// Consistency checks are evaluated atomically before any records are written.
// If any check fails, the entire transaction is aborted.
//
// Two types of checks are supported:
// - Revision: Validates a stream's state using writability semantics (see RevisionConstants)
// - Query: Evaluates a server-side expression (e.g., cross-stream invariants)
message ConsistencyCheck {
  oneof type {
    // Check that a stream is at a specific state.
    // The revision field accepts RevisionConstants values or a specific revision number (>= 0).
    // Checks are evaluated using writability semantics — see RevisionConstants for the
    // full pass/fail matrix.
    StreamRevision revision = 1;

    // Evaluate a server-side query expression.
    // The transaction is aborted if the expression evaluates to false.
    Query query = 2;
  }
}

// A stream paired with its revision number.
//
// Used in two contexts:
// - As a consistency check: Asserts the stream is at the expected state before commit.
//   Accepts RevisionConstants values (-100, -10, -4, -2, -1) or a specific revision (>= 0).
//   Evaluated using writability semantics — see RevisionConstants for the full pass/fail matrix.
// - As a response field: Reports the actual revision of a stream after a successful write.
message StreamRevision {
  // The stream name.
  string stream = 1;

  // The revision number.
  // When used as a consistency check, this is the expected state (RevisionConstants or >= 0).
  // When used in a response, this is the actual revision after the write.
  sint64 revision = 2;
}

// A server-side query expression used as a consistency check.
//
// The expression is evaluated before commit. If it evaluates to false,
// the entire transaction is aborted. Can be used to enforce cross-stream
// invariants or other complex preconditions.
message Query {
  // The query expression to evaluate.
  string expression = 1;
}


// Revision constants used in consistency checks and error details.
//
// These constants cover both directions:
// - Input: Expected state sent by the client in consistency checks
// - Output: Actual state returned by the server in error details
//
// Non-negative values (>= 0) represent actual stream revision numbers.
// Negative values represent special stream states or semantics.
//
// Consistency checks validate **writability**, not just existence:
// - A soft-deleted stream is writable (appending restores it)
// - A tombstoned stream is never writable (permanently sealed)
//
// Not all values are valid in both directions:
// - ANY (-2) and EXISTS (-4) are input-only (never returned as output)
//
// Pass/fail matrix (rows = input, columns = actual state):
//
//   Input \ Actual   | Revision M (>= 0) | NO_STREAM | DELETED  | TOMBSTONED
//   -----------------|--------------------|-----------|----------|----------
//   Revision N (>= 0)| pass (M = N)       | fail: -1  | pass (M = N) / fail: ? | fail: -100
//   NO_STREAM  (-1)  | fail: M            | pass      | pass     | fail: -100
//   ANY        (-2)  | pass               | pass      | pass     | fail: -100
//   EXISTS     (-4)  | pass               | fail: -1  | fail: -10| fail: -100
//   DELETED    (-10) | fail: M            | fail: -1  | pass     | fail: -100
//   TOMBSTONED (-100)| fail: M            | fail: -1  | fail: -10| pass
//
enum RevisionConstants {
  option allow_alias = true;

  // Default protobuf enum value. Aliases SINGLE_EVENT (0).
  // Avoid using directly — prefer SINGLE_EVENT for clarity.
  REVISION_CONSTANTS_UNSPECIFIED = 0;

  // Revision 0: the first revision of a stream.
  // Input: The stream must be at revision 0 (has exactly one record).
  // Output: The stream is at revision 0.
  REVISION_CONSTANTS_SINGLE_EVENT = 0;

  // Input: The stream must be writable as new — either it does not exist,
  //        or it has been soft-deleted (appending restores it).
  // Output: The stream does not exist (never created or fully removed).
  REVISION_CONSTANTS_NO_STREAM = -1;

  // Input only: Accept any writable state (no concurrency check).
  //             Passes for all states except TOMBSTONED.
  // Not valid as an output value.
  REVISION_CONSTANTS_ANY = -2;

  // Input only: The stream must be active (exist with a revision >= 0).
  //             Fails for NO_STREAM, DELETED, and TOMBSTONED.
  //             Note: a scavenged stream with no remaining records still
  //             satisfies this check if it has a revision.
  // Not valid as an output value.
  REVISION_CONSTANTS_EXISTS = -4;

  // Input: The stream must be soft-deleted.
  // Output: The stream has been soft-deleted.
  // A soft-deleted stream can be restored by appending new records.
  REVISION_CONSTANTS_DELETED = -10;

  // Input: The stream must be tombstoned.
  // Output: The stream has been tombstoned (permanently deleted).
  // A tombstoned stream cannot be restored or written to.
  REVISION_CONSTANTS_TOMBSTONED = -100;
}


// Represents the input for appending records to a specific stream.
message AppendRequest {
  // The stream to append records to.
  string stream = 1;

  // The records to append to the stream.
  repeated AppendRecord records = 2;

  // The expected revision for optimistic concurrency control.
  // Can be either:
  // - A specific revision number (0, 1, 2, ...) - the stream must be at exactly this revision
  // - An ExpectedRevisionConstants value (-4, -2, -1) for special semantics
  //
  // If omitted, defaults to EXPECTED_REVISION_CONSTANTS_ANY (-2).
  sint64 expected_revision = 3;
}

// Represents the outcome of an append operation.
message AppendResponse {
  // The stream to which records were appended.
  string stream = 1;

  // The actual/current revision of the stream after the append.
  // This is the revision number of the last record written to this stream.
  sint64 stream_revision = 2;

  // The position of the last appended record in the global log.
  sint64 position = 3;
}

message AppendSessionResponse {
  // The results of each append request in the session.
  repeated AppendResponse output = 1;

  // The global commit position of the last appended record in the session.
  sint64 position = 2;
}

// Record to be appended to a stream.
message AppendRecord {
  // Unique identifier for this record (must be a valid UUID/GUID).
  // If not provided, the server will generate a new one.
  string record_id = 1;

  // A collection of properties providing additional information about the
  // record. Can contain user-defined or system propreties.
  // System keys will be prefixed with "$" (e.g., "$timestamp").
  // User-defined keys MUST NOT start with "$".
  //
  // Common examples:
  //   User metadata:
  //     - "user-id": "12345"
  //     - "tenant": "acme-corp"
  //     - "source": "mobile-app"
  //
  //   System metadata (with $ prefix):
  //     - "$trace-id": "4bf92f3577b34da6a3ce929d0e0e4736"  // OpenTelemetry trace ID
  //     - "$span-id": "00f067aa0ba902b7"                   // OpenTelemetry span ID
  //     - "$timestamp": "2025-01-15T10:30:00.000Z"         // ISO 8601 timestamp
  map<string, google.protobuf.Value> properties = 2;

  // Schema information for this record.
  SchemaInfo schema = 3;

  // The record payload as raw bytes.
  // The format specified in SchemaInfo determines how to interpret these bytes.
  bytes data = 4;

  // The stream to which this record should be appended. This allows multiple records for different streams to be sent in a single request.
  string stream = 5;
}

// Constants for expected revision validation in optimistic concurrency control.
// These can be used in the expected_revision field, or you can specify an actual revision number.
enum ExpectedRevisionConstants {
  // The stream must have exactly one event at revision 0.
  // Used for scenarios requiring strict single-event semantics.
  EXPECTED_REVISION_CONSTANTS_SINGLE_EVENT = 0;
//  EXPECTED_REVISION_CONSTANTS_SINGLE_RECORD = 0;

  // The stream must not exist yet (first write to the stream).
  // Fails if the stream already has events.
  EXPECTED_REVISION_CONSTANTS_NO_STREAM = -1;

  // Accept any current state of the stream (no optimistic concurrency check).
  // The write will succeed regardless of the stream's current revision.
  EXPECTED_REVISION_CONSTANTS_ANY = -2;

  // The stream must exist (have at least one record).
  // Fails if the stream doesn't exist yet.
  EXPECTED_REVISION_CONSTANTS_EXISTS = -4;
}

//// Configuration for progress heartbeats during filtered reads.
////
//// Heartbeats provide progress visibility when a filter excludes records.
//// Without heartbeats, a worker processing a filter that matches few
//// records would have no way to know its actual position in the log.
////
//// Heartbeats report the current log position even when no records
//// are delivered, allowing workers to:
//// - Track progress through the log
//// - Detect when caught up to the head
//// - Confirm the connection is alive during quiet periods
////
//// Useful when:
//// - Filter uses predicates that exclude most records
//// - Low-traffic scenarios where liveness confirmation is needed
////
//// Less useful when:
//// - No filter is set (every record provides position information)
//// - Filter selects a single stream (stream head is known)
//message HeartbeatSettings {
//  // Send heartbeat after scanning N non-matching records.
//  //
//  // During filtered processing, the server scans records looking
//  // for matches. This setting triggers a heartbeat after scanning
//  // this many non-matching records, providing progress visibility.
//  //
//  // Smaller values: More frequent progress updates, higher overhead.
//  // Larger values: Less overhead, less granular progress tracking.
//  //
//  // Default: 1000
//  // Range: 1-100000
//  int32 records_threshold = 1;
//
//  // Send heartbeat every N milliseconds if no records sent.
//  //
//  // Triggers a heartbeat after this duration of silence (no records
//  // delivered). Provides liveness confirmation during low-traffic
//  // periods or when caught up to the head.
//  //
//  // Default: 10000 (10 seconds)
//  // Range: 100-300000
//  int64 interval_ms = 2;
//}
//
//// The type of heartbeat sent by the server.
////
//// Heartbeats provide progress visibility and status updates during
//// stream processing, especially important for filtered processing
//// where records may not match.
//enum HeartbeatType {
//  HEARTBEAT_TYPE_UNSPECIFIED = 0;
//
//  // Progress update during filtered processing.
//  //
//  // Sent when the server has scanned records_threshold non-matching
//  // records, or after interval_ms of silence. Indicates the server
//  // is still working and reports current position.
//  HEARTBEAT_TYPE_PROGRESS = 1;
//
//  // Worker has caught up to the head of the log.
//  //
//  // Sent when position reaches latest_position. The worker is now
//  // processing in real-time.
//  HEARTBEAT_TYPE_CAUGHT_UP = 2;
//
//  // Worker has fallen behind after being caught up.
//  //
//  // Sent when a worker that was caught up is now behind the head.
//  // Can be used to trigger alerts or scaling decisions.
//  HEARTBEAT_TYPE_FELL_BEHIND = 3;
//}
//
//// Heartbeat message sent by the server during stream processing.
////
//// Provides progress updates, caught-up/fell-behind notifications,
//// and current log boundaries for lag calculation.
//message Heartbeat {
//  // The type of heartbeat.
//  HeartbeatType type = 1;
//
//  // Current processing position.
//  //
//  // For PROGRESS: The position the server has scanned up to.
//  // For CAUGHT_UP: Same as latest_position.
//  // For FELL_BEHIND: The position where the worker currently is.
//  RecordPosition position = 2;
//
//  // When this heartbeat was sent.
//  google.protobuf.Timestamp timestamp = 3;
//
//  // Earliest available position (tail of log).
//  //
//  // The oldest record still available. Use to detect if checkpoints
//  // have been scavenged: if checkpoint < earliest_position, data was lost.
//  RecordPosition earliest_position = 4;
//
//  // Latest available position (head of log).
//  //
//  // The newest record in the log. Use for lag calculation:
//  // lag = latest_position - position
//  //
//  // When type is CAUGHT_UP, position equals latest_position.
//  RecordPosition latest_position = 5;
//}
