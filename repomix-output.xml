<file path="src/Kurrent.Client/Internal/Options/OptionsBuilder.cs">
using Kurrent.Client;

namespace Kurrent;

/// <summary>
/// Base class for all option builders that provides the core transformation mechanism.
/// </summary>
/// <typeparam name="TBuilder">The concrete builder type for fluent chaining</typeparam>
/// <typeparam name="TOptions">The options type being built</typeparam>
public abstract class OptionsBuilder<TBuilder, TOptions>
    where TBuilder : OptionsBuilder<TBuilder, TOptions>, new()
    where TOptions : class, new() {

    /// <summary>
    /// Initializes a new instance of the <see cref="OptionsBuilder{TBuilder, TOptions}"/> class with default options.
    /// </summary>
    protected OptionsBuilder(TOptions options) => Transforms.Add(_ => options);

    List<Func<TOptions, TOptions>> Transforms { get; } = [];

    /// <summary>
    /// Applies a transformation and returns the same builder instance for chaining.
    /// </summary>
    public TBuilder With(Func<TOptions, TOptions> transformation) {
        Transforms.Add(transformation);
        return (TBuilder)this;
    }

    /// <summary>
    /// Configures options using a sub-builder.
    /// </summary>
    /// <typeparam name="TSubBuilder">The type of sub-builder to create.</typeparam>
    /// <param name="configure">Action to configure the sub-builder</param>
    /// <returns>The same builder instance for chaining</returns>
    protected TBuilder WithBuilder<TSubBuilder>(Action<TSubBuilder> configure) where TSubBuilder : OptionsBuilder<TSubBuilder, TOptions>, new() =>
        With(options => new TSubBuilder().WithInitialOptions(options).With(configure).GetOptions());

    /// <summary>
    /// Builds the final options instance after applying all configurations.
    /// </summary>
    [PublicAPI]
    public TOptions Build() {
        var options = GetOptions();
        return OnBuild(options);
    }

    /// <summary>
    /// Hook for finalizing the options after all transformations are applied.
    /// This method can be overridden in derived classes to perform additional validation or final adjustments.
    /// The default implementation simply returns the options as is.
    /// </summary>
    /// <remarks>
    /// This method is called after all transformations have been applied, so it can assume the options
    /// are in a consistent state.
    /// </remarks>
    protected virtual TOptions OnBuild(TOptions options) => options;

    /// <summary>
    /// Initializes the builder with the provided options, resetting any existing transformations.
    /// Used internally with sub builders.
    /// </summary>
    TBuilder WithInitialOptions(TOptions options) {
        Transforms.Clear();
        Transforms.Add(_ => options);
        return (TBuilder)this;
    }

    /// <summary>
    /// Builds the final options instance by applying all accumulated transformations.
    /// </summary>
    TOptions GetOptions() =>
        Transforms.Aggregate(new TOptions(), (options, transform) => transform(options));
}
</file>

<file path="src/Kurrent.Client/Internal/Validation/Validation.cs">
using System.Diagnostics;
using System.Diagnostics.CodeAnalysis;
using Humanizer;
using Kurrent.Client.Exceptions;

namespace Kurrent.Validation;

public sealed partial record ValidationResult : IResultBase<Success, ValidationError>;

[PublicAPI]
[DebuggerDisplay("{ErrorCode} | {ErrorMessage}")]
public record  ValidationError : ResultError {
    public static readonly ValidationError None = new(ErrorCode.None, "");

    public ValidationError(ErrorCode errorCode, string errorMessage, params ValidationProblem[] problems) {
        ErrorCode    = errorCode;
        ErrorMessage = errorMessage;
        Problems     = problems;
    }

    /// <summary>
    /// The validation problems that occurred during the validation process.
    /// </summary>
    public ValidationProblem[] Problems { get; private init; }

    public override Exception GetOrCreateException() =>
        new ValidationException(ErrorCode, ErrorMessage, Problems);

    public static ValidationError Create(ErrorCode code, params ValidationProblem[] problems) {
        ArgumentOutOfRangeException.ThrowIfLessThanOrEqual(problems.Length, 0);

        return new ValidationError(code, BuildErrorMessage(), problems);

        string BuildErrorMessage() {
            var arr = problems.Select(x => $"{Environment.NewLine} -- {x.FieldName}: {x.Message}");
            return $"Validation failed: {string.Join(string.Empty, arr)}";
        }
    }

    public static ValidationError Create(params ValidationProblem[] problems) =>
        Create(ErrorCode.From("VALIDATION_ERROR"), problems);

    public static ValidationError FromProblem(ErrorCode code, string message) =>
        Create(ValidationProblem.Create(code, message));
}

[PublicAPI]
[DebuggerDisplay("{Code} | {Message}")]
public readonly record struct ValidationProblem {
    public static readonly ValidationProblem None;

    /// <summary>
    /// The code associated with the validation problem.
    /// This can be used to categorize or identify the type of validation problem.
    /// </summary>
    public string Code { get; private init; }

    /// <summary>
    /// The message describing the validation problem.
    /// </summary>
    public string Message { get; private init; }

    /// <summary>
    /// The name of the field that caused the validation problem.
    /// </summary>
    public string FieldName { get; private init; }

    /// <summary>
    /// The field value that caused the problem.
    /// </summary>
    [MaybeNull]
    public object AttemptedValue { get; private init; }

    /// <summary>
    /// Indicates whether this validation problem is associated with a specific field.
    /// </summary>
    public bool HasPropertyName => !string.IsNullOrWhiteSpace(FieldName);

    /// <summary>
    /// Indicates whether this validation problem has an associated value.
    /// </summary>
    public bool HasAttemptedValue => AttemptedValue is not null;

    public override string ToString() => Message;

    /// <summary>
    /// Creates a new <see cref="ValidationProblem"/> for a specific field.
    /// </summary>
    public static ValidationProblem CreateForField(string fieldName, string message, object? attemptedValue = null, string? code = null) {
        ArgumentException.ThrowIfNullOrWhiteSpace(fieldName);
        ArgumentException.ThrowIfNullOrWhiteSpace(message);

        return new ValidationProblem {
            FieldName   = fieldName,
            Message   = message,
            AttemptedValue = attemptedValue!,
            Code      = string.IsNullOrWhiteSpace(code) ? $"INVALID_{fieldName.Underscore().ToUpperInvariant()}" : code
        };
    }

    /// <summary>
    /// Creates a new <see cref="ValidationProblem"/> without a specific field.
    /// This is useful for general validation problems that do not pertain to a specific field.
    /// </summary>
    public static ValidationProblem Create(string code, string message) {
        ArgumentException.ThrowIfNullOrWhiteSpace(code);
        ArgumentException.ThrowIfNullOrWhiteSpace(message);

        return new ValidationProblem {
            Code    = code,
            Message = message
        };
    }
}

public interface IValidator<in T> where T : class {
    ValidationResult ValidateOptions(T instance);
}

