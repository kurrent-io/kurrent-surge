<file path="src/Kurrent.Processors/Checkpointing/PositionTracker.cs">
using System.Buffers;
using System.Collections.Frozen;
using System.Collections.Immutable;
using Kurrent.Client.Streams;

namespace Kurrent.Processors.Checkpointing;

/// <summary>
/// High-performance position tracker using ArrayPool for single-threaded partition processing.
/// </summary>
/// <remarks>
/// <para>
/// This implementation is optimized for scenarios where each partition has a dedicated tracker
/// and positions arrive strictly in order. All read operations return spans into the internal
/// buffer with zero allocations.
/// </para>
/// <para>
/// <b>IMPORTANT:</b> Returned spans are valid only until the next mutating operation.
/// Callers must consume span data immediately. This tracker is NOT thread-safe.
/// </para>
/// <para>
/// The implementation uses a linear buffer with a compaction strategy. When the buffer runs
/// out of space, it first attempts to compact by moving elements to the front. If compaction
/// is insufficient, it grows the buffer using ArrayPool.
/// </para>
/// </remarks>
[PublicAPI]
public sealed class PositionTracker : IPositionTracker {
    const int DefaultCapacity = 4096;
    const int MinimumCapacity = 256;

    RecordPosition[] _buffer;

    int  _start;
    int  _count;
    bool _disposed;

    /// <summary>
    /// Initializes a new instance with the default capacity of 4096 positions.
    /// </summary>
    public PositionTracker() : this(DefaultCapacity) { }

    /// <summary>
    /// Initializes a new instance with the specified initial capacity.
    /// </summary>
    /// <param name="capacity">The initial capacity. Must be at least 256.</param>
    public PositionTracker(int capacity) {
        ArgumentOutOfRangeException.ThrowIfLessThan(capacity, MinimumCapacity);
        _buffer = ArrayPool<RecordPosition>.Shared.Rent(capacity);
    }

    /// <summary>
    /// Initializes a new instance with the specified last flushed position.
    /// </summary>
    public PositionTracker(RecordPosition lastFlushedPosition) : this() {
        LastFlushedPosition = lastFlushedPosition;
    }

    /// <inheritdoc />
    public RecordPosition[] Positions {
        get {
            ObjectDisposedException.ThrowIf(_disposed, this);
            return _count == 0
                ? []
                : _buffer.AsSpan(_start, _count).ToArray();
        }
    }

    /// <inheritdoc />
    public RecordPosition LastFlushedPosition { get; private set; } = RecordPosition.Unset;

    /// <inheritdoc />
    public int Track(RecordPosition position) {
        ObjectDisposedException.ThrowIf(_disposed, this);

        if (position == RecordPosition.Unset)
            throw new ArgumentException("Position cannot be Unset", nameof(position));

        if (LastFlushedPosition != RecordPosition.Unset && position <= LastFlushedPosition)
            throw new InvalidOperationException(
                $"Tracked position {position.LogPosition} must be greater than last flushed position {LastFlushedPosition.LogPosition}");

        EnsureCapacity();

        _buffer[_start + _count] = position;
        _count++;

        return _count;
    }

    /// <inheritdoc />
    public RecordPosition[] FlushUpTo(RecordPosition position) {
        ObjectDisposedException.ThrowIf(_disposed, this);

        // Find positions up to the specified position
        var count = 0;
        for (var i = 0; i < _count; i++) {
            if (_buffer[_start + i] > position)
                break;

            count = i + 1;
        }

        if (count == 0)
            return [];

        var positionsToFlush = _buffer.AsSpan(_start, count).ToArray();
        LastFlushedPosition  = positionsToFlush[^1];

        _start += count;
        _count -= count;

        return positionsToFlush;
    }

    /// <summary>
    /// Ensures there is capacity for at least one more element.
    /// Compacts first if possible, then grows if needed.
    /// </summary>
    void EnsureCapacity() {
        if (_start + _count < _buffer.Length)
            return;

        // Try compaction first (move elements to front)
        if (_start > 0) {
            _buffer
                .AsSpan(_start, _count)
                .CopyTo(_buffer.AsSpan(0, _count));

            _start = 0;

            if (_count < _buffer.Length)
                return;
        }

        // Need to grow - rent a larger buffer
        var newCapacity = Math.Max(_buffer.Length * 2, _buffer.Length + 1024);

        var newBuffer = ArrayPool<RecordPosition>
            .Shared.Rent(newCapacity);

        _buffer.AsSpan(0, _count).CopyTo(newBuffer);

        ArrayPool<RecordPosition>
            .Shared.Return(_buffer);

        _buffer = newBuffer;
    }

    /// <summary>
    /// Resets the tracker to a new initial state, reusing the internal buffer.
    /// </summary>
    /// <param name="lastFlushedPosition">The new last flushed position.</param>
    public void Reset(RecordPosition lastFlushedPosition) {
        ObjectDisposedException.ThrowIf(_disposed, this);
        _start = 0;
        _count = 0;
        LastFlushedPosition = lastFlushedPosition;
    }

    /// <inheritdoc />
    public void Dispose() {
        if (_disposed)
            return;

        ArrayPool<RecordPosition>.Shared
            .Return(_buffer);

        _buffer   = [];
        _disposed = true;
    }
}

/// <summary>
/// Manages position tracking across multiple partitions. Not thread-safe.
/// </summary>
[PublicAPI]
public sealed class PartitionedPositionTracker : IDisposable {
    FrozenDictionary<Partition, PositionTracker> _trackers;

    bool _disposed;

    /// <summary>
    /// Creates a tracker with initial positions per partition.
    /// </summary>
    public PartitionedPositionTracker(IReadOnlyDictionary<Partition, RecordPosition> positions) {
        _trackers = positions.ToFrozenDictionary(
            x => x.Key,
            x => new PositionTracker(lastFlushedPosition: x.Value));
    }

    /// <summary>
    /// Creates a tracker with no initial partitions.
    /// </summary>
    public PartitionedPositionTracker() : this(new Dictionary<Partition, RecordPosition>()) { }

    /// <summary>
    /// Gets the last flushed (checkpointed) position for each partition.
    /// </summary>
    public Dictionary<Partition, LogPosition> LastFlushedPositions =>
        _trackers.ToDictionary(
            x => x.Key,
            x => x.Value.LastFlushedPosition.LogPosition
        );

    /// <summary>
    /// Gets the last tracked (pending, not yet flushed) position for each partition.
    /// Returns <see cref="LogPosition.Unset"/> for partitions with no pending positions.
    /// </summary>
    public Dictionary<Partition, LogPosition> LastTrackedPositions =>
        _trackers.ToDictionary(
            x => x.Key,
            x => x.Value.Positions.LastOrDefault(RecordPosition.Unset).LogPosition
        );

    /// <summary>
    /// Gets the number of partitions being tracked.
    /// </summary>
    public int PartitionCount => _trackers.Count;

    /// <summary>
    /// Tracks positions from a batch of records, grouped by partition.
    /// </summary>
    public int Track(IEnumerable<Record> records) {
        ObjectDisposedException.ThrowIf(_disposed, this);

        // Single pass: find max position per partition
        Dictionary<Partition, RecordPosition>? maxPositions = null;

        foreach (var record in records) {
            var position  = record.Position;
            var partition = position.Partition;

            // Skip partitions we're not tracking, wonte even happen in practice...
            if (!_trackers.ContainsKey(partition))
                continue;

            maxPositions ??= new Dictionary<Partition, RecordPosition>(_trackers.Count);

            if (!maxPositions.TryGetValue(partition, out var current) || position > current)
                maxPositions[partition] = position;
        }

        if (maxPositions is null)
            return 0;

        // Track the max position for each partition
        var total = 0;
        foreach (var (partition, position) in maxPositions)
            total += _trackers[partition].Track(position);

        return total;
    }

    // /// <summary>
    // /// Tracks a position for the specified partition.
    // /// </summary>
    // public int Track(Partition partition, LogPosition position) {
    //     ObjectDisposedException.ThrowIf(_disposed, this);
    //     return !_trackers.TryGetValue(partition, out var tracker)
    //         ? throw new ArgumentException($"Partition {partition} is not being tracked.", nameof(partition))
    //         : tracker.Track(position);
    // }
    //
    // /// <summary>
    // /// Tracks a position for its partition.
    // /// </summary>
    // public int Track(RecordPosition position) =>
    //     Track(position.Partition, position.LogPosition);

    /// <summary>
    /// Prepares a flush without committing. Call <see cref="PendingPositionsFlush.Execute"/> after persistence succeeds.
    /// </summary>
    /// <remarks>
    /// Snapshots ALL pending positions at the moment of call (no position filtering).
    /// This enables distributed checkpoint coordination across workers.
    /// </remarks>
    public PendingPositionsFlush PrepareFlush() {
        ObjectDisposedException.ThrowIf(_disposed, this);
        return new PendingPositionsFlush(this, GetAllPendingPositions());
    }

    /// <summary>
    /// Gets all pending positions for each partition.
    /// Returns the last tracked position per partition, or last flushed position if no pending positions.
    /// </summary>
    Dictionary<Partition, RecordPosition> GetAllPendingPositions() =>
        _trackers.ToDictionary(
            x => x.Key,
            x => {
                var positions = x.Value.Positions;
                return positions.Length > 0
                    ? positions[^1]
                    : x.Value.LastFlushedPosition;
            }
        );

    /// <summary>
    /// Flushes tracked positions up to the specified positions for each partition.
    /// </summary>
    public void FlushUpTo(IReadOnlyDictionary<Partition, RecordPosition> positions) {
        ObjectDisposedException.ThrowIf(_disposed, this);

        foreach (var (partition, tracker) in _trackers) {
            if (positions.TryGetValue(partition, out var position))
                tracker.FlushUpTo(position);
        }
    }

    /// <summary>
    /// Resets the tracker with new partition positions, reusing existing trackers where possible.
    /// </summary>
    /// <param name="positions">The new partition positions.</param>
    public void Reset(IReadOnlyDictionary<Partition, RecordPosition> positions) {
        ObjectDisposedException.ThrowIf(_disposed, this);

        var oldCount    = _trackers.Count;
        var newTrackers = new Dictionary<Partition, PositionTracker>(positions.Count);

        foreach (var (partition, position) in positions) {
            if (_trackers.TryGetValue(partition, out var existing)) {
                existing.Reset(position);
                newTrackers[partition] = existing;
            } else {
                newTrackers[partition] = new PositionTracker(position);
            }
        }

        // Only scan for removed partitions if count decreased
        if (newTrackers.Count < oldCount) {
            foreach (var (partition, tracker) in _trackers) {
                if (!newTrackers.ContainsKey(partition))
                    tracker.Dispose();
            }
        }

        _trackers = newTrackers.ToFrozenDictionary();
    }

    /// <inheritdoc />
    public void Dispose() {
        if (_disposed)
            return;

        foreach (var tracker in _trackers.Values)
            tracker.Dispose();

        _disposed = true;
    }
}

/// <summary>
/// A prepared flush that can be committed after external persistence succeeds.
/// If <see cref="Execute"/> is not called, positions remain tracked for retry.
/// </summary>
[PublicAPI]
public readonly struct PendingPositionsFlush {
    readonly PartitionedPositionTracker _tracker;

    /// <summary>
    /// The positions to be flushed on <see cref="Execute"/>.
    /// </summary>
    public ImmutableDictionary<Partition, RecordPosition> Positions { get; }

    internal PendingPositionsFlush(PartitionedPositionTracker tracker, Dictionary<Partition, RecordPosition> positions) {
        _tracker  = tracker;
        Positions = positions.ToImmutableDictionary();
    }

    /// <summary>
    /// Commits the flush, removing the positions from the tracker.
    /// </summary>
    public void Execute() => _tracker.FlushUpTo(Positions);

    public override string ToString() =>
        string.Join(", ", Positions.Select(kvp => $"P{kvp.Key}={kvp.Value.LogPosition}")); // TODO SS: just use log positions if we keep partition
}
</file>

<file path="src/Kurrent.Processors/Options/ProcessorSettings.cs">
using Kurrent.Client.Streams;
using Kurrent.Processors.Models;
using Kurrent.Processors.Options.Validators;

namespace Kurrent.Processors.Options;

/// <summary>
/// Configuration settings for a processor.
/// </summary>
[PublicAPI]
public record ProcessorSettings : OptionsBase<ProcessorSettings, ProcessorSettingsValidator> {
    /// <summary>
    /// Unique identifier for the processor group.
    /// </summary>
    /// <remarks>
    /// <para><b>Default:</b> Empty string</para>
    /// <para><b>Importance:</b> High</para>
    /// <para>
    /// Multiple workers with the same processor ID share checkpoints,
    /// enabling coordinated processing across instances.
    /// </para>
    /// </remarks>
    public string ProcessorId { get; init; } = string.Empty;

    /// <summary>
    /// Unique identifier for this worker instance within the processor group.
    /// </summary>
    /// <remarks>
    /// <para><b>Default:</b> New GUID</para>
    /// <para><b>Importance:</b> High</para>
    /// <para>
    /// Used for checkpoint attribution. For sticky partition assignment,
    /// use a consistent identifier like <c>Environment.MachineName</c>.
    /// </para>
    /// </remarks>
    public string WorkerId { get; init; } = Guid.NewGuid().ToString("N");

    /// <summary>
    /// Maximum number of partitions (key groups). Range: 1-32768.
    /// </summary>
    /// <remarks>
    /// <para><b>Default:</b> 128</para>
    /// <para><b>Importance:</b> High</para>
    /// <para>
    /// Determines the upper bound for parallel processing.
    /// </para>
    /// </remarks>
    internal int MaxParallelism { get; init; } = 128;

    /// <summary>
    /// Subscription settings (filter, partitioning, initial position).
    /// </summary>
    public SubscriptionSettings Subscription { get; init; } = new();

    /// <summary>
    /// Batching settings (size, timeout).
    /// </summary>
    public BatchingSettings Batching { get; init; } = new();

    /// <summary>
    /// Checkpoint settings (interval, retention, failure policy).
    /// </summary>
    public CheckpointSettings Checkpoint { get; init; } = new();

    /// <summary>
    /// Worker runtime settings (buffering, error handling, decoding).
    /// </summary>
    public WorkerSettings Worker { get; init; } = new();
}

/// <summary>
/// Configuration for subscription behavior.
/// </summary>
[PublicAPI]
public record SubscriptionSettings {
    /// <summary>
    /// Filter expression string for server-side filtering (e.g., <c>"$all"</c>, <c>"stream_id LIKE 'orders-%'"</c>).
    /// </summary>
    /// <remarks>
    /// <para><b>Default:</b> Empty string (no filter)</para>
    /// <para><b>Importance:</b> High</para>
    /// <para>
    /// Used for proto/config binding. When binding from configuration,
    /// a <see cref="RecordFilter"/> can be created automatically from this expression.
    /// </para>
    /// </remarks>
    public string FilterExpression { get; init; } = string.Empty;

    /// <summary>
    /// Record filtering criteria to apply.
    /// </summary>
    /// <remarks>
    /// <para><b>Default:</b> RecordFilter.None</para>
    /// <para><b>Importance:</b> High</para>
    /// <para>
    /// Filters can target specific streams, schemas, metadata properties,
    /// or custom predicates to reduce data transfer and processing overhead.
    /// </para>
    /// </remarks>
    public IRecordFilter Filter { get; init; } = RecordFilter.None;

    /// <summary>
    /// Path to extract partition key. Required when <see cref="ProcessorSettings.MaxParallelism"/> > 1.
    /// </summary>
    /// <remarks>
    /// <para><b>Default:</b> Empty string</para>
    /// <para><b>Importance:</b> High (when using parallelism)</para>
    /// <para>
    /// Supports paths like:
    /// <list type="bullet">
    ///   <item><c>"stream_id"</c> - The stream ID</item>
    ///   <item><c>"data.customer_id"</c> - Field in record data</item>
    ///   <item><c>"metadata.tenant"</c> - Field in record metadata</item>
    /// </list>
    /// </para>
    /// </remarks>
    public string PartitionKeySelector { get; init; } = string.Empty;

    /// <summary>
    /// Where to start if no checkpoint exists.
    /// </summary>
    /// <remarks>
    /// <para><b>Default:</b> <see cref="SubscriptionInitialPosition.Latest"/></para>
    /// <para><b>Importance:</b> High</para>
    /// </remarks>
    public SubscriptionInitialPosition InitialPosition { get; init; } = SubscriptionInitialPosition.Latest;
}

/// <summary>
/// Configuration for record batching during processing.
/// </summary>
/// <remarks>
/// <para>
/// Batching controls how records are grouped before delivery to the processor.
/// Smaller batches reduce latency but increase overhead; larger batches improve
/// throughput at the cost of increased memory usage and processing delay.
/// </para>
/// </remarks>
[PublicAPI]
public record BatchingSettings {
    /// <summary>
    /// Maximum number of records per batch.
    /// </summary>
    /// <remarks>
    /// <para><b>Default:</b> 200 records</para>
    /// <para><b>Importance:</b> Medium</para>
    /// <para>
    /// Middle ground between low-latency (100) and high-throughput (500).
    /// </para>
    /// </remarks>
    public int MaxSize { get; init; } = 200;

    /// <summary>
    /// Maximum time to wait for a full batch (milliseconds).
    /// </summary>
    /// <remarks>
    /// <para><b>Default:</b> 250 milliseconds</para>
    /// <para><b>Importance:</b> Medium</para>
    /// <para>
    /// Shorter timeouts reduce latency but may result in smaller batches.
    /// Longer timeouts allow larger batches but increase delivery delay.
    /// </para>
    /// </remarks>
    public long Timeout { get; init; } = 250;

    internal TimeSpan TimeoutTimeSpan => TimeSpan.FromMilliseconds(Timeout); // 00:00:00.250
}

/// <summary>
/// Configuration for checkpoint behavior.
/// </summary>
[PublicAPI]
public record CheckpointSettings {
    public static readonly CheckpointSettings Default = new() {
        Interval = 30000,
        Timeout  = 30000
    };

    /// <summary>
    /// Time between automatic checkpoints (milliseconds).
    /// </summary>
    /// <remarks>
    /// <para><b>Default:</b> 30000 milliseconds (30 seconds)</para>
    /// <para><b>Importance:</b> High</para>
    /// <para>
    /// Balances fault tolerance with I/O overhead.
    /// </para>
    /// </remarks>
    public long Interval { get; init; } = 30000;

    internal TimeSpan IntervalTimeSpan => TimeSpan.FromMilliseconds(Interval);

    /// <summary>
    /// Maximum time to wait for workers to acknowledge checkpoint (milliseconds).
    /// </summary>
    /// <remarks>
    /// <para><b>Default:</b> 30000 milliseconds (30 seconds)</para>
    /// <para><b>Importance:</b> Medium</para>
    /// <para>
    /// Faster detection of stuck workers. If a worker doesn't acknowledge within this time,
    /// it's considered failed and partitions can be reassigned.
    /// </para>
    /// </remarks>
    public long Timeout { get; init; } = 30000;

    internal TimeSpan TimeoutTimeSpan => TimeSpan.FromMilliseconds(Timeout);

    /// <summary>
    /// Number of completed checkpoints to retain.
    /// </summary>
    /// <remarks>
    /// <para><b>Default:</b> 3 checkpoints</para>
    /// <para><b>Importance:</b> Low</para>
    /// </remarks>
    public int RetentionCount { get; init; } = 3;

    /// <summary>
    /// What to do when a checkpoint fails.
    /// </summary>
    /// <remarks>
    /// <para><b>Default:</b> <see cref="CheckpointFailurePolicy.Continue"/></para>
    /// <para><b>Importance:</b> High</para>
    /// </remarks>
    public CheckpointFailurePolicy FailurePolicy { get; init; } = CheckpointFailurePolicy.Continue;
}

/// <summary>
/// Defines what happens when a checkpoint fails.
/// </summary>
/// <remarks>
/// <para>
/// A checkpoint fails if any worker doesn't acknowledge within the timeout.
/// The timed-out worker is always disconnected regardless of this policy.
/// This setting controls what happens to the OTHER workers.
/// </para>
/// </remarks>
[PublicAPI]
public enum CheckpointFailurePolicy {
    /// <summary>
    /// Unspecified failure policy. The server will use the default behavior.
    /// </summary>
    Unspecified = 0,

    /// <summary>
    /// Abort this checkpoint, continue processing.
    /// </summary>
    /// <remarks>
    /// <para>
    /// <list type="bullet">
    ///   <item>The checkpoint is marked as failed</item>
    ///   <item>Other workers continue processing from last successful checkpoint</item>
    ///   <item>Failed worker's partitions are reassigned to remaining workers</item>
    ///   <item>Next checkpoint triggers normally on interval/threshold</item>
    /// </list>
    /// </para>
    /// <para>Use when: High availability is priority, some data loss acceptable.</para>
    /// </remarks>
    Continue = 1,

    /// <summary>
    /// Stop all processing on checkpoint failure.
    /// </summary>
    /// <remarks>
    /// <para>
    /// <list type="bullet">
    ///   <item>All workers are disconnected</item>
    ///   <item>Processor goes to <c>Idle</c> state</item>
    ///   <item>Requires manual intervention (reconnect workers to resume)</item>
    /// </list>
    /// </para>
    /// <para>Use when: Data consistency is critical, prefer downtime over data loss.</para>
    /// </remarks>
    FailProcessor = 2
}

/// <summary>
/// Configuration for worker runtime behavior.
/// </summary>
/// <remarks>
/// <para>
/// These settings control how the worker instance operates locally,
/// independent of the processor definition. They are not sent to the server.
/// </para>
/// </remarks>
[PublicAPI]
public record WorkerSettings {
    /// <summary>
    /// Whether to throw an exception on processing failure or log and stop.
    /// </summary>
    /// <remarks>
    /// <para><b>Default:</b> false (log and stop)</para>
    /// <para><b>Importance:</b> Medium</para>
    /// </remarks>
    public bool ThrowOnFailure { get; init; }

    /// <summary>
    /// Number of records to buffer in memory.
    /// </summary>
    /// <remarks>
    /// <para><b>Default:</b> 1000 records</para>
    /// <para><b>Importance:</b> Medium</para>
    /// <para><b>Valid Range:</b> 1 to 10,000 records</para>
    /// <para>
    /// Larger buffers improve throughput but increase memory usage.
    /// The buffer capacity should be at least as large as the batch size.
    /// </para>
    /// </remarks>
    public int BufferCapacity { get; init; } = 1000;

    /// <summary>
    /// Skip record data deserialization for performance-critical scenarios.
    /// </summary>
    /// <remarks>
    /// <para><b>Default:</b> false (decode records)</para>
    /// <para><b>Importance:</b> Low</para>
    /// <para>
    /// When true, records are returned as raw bytes without deserialization,
    /// reducing CPU usage for metadata-only operations.
    /// </para>
    /// </remarks>
    public bool SkipDecoding { get; init; }
}
</file>

