    /// <param name="revision">The expected stream revision.</param>
    /// <returns>A <see cref="StreamConsistencyCheck"/> configured to match the specified revision.</returns>
    public static StreamConsistencyCheck Match(StreamName stream, Revision revision) => new(stream, revision);

    /// <summary>
    /// Creates a consistency check that allows any stream state.
    /// </summary>
    /// <param name="stream">The stream name to check.</param>
    /// <returns>A <see cref="StreamConsistencyCheck"/> configured to accept any stream state.</returns>
    public static StreamConsistencyCheck Any(StreamName stream) => new(stream, ExpectedStreamCondition.Any);

    /// <summary>
    /// Creates a consistency check that expects the stream to exist.
    /// </summary>
    /// <param name="stream">The stream name to check.</param>
    /// <returns>A <see cref="StreamConsistencyCheck"/> configured to ensure the stream exists.</returns>
    public static StreamConsistencyCheck Exists(StreamName stream) => new(stream, ExpectedStreamCondition.Exists);

    /// <summary>
    /// Creates a consistency check that expects the stream to not exist.
    /// </summary>
    /// <param name="stream">The stream name to check.</param>
    /// <returns>A <see cref="StreamConsistencyCheck"/> configured to ensure the stream does not exist.</returns>
    public static StreamConsistencyCheck NoStream(StreamName stream) => new(stream, ExpectedStreamCondition.NoStream);

    /// <summary>
    /// Creates a consistency check that expects the stream to be deleted.
    /// </summary>
    /// <param name="stream">The stream name to check.</param>
    /// <returns>A <see cref="StreamConsistencyCheck"/> configured to ensure the stream is deleted.</returns>
    public static StreamConsistencyCheck Deleted(StreamName stream) => new(stream, ExpectedStreamCondition.Deleted);

    /// <summary>
    /// Creates a consistency check that expects the stream to be tombstoned.
    /// </summary>
    /// <param name="stream">The stream name to check.</param>
    /// <returns>A <see cref="StreamConsistencyCheck"/> configured to ensure the stream is tombstoned.</returns>
    public static StreamConsistencyCheck Tombstoned(StreamName stream) => new(stream, ExpectedStreamCondition.Tombstoned);
}


/// <summary>
/// Defines a consistency check using a custom query expression to validate data consistency.
/// </summary>
public readonly record struct QueryConsistencyCheck(string Expression) {
    /// <summary>
    /// Gets the query expression used to validate consistency.
    /// </summary>
    public required string Expression { get; init; } = Expression;
}
