        // Act
        var mapped = result.MapError(err => new GameEndedError(err.GameId, GameStatus.Draw));

        // Assert
        mapped.IsFailure.ShouldBeTrue();
        mapped.Error.ShouldBeOfType<GameEndedError>();
        mapped.Error.GameId.ShouldBe(error.GameId);
    }

