<file path="test/Kurrent.Client.Tests/Options/KurrentClientOptionsBuilderTests.cs">
using Kurrent.Client.Streams;

namespace Kurrent.Client.Tests.Options;

public class KurrentClientOptionsBuilderTests {
    [Test]
    public void get_builder_returns_the_same_options() {
        const string connectionString = "kurrentdb://admin:changeit@localhost:2113/?tls=false";

        var validOptions = KurrentClientOptions.Parse(connectionString);

        var builder = validOptions.GetBuilder();

        var newOptions = builder.Build();

        newOptions.ShouldBeEquivalentTo(validOptions);
    }

    [Test]
    public void with_resilience_performs_complete_replacement() {
        const string connectionString = "kurrentdb://admin:changeit@localhost:2113/?tls=false";

        var validOptions = KurrentClientOptions.Parse(connectionString);

        var builder = validOptions.GetBuilder()
            .ConfigureResilience(KurrentClientResilienceOptions.NoResilience);

        var newOptions = builder.Build();

        // WithResilience performs complete replacement
        newOptions.Resilience.ShouldBeEquivalentTo(KurrentClientResilienceOptions.NoResilience);

        // Other properties should be preserved
        newOptions.ConnectionName.ShouldBe(validOptions.ConnectionName);
        newOptions.Endpoints.ShouldBe(validOptions.Endpoints);
        newOptions.Security.ShouldBeEquivalentTo(validOptions.Security);
        newOptions.Gossip.ShouldBeEquivalentTo(validOptions.Gossip);
    }

    [Test]
    public void with_messages_performs_complete_replacement() {
        const string connectionString = "kurrentdb://admin:changeit@localhost:2113/?tls=false";

        var validOptions = KurrentClientOptions.Parse(connectionString);

        var builder = validOptions.GetBuilder()
            .ConfigureSchema(schema => schema
                .ConfigureMessages(options => options.Map<StreamMetadata>("$metadata")));

        var newOptions = builder.Build();

        // WithMessages performs complete replacement
        newOptions.Schema.Mapper.ShouldNotBe(validOptions.Schema.Mapper);
        newOptions.Schema.Mapper.TryGetSchemaName(typeof(StreamMetadata), out var schemaName).ShouldBeTrue();
        schemaName.Value.ShouldBe("$metadata");

        // Other properties should be preserved
        newOptions.ConnectionName.ShouldBe(validOptions.ConnectionName);
        newOptions.Endpoints.ShouldBe(validOptions.Endpoints);
        newOptions.Security.ShouldBeEquivalentTo(validOptions.Security);
        newOptions.Resilience.ShouldBeEquivalentTo(validOptions.Resilience);
    }

    [Test]
    public void configure_resilience_preserves_unmodified_properties() {
        const string connectionString = "kurrentdb://admin:changeit@localhost:2113/?tls=false&defaultDeadline=30000";

        var validOptions = KurrentClientOptions.Parse(connectionString);
        var originalDeadline = validOptions.Resilience.Deadline;

        var builder = validOptions.GetBuilder()
            .ConfigureResilience(res => res with {
                Retry = new KurrentClientResilienceOptions.RetryOptions { Enabled = false }
            });

        var newOptions = builder.Build();

        // ConfigureResilience preserves other properties
        newOptions.Resilience.Deadline.ShouldBe(originalDeadline);
        newOptions.Resilience.Retry.Enabled.ShouldBe(false);
        newOptions.Resilience.KeepAliveInterval.ShouldBe(validOptions.Resilience.KeepAliveInterval);
        newOptions.Resilience.KeepAliveTimeout.ShouldBe(validOptions.Resilience.KeepAliveTimeout);
    }
}
</file>

<file path="test/Kurrent.Client.Tests/SchemaRegistry/NameStrategies/SchemaNameStrategiesTests.cs">
using Kurrent.Client.Schema.NameStrategies;
using static Kurrent.Client.Schema.NameStrategies.SchemaNameOutputFormat;

namespace Kurrent.Client.Tests.SchemaRegistry.NameStrategies;

public class SchemaNameStrategiesTests {
	# region . happy path .

	[Test]
	[Arguments(SchemaNameOutputFormat.None, "Company.Logistics.Events.OrderShipped")]
	[Arguments(KebabCase, "company.logistics.events.order-shipped")]
	[Arguments(SnakeCase, "company.logistics.events.order_shipped")]
	[Arguments(Urn, "urn:schemas-kurrent:company.logistics.events:order-shipped")]
	public void message_schema_name_strategy_generates_correct_name(SchemaNameOutputFormat format, string streamName) {
		var strategy    = new MessageSchemaNameStrategy(format);
		var messageType = typeof(Company.Logistics.Events.OrderShipped);
		var result      = strategy.GenerateSchemaName(messageType);
		result.Value.ShouldBe(streamName);
	}

	[Test]
	[Arguments(SchemaNameOutputFormat.None, "Logistics-101", "Logistics.OrderShipped")]
	[Arguments(SchemaNameOutputFormat.None, "Logistics", "Logistics.OrderShipped")]
	[Arguments(KebabCase, "Logistics-101", "logistics.order-shipped")]
	[Arguments(SnakeCase, "Logistics-101", "logistics.order_shipped")]
	[Arguments(Urn, "Logistics-101", "urn:schemas-kurrent:logistics:order-shipped")]
	public void category_schema_name_strategy_generates_correct_name(SchemaNameOutputFormat format, string streamName, string expectedName) {
		var strategy    = new CategorySchemaNameStrategy(format);
		var messageType = typeof(Company.Logistics.Events.OrderShipped);
		var result      = strategy.GenerateSchemaName(messageType, streamName);
		result.Value.ShouldBe(expectedName);
	}

	[Test]
	[Arguments(SchemaNameOutputFormat.None, "com.company.logistics.OrderShipped")]
	[Arguments(KebabCase, "com.company.logistics.order-shipped")]
	[Arguments(SnakeCase, "com.company.logistics.order_shipped")]
	[Arguments(Urn, "urn:schemas-kurrent:com.company.logistics:order-shipped")]
	public void namespace_schema_name_strategy_generates_correct_name(SchemaNameOutputFormat format, string expectedName) {
		var strategy    = new NamespaceSchemaNameStrategy("com.company.logistics", format);
		var messageType = typeof(Company.Logistics.Events.OrderShipped);
		var result      = strategy.GenerateSchemaName(messageType);
		result.Value.ShouldBe(expectedName);
	}

	[Test]
	[Arguments(SchemaNameOutputFormat.None, "Logistics-101", "com.company.Logistics.OrderShipped")]
	[Arguments(SchemaNameOutputFormat.None, "Logistics", "com.company.Logistics.OrderShipped")]
	[Arguments(KebabCase, "Logistics-101", "com.company.logistics.order-shipped")]
	[Arguments(SnakeCase, "Logistics-101", "com.company.logistics.order_shipped")]
	[Arguments(Urn, "Logistics-101", "urn:schemas-kurrent:com.company.logistics:order-shipped")]
	public void namespace_category_schema_name_strategy_generates_correct_name(SchemaNameOutputFormat format, string streamName, string expectedName) {
		var strategy    = new NamespaceCategorySchemaNameStrategy("com.company", format);
		var messageType = typeof(Company.Logistics.Events.OrderShipped);

		var result = strategy.GenerateSchemaName(messageType, streamName);

		result.Value.ShouldBe(expectedName);
	}

	# endregion

	#region . edge cases .

	[Test]
	public void message_schema_name_strategy_generates_correct_name_with_nested_types() {
		var strategy    = new MessageSchemaNameStrategy();
		var messageType = typeof(Company.Logistics.Events.OrderShipped.Address);
		var result      = strategy.GenerateSchemaName(messageType);
		result.Value.ShouldBe("Company.Logistics.Events.Address");
	}

	[Test]
	public void category_schema_name_strategy_throws_on_empty_stream() {
		var strategy    = new CategorySchemaNameStrategy();
		var messageType = typeof(Company.Logistics.Events.OrderShipped);
		Should.Throw<ArgumentException>(() => strategy.GenerateSchemaName(messageType, " "));
	}

	[Test]
	public void namespace_schema_name_strategy_throws_on_empty_namespace() {
		Should.Throw<ArgumentException>(() => new NamespaceSchemaNameStrategy(" "));
	}

	[Test]
	public void namespace_category_schema_name_strategy_throws_on_empty_namespace_or_stream() {
		Should.Throw<ArgumentException>(() => new NamespaceCategorySchemaNameStrategy(" "));
		var strategy    = new NamespaceCategorySchemaNameStrategy("com.company");
		var messageType = typeof(Company.Logistics.Events.OrderShipped);
		Should.Throw<ArgumentException>(() => strategy.GenerateSchemaName(messageType, " "));
	}

	[Test]
	[Arguments(SchemaNameOutputFormat.None, "GlobalItemAdded")]
	[Arguments(KebabCase, "global-item-added")]
	[Arguments(SnakeCase, "global_item_added")]
	[Arguments(Urn, "urn:schemas-kurrent:global:global-item-added")]
	public void message_schema_name_strategy_handles_types_without_namespace(SchemaNameOutputFormat format, string expectedName) {
		var strategy    = new MessageSchemaNameStrategy(format);
		var messageType = typeof(GlobalItemAdded);
		var result      = strategy.GenerateSchemaName(messageType);
		result.Value.ShouldBe(expectedName);
	}

	#endregion
}
</file>

<file path="test/Kurrent.Testing/OpenTelemetry/OtelTestContextExtensions.cs">
namespace Kurrent.Testing.OpenTelemetry;

[PublicAPI]
public static class OtelTestContextExtensions {
    extension(TestContext? context) {
        public void ConfigureOtel(OtelServiceMetadata metadata) {
            context?.StateBag.Items["OTEL_RESOURCE_ATTRIBUTES"] = metadata.GetResourceAttributes();
            context?.StateBag.Items["OTEL_SERVICE_NAME"]        = metadata.ServiceName; // not really necessary, but follows the convention
        }

        public OtelServiceMetadata GetOtelServiceMetadata() =>
            context is not null && context.StateBag.Items.TryGetValue("OTEL_RESOURCE_ATTRIBUTES", out var value) && value is string resourceAttributes
                ? OtelServiceMetadata.Parse(resourceAttributes)
                : OtelServiceMetadata.None;

        public void SetOtelServiceName(string serviceName) => ConfigureOtel(context, new OtelServiceMetadata(serviceName));
    }
}
