namespace Transfermarkt.Domain;

/// <summary>
/// Terms specific to loan transfers.
/// </summary>
[PublicAPI]
public readonly record struct LoanTerms {
    /// <summary>
    /// Represents no loan terms (not a loan).
    /// </summary>
    public static readonly LoanTerms None = new(DateOnly.MinValue, Money.Zero, Money.Zero);

    public LoanTerms(DateOnly loanEndDate, Money buyClause, Money obligationClause) {
        LoanEndDate      = loanEndDate;
        BuyClause        = buyClause;
        ObligationClause = obligationClause;
    }

    /// <summary>
    /// The date when the loan ends.
    /// </summary>
    public DateOnly LoanEndDate { get; init; }

    /// <summary>
    /// Buy clause amount (option to buy). Zero if no buy clause.
    /// </summary>
    public Money BuyClause { get; init; }

    /// <summary>
    /// Obligation clause amount (obligation to buy if conditions are met). Zero if no obligation clause.
    /// </summary>
    public Money ObligationClause { get; init; }

    /// <summary>
    /// Whether this represents actual loan terms.
    /// </summary>
    public bool IsSet => this != None;

    /// <summary>
    /// Whether there is a buy clause.
    /// </summary>
    public bool HasBuyClause => BuyClause.Amount > 0;

    /// <summary>
    /// Whether there is an obligation clause.
    /// </summary>
    public bool HasObligationClause => ObligationClause.Amount > 0;

    /// <summary>
    /// Creates loan terms from the specified values.
    /// </summary>
    public static LoanTerms From(DateOnly loanEndDate, Money? buyClause = null, Money? obligationClause = null) =>
        new(loanEndDate, buyClause ?? Money.Zero, obligationClause ?? Money.Zero);

    public override string ToString() {
        if (!IsSet) return "N/A";

        var parts = new List<string> { $"Until {LoanEndDate}" };

        if (HasBuyClause) parts.Add($"Buy: {BuyClause}");
        if (HasObligationClause) parts.Add($"Obligation: {ObligationClause}");

        return string.Join(", ", parts);
    }
}
</file>

<file path="examples/Transfermarkt.Domain/Domain/Model/Money.cs">
namespace Transfermarkt.Domain;

/// <summary>
/// Monetary value with currency.
/// </summary>
[PublicAPI]
public readonly record struct Money : IComparable<Money>, IComparable {
    /// <summary>
    /// Represents zero money (in EUR).
    /// </summary>
    public static readonly Money Zero = new(0, Currency.EUR);

    public Money(decimal amount, Currency currency) {
        Amount   = amount;
        Currency = currency;
    }

    /// <summary>
    /// The monetary amount.
    /// </summary>
    public decimal Amount { get; init; }

    /// <summary>
    /// The currency.
    /// </summary>
    public Currency Currency { get; init; }

    /// <summary>
    /// Whether this represents zero money.
    /// </summary>
    public bool IsZero => Amount == 0;

    /// <summary>
    /// Creates a Money instance from an amount and currency.
    /// </summary>
    public static Money From(decimal amount, Currency? currency = null) => new(amount, currency ?? Currency.EUR);

    /// <summary>
    /// Creates a Money instance in Euros.
    /// </summary>
    public static Money InEuros(decimal amount) => new(amount, Currency.EUR);

    /// <summary>
    /// Creates a Money instance in British Pounds.
    /// </summary>
    public static Money InPounds(decimal amount) => new(amount, Currency.GBP);

    /// <summary>
    /// Creates a Money instance in US Dollars.
    /// </summary>
    public static Money InDollars(decimal amount) => new(amount, Currency.USD);

    public static Money operator +(Money a, Money b) => new(a.Amount + b.Amount, a.Currency);
    public static Money operator -(Money a, Money b) => new(a.Amount - b.Amount, a.Currency);

    public override string ToString() => Currency.Format(Amount);

    #region . relational members .

    public int CompareTo(Money other) => Amount.CompareTo(other.Amount);

    public int CompareTo(object? obj) =>
        obj switch {
            null        => 1,
            Money other => CompareTo(other),
            _           => throw new ArgumentException($"Object must be of type {nameof(Money)}")
        };

    public static bool operator <(Money left, Money right)  => left.CompareTo(right) < 0;
    public static bool operator >(Money left, Money right)  => left.CompareTo(right) > 0;
    public static bool operator <=(Money left, Money right) => left.CompareTo(right) <= 0;
    public static bool operator >=(Money left, Money right) => left.CompareTo(right) >= 0;

    #endregion
}
</file>

