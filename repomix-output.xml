using System.Collections.Concurrent;
using Kurrent.Processors;
using Microsoft.Extensions.Logging;
using Processor.ClickstreamSessions.Events;

namespace Processor.ClickstreamSessions;

/// <summary>
/// Clickstream session analytics processor with gap-based session detection.
/// Groups page views into sessions based on 30-minute inactivity timeout.
/// Demonstrates session windows and gap detection patterns.
/// </summary>
public sealed class SessionAnalyticsProcessor : IRecordProcessor {
    static readonly TimeSpan SessionTimeout = TimeSpan.FromMinutes(30);

    readonly ConcurrentDictionary<string, UserSession> _activeSessions = new();

    long _totalPageViews;
    long _sessionsCompleted;
    long _totalSessionDuration;

    public ValueTask ProcessRecords(ProcessRecordsContext context) {

        // context.Records
        //     .Convert(rec => rec.Value is PageView pageView ? pageView : null)
        //     .Where(rec => rec is not null)
        //     .ForEach(pageView => ProcessPageView(pageView!, context.Logger));

        foreach (var record in context.Records) {
            if (record.Value is PageView pageView)
                ProcessPageView(pageView, context.Logger);
        }

        return ValueTask.CompletedTask;
    }

    void ProcessPageView(PageView pageView, ILogger logger) {
        _totalPageViews++;

        var existingSession = _activeSessions.GetValueOrDefault(pageView.UserId);

        if (existingSession is not null) {
            var timeSinceLastActivity = pageView.Timestamp - existingSession.LastActivity;

            if (timeSinceLastActivity > SessionTimeout) {
                // Session has expired - close it and start a new one
                CloseSession(existingSession, "timeout", logger);
                StartNewSession(pageView);
            } else {
                // Continue existing session
                existingSession.AddPageView(pageView);
                logger.LogDebug(
                    "Session {SessionId} | Page #{PageNum}: {Url}",
                    existingSession.SessionId,
                    existingSession.PageViews.Count,
                    pageView.PageUrl
                );
            }
        } else {
            // New user - start a new session
            StartNewSession(pageView);
        }

        void StartNewSession(PageView pageView) {
            var session = new UserSession(
                sessionId: $"{pageView.UserId}-{pageView.Timestamp:yyyyMMddHHmmss}",
                userId: pageView.UserId,
                startTime: pageView.Timestamp
            );

            session.AddPageView(pageView);

            _activeSessions[pageView.UserId] = session;

            logger.LogInformation(
                "📊 NEW SESSION | User: {UserId} | Session: {SessionId} | Entry: {EntryPage}",
                pageView.UserId, session.SessionId, pageView.PageUrl);
        }
    }

    void CloseSession(UserSession session, string reason, ILogger logger) {
        _sessionsCompleted++;
        var duration = (int)(session.LastActivity - session.StartTime).TotalSeconds;
        _totalSessionDuration += duration;

        logger.LogInformation(
            "✅ SESSION CLOSED | Session: {SessionId} | Reason: {Reason} | Duration: {Duration}s | Pages: {Pages} | Entry: {Entry} | Exit: {Exit}",
            session.SessionId, reason, duration, session.PageViews.Count, session.EntryPage, session.ExitPage);

        _activeSessions.TryRemove(session.UserId, out _);
    }

    public ValueTask OnCheckpoint(CheckpointContext context) {
        // Check for and close expired sessions
        var now = DateTimeOffset.UtcNow;
        var expiredSessions = _activeSessions.Values
            .Where(s => now - s.LastActivity > SessionTimeout)
            .ToList();

        foreach (var session in expiredSessions) {
            CloseSession(session, "checkpoint-cleanup", context.Logger);
        }

        var avgDuration = _sessionsCompleted > 0 ? _totalSessionDuration / _sessionsCompleted : 0;

        context.Logger.LogInformation(
            "Checkpoint {CheckpointId} | Views: {Views} | Active: {Active} | Completed: {Completed} | Avg Duration: {Avg}s",
            context.CheckpointId, _totalPageViews, _activeSessions.Count, _sessionsCompleted, avgDuration);

        return ValueTask.CompletedTask;
    }

    public ValueTask OnComplete(CompleteContext context) {
        // Close all remaining sessions on completion
        foreach (var session in _activeSessions.Values.ToList())
            CloseSession(session, "completed", context.Logger);

        context.Logger.LogInformation(
            "Completed | Total page views: {Views}, Sessions completed: {Sessions}",
            _totalPageViews,
            _sessionsCompleted
        );

        return ValueTask.CompletedTask;
    }

    sealed class UserSession(string sessionId, string userId, DateTimeOffset startTime) {
        public string         SessionId    { get; }              = sessionId;
        public string         UserId       { get; }              = userId;
        public DateTimeOffset StartTime    { get; }              = startTime;
        public DateTimeOffset LastActivity { get; private set; } = startTime;
        public List<PageView> PageViews    { get; }              = [];

        public string EntryPage => PageViews.Count > 0 ? PageViews[0].PageUrl : "";
        public string ExitPage  => PageViews.Count > 0 ? PageViews[^1].PageUrl : "";

        public void AddPageView(PageView pageView) {
            PageViews.Add(pageView);
            LastActivity = pageView.Timestamp;
        }
    }
}
</file>

<file path="examples/processors/Processor.Leaderboard/Program.cs">
using System.Text.Json;
using Kurrent.Client;
using Kurrent.Processors.Options;
using Processor.Leaderboard;
using Serilog;
using StackExchange.Redis;

Log.Logger = new LoggerConfiguration()
    .MinimumLevel.Information()
    .WriteTo.Console()
    .CreateLogger();

try {
    var builder = WebApplication.CreateBuilder(args);

    builder.Host.UseSerilog();

    // Configure Redis
    var redisConnection = builder.Configuration.GetConnectionString("Redis") ?? "localhost:6379";
    var redis = await ConnectionMultiplexer.ConnectAsync(redisConnection);
    builder.Services.AddSingleton<IConnectionMultiplexer>(redis);

    // Register shared Kurrent client
    builder.Services.AddKurrentClient("kurrentdb://localhost:2113");

    // Register processor as hosted service
    builder.Services.AddKurrentProcessor<LeaderboardProcessor>(config => config
        .WithFilter("schema_name IN ('ScoreSubmitted', 'PlayerJoined')")
    );

    var app = builder.Build();

    // Health check
    app.MapGet("/health", () => Results.Ok("Healthy"));

    // Get top N players for a game
    app.MapGet("/leaderboard/{gameId}/top/{count:int}", async (string gameId, int count, IConnectionMultiplexer redis) => {
        var db = redis.GetDatabase();
        var leaderboardKey = $"leaderboard:{gameId}";

        // Get top N players with scores (descending order)
        var entries = await db.SortedSetRangeByRankWithScoresAsync(
            leaderboardKey,
            0,
            count - 1,
            Order.Descending
        );

        var results = new List<object>();
        var rank = 1;

        foreach (var entry in entries) {
            var playerId = entry.Element.ToString();
            var playerKey = $"player:{playerId}";
            var playerData = await db.StringGetAsync(playerKey);

            var displayName = playerId;
            var country = "??";

            if (playerData.HasValue) {
                var player = JsonSerializer.Deserialize<PlayerInfo>(playerData.ToString());
                displayName = player?.DisplayName ?? playerId;
                country = player?.Country ?? "??";
            }

            results.Add(new {
                Rank = rank++,
                PlayerId = playerId,
                DisplayName = displayName,
                Country = country,
                Score = (long)entry.Score
            });
        }

        return Results.Ok(new {
            GameId = gameId,
            TotalPlayers = await db.SortedSetLengthAsync(leaderboardKey),
            TopPlayers = results
        });
    });

    // Get a specific player's rank and score
    app.MapGet("/leaderboard/{gameId}/rank/{playerId}", async (string gameId, string playerId, IConnectionMultiplexer redis) => {
        var db = redis.GetDatabase();
        var leaderboardKey = $"leaderboard:{gameId}";

        var score = await db.SortedSetScoreAsync(leaderboardKey, playerId);
        if (!score.HasValue) {
            return Results.NotFound(new { Message = "Player not found on leaderboard" });
        }

        var rank = await db.SortedSetRankAsync(leaderboardKey, playerId, Order.Descending);
        var totalPlayers = await db.SortedSetLengthAsync(leaderboardKey);

        // Get player info
        var playerKey = $"player:{playerId}";
        var playerData = await db.StringGetAsync(playerKey);
        var displayName = playerId;

        if (playerData.HasValue) {
            var player = JsonSerializer.Deserialize<PlayerInfo>(playerData.ToString());
            displayName = player?.DisplayName ?? playerId;
        }

        return Results.Ok(new {
            PlayerId     = playerId,
            DisplayName  = displayName,
            Score        = (long)score.Value,
            Rank         = (rank ?? 0) + 1,
            TotalPlayers = totalPlayers,
            Percentile   = Math.Round((double)(totalPlayers - rank - 1)! / totalPlayers * 100, 1)
        });
    });

    // Get player info
    app.MapGet("/player/{playerId}", async (string playerId, IConnectionMultiplexer redis) => {
        var db   = redis.GetDatabase();
        var key  = $"player:{playerId}";
        var data = await db.StringGetAsync(key);

        return data.HasValue
            ? Results.Content(data!, "application/json")
            : Results.NotFound();
    });

    await app.RunAsync();
}
catch (Exception ex) {
    Log.Fatal(ex, "Application terminated unexpectedly");
}
finally {
    await Log.CloseAndFlushAsync();
}

record PlayerInfo(string PlayerId, string DisplayName, string Country, string JoinedAt);
</file>

<file path="examples/processors/Processor.WithPostgres/Program.cs">
using Dapper;
using Kurrent.Processors.Options;
using Npgsql;
using Processor.WithPostgres;
using Serilog;
using Transfermarkt.Domain;

Log.Logger = new LoggerConfiguration()
    .WriteTo.Console()
    .CreateLogger();

try {
    var builder = WebApplication.CreateBuilder(args);

    builder.Host.UseSerilog();

    // Configure Postgres
    var connectionString = builder.Configuration.GetConnectionString("Postgres")
        ?? "Host=localhost;Database=transfermarkt;Username=postgres;Password=postgres";

    builder.Services.AddNpgsqlDataSource(connectionString);

    // Register processor as hosted service
    builder.Services.AddKurrentProcessor<ClubSpendingProcessor>(config => config
        .UseClient("kurrentdb://localhost:2113")
        .WithFilter($"schema = {nameof(PlayerTransferred)}")
    );

    var app = builder.Build();

    app.MapGet("/health", () => Results.Ok("Healthy"));

    // Query endpoint to see aggregated spending
    app.MapGet("/spending/{clubId}/{season:int}", async (string clubId, int season, NpgsqlDataSource db) => {
        await using var conn = await db.OpenConnectionAsync();
        var result = await conn.QuerySingleOrDefaultAsync<dynamic>(
            "SELECT * FROM club_spending WHERE club_id = @clubId AND season = @season",
            new { clubId, season }
        );
        return result is not null ? Results.Ok(result) : Results.NotFound();
    });

    await app.RunAsync();
}
catch (Exception ex) {
    Log.Fatal(ex, "Application terminated unexpectedly");
}
finally {
    await Log.CloseAndFlushAsync();
}
