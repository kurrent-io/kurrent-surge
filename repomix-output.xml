<file path="src/Kurrent.Processors/Checkpointing/Clocks/ProcessLamportClock.cs">
namespace Kurrent.Processors.Checkpointing;

/// <summary>
/// Represents a Lamport timestamp with a process identifier for total ordering.
/// </summary>
/// <remarks>
/// <para>
/// This timestamp type provides total ordering across distributed processes by combining
/// the logical counter with a process identifier. When counters are equal, the process ID
/// serves as a deterministic tie-breaker.
/// </para>
/// <para>
/// The timestamp is encoded as a 64-bit value where the upper 48 bits represent
/// the counter and the lower 16 bits represent the process ID, following Lamport's
/// original paper suggestion of using <c>(counter, process_id)</c> tuples.
/// </para>
/// </remarks>
[PublicAPI]
public readonly record struct ProcessLamportTimestamp : IComparable<ProcessLamportTimestamp>, IComparable {
    /// <summary>
    /// Gets the logical counter value.
    /// </summary>
    public long Counter { get; private init; }

    /// <summary>
    /// Gets the process identifier.
    /// </summary>
    public ushort ProcessId { get; private init; }

    /// <summary>
    /// Gets the packed 64-bit representation of this timestamp.
    /// </summary>
    public long Value { get; private init; }

    /// <summary>
    /// Creates a new <see cref="ProcessLamportTimestamp"/> with the specified counter and process ID.
    /// </summary>
    /// <param name="counter">The logical counter value. Must be non-negative and fit in 48 bits.</param>
    /// <param name="processId">The process identifier (0-65535).</param>
    /// <returns>A new <see cref="ProcessLamportTimestamp"/> instance.</returns>
    /// <exception cref="ArgumentOutOfRangeException">
    /// Thrown when <paramref name="counter"/> is negative or exceeds 48 bits.
    /// </exception>
    public static ProcessLamportTimestamp Create(long counter, ushort processId) {
        ArgumentOutOfRangeException.ThrowIfNegative(counter);
        ArgumentOutOfRangeException.ThrowIfGreaterThan(counter, 0x0000_FFFF_FFFF_FFFF);

        return new ProcessLamportTimestamp {
            Counter   = counter,
            ProcessId = processId,
            Value     = (counter << 16) | processId
        };
    }

    /// <summary>
    /// Parses a packed 64-bit value into a <see cref="ProcessLamportTimestamp"/>.
    /// </summary>
    /// <param name="value">The packed timestamp value. Must be non-negative.</param>
    /// <returns>A <see cref="ProcessLamportTimestamp"/> parsed from the value.</returns>
    /// <exception cref="ArgumentOutOfRangeException">Thrown when <paramref name="value"/> is negative.</exception>
    public static ProcessLamportTimestamp Parse(long value) {
        ArgumentOutOfRangeException.ThrowIfNegative(value);

        return new ProcessLamportTimestamp {
            Counter   = value >> 16,
            ProcessId = (ushort)(value & 0xFFFF),
            Value     = value
        };
    }

    /// <summary>
    /// Attempts to parse a packed 64-bit value into a <see cref="ProcessLamportTimestamp"/>.
    /// </summary>
    /// <param name="value">The packed timestamp value to parse.</param>
    /// <param name="timestamp">When this method returns, contains the parsed timestamp if successful; otherwise, the default value.</param>
    /// <returns><c>true</c> if parsing succeeded; otherwise, <c>false</c>.</returns>
    public static bool TryParse(long value, out ProcessLamportTimestamp timestamp) {
        if (value < 0) {
            timestamp = default;
            return false;
        }

        timestamp = new ProcessLamportTimestamp {
            Counter   = value >> 16,
            ProcessId = (ushort)(value & 0xFFFF),
            Value     = value
        };

        return true;
    }

    /// <inheritdoc />
    public int CompareTo(ProcessLamportTimestamp other) => Value.CompareTo(other.Value);

    /// <inheritdoc />
    public int CompareTo(object? obj) =>
        obj is ProcessLamportTimestamp other
            ? CompareTo(other)
            : throw new ArgumentException($"Object must be of type {nameof(ProcessLamportTimestamp)}");

    /// <summary>Determines whether one timestamp is less than another.</summary>
    public static bool operator <(ProcessLamportTimestamp left, ProcessLamportTimestamp right) =>
        left.Value < right.Value;

    /// <summary>Determines whether one timestamp is greater than another.</summary>
    public static bool operator >(ProcessLamportTimestamp left, ProcessLamportTimestamp right) =>
        left.Value > right.Value;

    /// <summary>Determines whether one timestamp is less than or equal to another.</summary>
    public static bool operator <=(ProcessLamportTimestamp left, ProcessLamportTimestamp right) =>
        left.Value <= right.Value;

    /// <summary>Determines whether one timestamp is greater than or equal to another.</summary>
    public static bool operator >=(ProcessLamportTimestamp left, ProcessLamportTimestamp right) =>
        left.Value >= right.Value;

    /// <summary>
    /// Converts a <see cref="ProcessLamportTimestamp"/> to its packed 64-bit representation.
    /// </summary>
    /// <param name="timestamp">The timestamp to convert.</param>
    public static implicit operator long(ProcessLamportTimestamp timestamp) => timestamp.Value;

    /// <summary>
    /// Converts a packed 64-bit value to a <see cref="ProcessLamportTimestamp"/>.
    /// </summary>
    /// <param name="value">The packed value to convert.</param>
    /// <exception cref="ArgumentOutOfRangeException">Thrown when <paramref name="value"/> is negative.</exception>
    public static explicit operator ProcessLamportTimestamp(long value) => Parse(value);

    /// <inheritdoc />
    public override string ToString() => $"{Counter:D15}.{ProcessId:D5}";
}

/// <summary>
/// A thread-safe Lamport clock with process identifier for total ordering in distributed systems.
/// </summary>
/// <remarks>
/// <para>
/// This clock generates timestamps that include a process identifier, providing deterministic
/// total ordering across all processes. When two processes generate the same counter value,
/// the process ID serves as a tie-breaker.
/// </para>
/// <para>
/// Timestamps are packable into a single 64-bit value (48 bits counter + 16 bits process ID),
/// making them efficient for storage and transmission.
/// </para>
/// <para>
/// This follows Lamport's original paper suggestion of using <c>(counter, process_id)</c> tuples.
/// </para>
/// </remarks>
[PublicAPI]
public sealed class ProcessLamportClock {
    readonly ushort _processId;

    long _counter;

    /// <summary>
    /// Initializes a new instance of the <see cref="ProcessLamportClock"/> class
    /// with a random process ID, seeded with the current Unix time in milliseconds.
    /// </summary>
    public ProcessLamportClock() : this((ushort)Random.Shared.Next(ushort.MaxValue + 1)) { }

    /// <summary>
    /// Initializes a new instance of the <see cref="ProcessLamportClock"/> class
    /// with the specified process ID, seeded with the current Unix time in milliseconds.
    /// </summary>
    /// <param name="processId">The unique identifier for this process (0-65535).</param>
    public ProcessLamportClock(ushort processId)
        : this(processId, DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()) { }

    /// <summary>
    /// Initializes a new instance of the <see cref="ProcessLamportClock"/> class
    /// with the specified process ID and initial counter value.
    /// </summary>
    /// <param name="processId">The unique identifier for this process (0-65535).</param>
    /// <param name="initialCounter">The initial counter value, typically restored from persisted state.</param>
    public ProcessLamportClock(ushort processId, long initialCounter) {
        ArgumentOutOfRangeException.ThrowIfNegative(initialCounter);
        ArgumentOutOfRangeException.ThrowIfGreaterThan(initialCounter, 0x0000_FFFF_FFFF_FFFF);

        _processId = processId;
        _counter   = initialCounter;
    }

    /// <summary>
    /// Gets the process identifier for this clock.
    /// </summary>
    public ushort ProcessId => _processId;

    /// <summary>
    /// Gets the current timestamp without advancing the clock.
    /// </summary>
    public ProcessLamportTimestamp Current =>
        ProcessLamportTimestamp.Create(Volatile.Read(ref _counter), _processId);

    /// <summary>
    /// Advances the clock for a local event.
    /// </summary>
    /// <returns>The new timestamp after incrementing.</returns>
    /// <exception cref="InvalidOperationException">Thrown when the counter overflows 48 bits.</exception>
    public ProcessLamportTimestamp Tick() {
        var newCounter = Interlocked.Increment(ref _counter);
        ValidateCounterOverflow(newCounter);
        return ProcessLamportTimestamp.Create(newCounter, _processId);
    }

    /// <summary>
    /// Updates the clock after witnessing a timestamp from another process.
    /// </summary>
    /// <param name="received">The timestamp received from another process.</param>
    /// <returns>A new timestamp guaranteed to be greater than both the local and received timestamps.</returns>
    /// <exception cref="InvalidOperationException">Thrown when the counter overflows 48 bits.</exception>
    /// <remarks>
    /// This implements the Lamport clock receive rule: <c>max(local, received.Counter) + 1</c>.
    /// </remarks>
    public ProcessLamportTimestamp Witness(ProcessLamportTimestamp received) =>
        Witness(received.Counter);

    /// <summary>
    /// Updates the clock after witnessing a counter value from another process.
    /// </summary>
    /// <param name="receivedCounter">The counter value received from another process.</param>
    /// <returns>A new timestamp guaranteed to be greater than both the local and received counters.</returns>
    /// <exception cref="InvalidOperationException">Thrown when the counter overflows 48 bits.</exception>
    public ProcessLamportTimestamp Witness(long receivedCounter) {
        long current, updated;

        do {
            current = Volatile.Read(ref _counter);
            updated = Math.Max(current, receivedCounter) + 1;
        } while (Interlocked.CompareExchange(ref _counter, updated, current) != current);

        ValidateCounterOverflow(updated);
        return ProcessLamportTimestamp.Create(updated, _processId);
    }

    static void ValidateCounterOverflow(long counter) {
        if (counter > 0x0000_FFFF_FFFF_FFFF)
            throw new InvalidOperationException($"Lamport counter overflow - exceeded 48-bit maximum. Counter: {counter}");
    }
}
</file>

<file path="src/Kurrent.Processors/Checkpointing/HybridLogicalClock.cs">
namespace Kurrent.Processors.Checkpointing;

/// <summary>
/// A thread-safe Hybrid Logical Clock (HLC) that generates monotonically increasing timestamps
/// combining wall-clock time with a logical counter.
/// </summary>
/// <remarks>
/// Based on "Logical Physical Clocks" by Kulkarni et al.
/// Timestamps stay close to physical time while preserving causal ordering.
/// </remarks>
[PublicAPI]
public sealed class HybridLogicalClock {
    /// <summary>
    /// The default maximum tolerated clock offset (1 minute).
    /// </summary>
    public static readonly TimeSpan DefaultMaxOffset = TimeSpan.FromMinutes(1);

#if NET9_0_OR_GREATER
    readonly Lock         _lock = new();
#else
    readonly object       _lock = new();
#endif
    readonly TimeProvider _timeProvider;
    readonly TimeSpan     _maxOffset;

    int  _counter;
    long _physicalTime;

    /// <summary>
    /// Creates a new HLC seeded from the current wall-clock time.
    /// </summary>
    /// <param name="timeProvider">Time provider for wall-clock time. Defaults to <see cref="TimeProvider.System"/>.</param>
    /// <param name="maxOffset">Maximum tolerated clock drift. Defaults to <see cref="DefaultMaxOffset"/>.</param>
    public HybridLogicalClock(TimeProvider? timeProvider = null, TimeSpan? maxOffset = null) {
        _timeProvider = timeProvider ?? TimeProvider.System;
        _maxOffset    = maxOffset ?? DefaultMaxOffset;
        _physicalTime = GetWallClockTime();
        _counter      = 0;
    }

    /// <summary>
    /// Creates a new HLC synchronized to at least the given timestamp (e.g., restored from persisted state).
    /// </summary>
    /// <param name="initialTimestamp">The minimum starting timestamp.</param>
    /// <param name="timeProvider">Time provider for wall-clock time. Defaults to <see cref="TimeProvider.System"/>.</param>
    /// <param name="maxOffset">Maximum tolerated clock drift. Defaults to <see cref="DefaultMaxOffset"/>.</param>
    public HybridLogicalClock(HybridTimestamp initialTimestamp, TimeProvider? timeProvider = null, TimeSpan? maxOffset = null) {
        _timeProvider = timeProvider ?? TimeProvider.System;
        _maxOffset    = maxOffset ?? DefaultMaxOffset;

        var wallClock = GetWallClockTime();

        if (wallClock >= initialTimestamp.PhysicalTime) {
            _physicalTime = wallClock;
            _counter      = 0;
        }
        else {
            _physicalTime = initialTimestamp.PhysicalTime;
            _counter      = initialTimestamp.Counter;
        }
    }

    /// <summary>
    /// Gets the maximum tolerated clock offset.
    /// </summary>
    public TimeSpan MaxOffset => _maxOffset;

    /// <summary>
    /// Gets the current timestamp without advancing the clock.
    /// </summary>
    public HybridTimestamp Current {
        get {
            lock (_lock)
                return HybridTimestamp.Create(_physicalTime, _counter);
        }
    }

    /// <summary>
    /// Generates a new timestamp, advancing the clock.
    /// </summary>
    /// <returns>A new <see cref="HybridTimestamp"/> guaranteed to be greater than any previously returned timestamp.</returns>
    /// <exception cref="InvalidOperationException">Thrown when the counter overflows due to excessive clock drift.</exception>
    public HybridTimestamp Now() {
        lock (_lock) {
            var wallClock = GetWallClockTime();

            if (wallClock > _physicalTime) {
                _physicalTime = wallClock;
                _counter      = 0;
            }

            var result = HybridTimestamp.Create(_physicalTime, _counter);

            _counter++;
            ValidateCounterOverflow(wallClock);

            return result;
        }
    }

    /// <summary>
    /// Updates the clock after observing an external timestamp, then advances and returns a new timestamp.
    /// </summary>
    /// <param name="received">The external timestamp to synchronize with.</param>
    /// <returns>A new <see cref="HybridTimestamp"/> greater than both the local clock and <paramref name="received"/>.</returns>
    /// <exception cref="InvalidOperationException">Thrown when the counter overflows due to excessive clock drift.</exception>
    /// <exception cref="ClockDriftException">
    /// Thrown when <paramref name="received"/> exceeds local physical time by more than <see cref="MaxOffset"/>.
    /// </exception>
    public HybridTimestamp Receive(HybridTimestamp received) {
        lock (_lock) {
            var wallClock = GetWallClockTime();

            ValidateClockDrift(received, wallClock);

            int resultCounter;
            if (wallClock > _physicalTime && wallClock > received.PhysicalTime) {
                _physicalTime = wallClock;
                resultCounter = 0;
            }
            else if (_physicalTime == received.PhysicalTime) {
                resultCounter = Math.Max(_counter, received.Counter) + 1;
            }
            else if (_physicalTime > received.PhysicalTime) {
                resultCounter = _counter + 1;
            }
            else {
                _physicalTime = received.PhysicalTime;
                resultCounter = received.Counter + 1;
            }

            var result = HybridTimestamp.Create(_physicalTime, resultCounter);

            _counter = resultCounter + 1;
            ValidateCounterOverflow(wallClock);

            return result;
        }
    }

    /// <summary>
    /// Ensures the clock is at least the given timestamp without advancing.
    /// </summary>
    /// <param name="timestamp">The timestamp to catch up to (e.g., restored from persisted state).</param>
    /// <exception cref="ClockDriftException">
    /// Thrown when <paramref name="timestamp"/> exceeds local physical time by more than <see cref="MaxOffset"/>.
    /// </exception>
    /// <remarks>
    /// Unlike <see cref="Receive"/>, this does not increment the counter - it only catches up if behind.
    /// </remarks>
    public void Sync(HybridTimestamp timestamp) {
        lock (_lock) {
            var wallClock = GetWallClockTime();

            ValidateClockDrift(timestamp, wallClock);

            if (timestamp.PhysicalTime > _physicalTime) {
                _physicalTime = timestamp.PhysicalTime;
                _counter      = timestamp.Counter;
            }
            else if (timestamp.PhysicalTime == _physicalTime && timestamp.Counter > _counter)
                _counter = timestamp.Counter;
            // else: our clock is already ahead, nothing to do
        }
    }

    long GetWallClockTime() => _timeProvider.GetUtcNow().ToUnixTimeMilliseconds();

    void ValidateCounterOverflow(long wallClock) {
        if (_counter > ushort.MaxValue)
            throw new InvalidOperationException(
                $"HLC counter overflow - clock drift too high. PhysicalTime: {_physicalTime}, WallClock: {wallClock}");
    }

    void ValidateClockDrift(HybridTimestamp received, long wallClock) {
        var drift = received.PhysicalTime - wallClock;

        if (drift > _maxOffset.TotalMilliseconds)
            throw new ClockDriftException(
                $"Received timestamp {received} is {drift}ms ahead of wall clock. Maximum allowed offset is {_maxOffset.TotalMilliseconds}ms.");
    }
}

/// <summary>
/// A timestamp combining physical time (Unix millis) with a logical counter for ordering.
/// Encoded as 64-bit: upper 48 bits = physical time, lower 16 bits = counter.
/// </summary>
[PublicAPI]
public readonly record struct HybridTimestamp : IComparable<HybridTimestamp>, IComparable {
    /// <summary>
    /// Gets the physical time component (Unix time in milliseconds).
    /// </summary>
    public long PhysicalTime { get; private init; }

    /// <summary>
    /// Gets the counter component for ordering events within the same millisecond.
    /// </summary>
    public int Counter { get; private init; }

    /// <summary>
    /// Gets the packed 64-bit representation of this timestamp.
    /// </summary>
    public long Value { get; private init; }

    public DateTimeOffset DateTimeOffset { get; private init; }

    /// <inheritdoc />
    public int CompareTo(HybridTimestamp other) => Value.CompareTo(other.Value);

    /// <inheritdoc />
    public int CompareTo(object? obj) =>
        obj is HybridTimestamp other
            ? CompareTo(other)
            : throw new ArgumentException($"Object must be of type {nameof(HybridTimestamp)}");

    /// <summary>
    /// Creates a new timestamp with the specified physical time and counter.
    /// </summary>
    public static HybridTimestamp Create(long physicalTime, int counter) {
        ArgumentOutOfRangeException.ThrowIfNegative(physicalTime);
        ArgumentOutOfRangeException.ThrowIfNegative(counter);
        ArgumentOutOfRangeException.ThrowIfGreaterThan(counter, ushort.MaxValue);

        return new HybridTimestamp {
            PhysicalTime   = physicalTime,
            Counter        = counter,
            Value          = (physicalTime << 16) | (uint)counter,
            DateTimeOffset =  DateTimeOffset.FromUnixTimeMilliseconds(physicalTime)
        };
    }

    /// <summary>
    /// Creates a new timestamp with the specified physical time and counter.
    /// </summary>
    public static HybridTimestamp Create(DateTimeOffset physicalTimeUtc, int counter) {
        var physicalTime = physicalTimeUtc.ToUnixTimeMilliseconds();

        ArgumentOutOfRangeException.ThrowIfNegative(physicalTime);
        ArgumentOutOfRangeException.ThrowIfNegative(counter);
        ArgumentOutOfRangeException.ThrowIfGreaterThan(counter, ushort.MaxValue);

        return new HybridTimestamp {
            PhysicalTime   = physicalTime,
            Counter        = counter,
            Value          = (physicalTime << 16) | (uint)counter,
            DateTimeOffset = physicalTimeUtc
        };
    }

    /// <summary>
    /// Parses a packed 64-bit value into a timestamp.
    /// </summary>
    public static HybridTimestamp Parse(long value) {
        ArgumentOutOfRangeException.ThrowIfNegative(value);

        var physicalTime = value >> 16;
        return new HybridTimestamp {
            PhysicalTime   = physicalTime,
            Counter        = (int)(value & 0xFFFF),
            Value          = value,
            DateTimeOffset = DateTimeOffset.FromUnixTimeMilliseconds(physicalTime)
        };
    }

    /// <summary>
    /// Attempts to parse a packed 64-bit value into a timestamp.
    /// </summary>
    public static bool TryParse(long value, out HybridTimestamp timestamp) {
        if (value < 0) {
            timestamp = default;
            return false;
        }

        var physicalTime = value >> 16;

        timestamp = new HybridTimestamp {
            PhysicalTime   = physicalTime,
            Counter        = (int)(value & 0xFFFF),
            Value          = value,
            DateTimeOffset = DateTimeOffset.FromUnixTimeMilliseconds(physicalTime)
        };

        return true;
    }

    /// <inheritdoc cref="IComparable{T}.CompareTo"/>
    public static bool operator <(HybridTimestamp left, HybridTimestamp right) => left.Value < right.Value;

    /// <inheritdoc cref="IComparable{T}.CompareTo"/>
    public static bool operator >(HybridTimestamp left, HybridTimestamp right) => left.Value > right.Value;

    /// <inheritdoc cref="IComparable{T}.CompareTo"/>
    public static bool operator <=(HybridTimestamp left, HybridTimestamp right) => left.Value <= right.Value;

    /// <inheritdoc cref="IComparable{T}.CompareTo"/>
    public static bool operator >=(HybridTimestamp left, HybridTimestamp right) => left.Value >= right.Value;

    /// <summary>Converts to packed 64-bit representation.</summary>
    public static implicit operator long(HybridTimestamp timestamp) => timestamp.Value;

    /// <summary>Parses from packed 64-bit value.</summary>
    public static explicit operator HybridTimestamp(long value) => Parse(value);

    /// <inheritdoc />
    public override string ToString() => $"{PhysicalTime:D19}.{Counter:D5}";
}

/// <summary>
/// Thrown when a timestamp exceeds the maximum tolerated clock drift.
/// </summary>
[PublicAPI]
public sealed class ClockDriftException : Exception {
    /// <inheritdoc />
    public ClockDriftException() { }

    /// <inheritdoc />
    public ClockDriftException(string message) : base(message) { }

    /// <inheritdoc />
    public ClockDriftException(string message, Exception innerException) : base(message, innerException) { }
}
