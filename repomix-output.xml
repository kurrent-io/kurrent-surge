<file path="examples/Transfermarkt.Domain/Domain/Events/PlayerTransferred.cs">
namespace Transfermarkt.Domain;

/// <summary>
/// A player moves between clubs (or enters/exits the system).
/// This is THE core event - equivalent to a financial transaction.
/// All other events derive from or react to this.
/// </summary>
/// <remarks>
/// <para>
/// When <see cref="FromClubId"/> is <see cref="ClubId.None"/>, the player is entering the system
/// (new registration, youth promotion).
/// </para>
/// <para>
/// When <see cref="ToClubId"/> is <see cref="ClubId.None"/>, the player is leaving the system
/// (retirement).
/// </para>
/// </remarks>
[PublicAPI]
public sealed record PlayerTransferred {
    /// <summary>
    /// Unique identifier for this transfer.
    /// </summary>
    public TransferId TransferId { get; init; }

    /// <summary>
    /// The player being transferred.
    /// </summary>
    public PlayerId PlayerId { get; init; }

    /// <summary>
    /// The player's name at the time of transfer.
    /// </summary>
    public PlayerName PlayerName { get; init; }

    /// <summary>
    /// The club the player is leaving. <see cref="ClubId.None"/> if entering the system.
    /// </summary>
    public ClubId FromClubId { get; init; }

    /// <summary>
    /// The club the player is joining. <see cref="ClubId.None"/> if leaving the system (retirement).
    /// </summary>
    public ClubId ToClubId { get; init; }

    /// <summary>
    /// The type of transfer.
    /// </summary>
    public TransferType Type { get; init; }

    /// <summary>
    /// The date the transfer becomes effective.
    /// </summary>
    public DateOnly EffectiveDate { get; init; }

    /// <summary>
    /// The transfer fee. <see cref="Money.Zero"/> for free transfers or loans without fee.
    /// </summary>
    public Money Fee { get; init; }

    /// <summary>
    /// Loan terms if this is a loan transfer. <see cref="LoanTerms.None"/> for non-loan transfers.
    /// </summary>
    public LoanTerms LoanTerms { get; init; }

    /// <summary>
    /// When the transfer was recorded.
    /// </summary>
    public DateTimeOffset TransferredAt { get; init; }

    /// <summary>
    /// Whether the player is entering the system (new registration).
    /// </summary>
    public bool IsNewPlayer => FromClubId.IsUnset;

    /// <summary>
    /// Whether the player is leaving the system (retirement).
    /// </summary>
    public bool IsRetirement => ToClubId.IsUnset;

    /// <summary>
    /// Whether this is a loan transfer.
    /// </summary>
    public bool IsLoan => LoanTerms.IsSet;

}
</file>

<file path="examples/Transfermarkt.Domain/Domain/Model/ClubId.cs">
namespace Transfermarkt.Domain;

/// <summary>
/// Strongly-typed identifier for a club.
/// </summary>
[PublicAPI]
public readonly record struct ClubId {
    static readonly Guid UnknownGuid = new("00000000-0000-0000-0000-000000000001");

    /// <summary>
    /// Represents an uninitialized or empty club identifier (no club specified).
    /// Use for new player registrations or retirements.
    /// </summary>
    public static readonly ClubId None = new(Guid.Empty);

    /// <summary>
    /// Represents an unknown club (club exists but identity is not known).
    /// Use when a club reference is required but the actual club is not identified.
    /// </summary>
    public static readonly ClubId Unknown = new(UnknownGuid);

    public ClubId(Guid value) => Value = value;

    /// <summary>
    /// The underlying GUID value.
    /// </summary>
    public Guid Value { get; init; }

    /// <summary>
    /// Indicates whether this identifier is unset (no club).
    /// </summary>
    public bool IsUnset => this == None;

    /// <summary>
    /// Indicates whether this identifier represents an unknown club.
    /// </summary>
    public bool IsUnknown => this == Unknown;

    /// <summary>
    /// Indicates whether this identifier is valid (not None and not Unknown).
    /// </summary>
    public bool IsValid => !IsUnset && !IsUnknown;

    /// <summary>
    /// Creates a new unique club identifier.
    /// </summary>
    public static ClubId New() => new(Guid.NewGuid());

    /// <summary>
    /// Creates a ClubId from a GUID value.
    /// </summary>
    public static ClubId From(Guid value) =>
        value == Guid.Empty
            ? throw new ArgumentException("ClubId cannot be empty. Use ClubId.None instead.", nameof(value))
            : value == UnknownGuid
                ? throw new ArgumentException("ClubId cannot use the reserved Unknown GUID. Use ClubId.Unknown instead.", nameof(value))
                : new ClubId(value);

    public static implicit operator Guid(ClubId id) => id.Value;

    public override string ToString() =>
        IsUnset   ? "(none)" :
        IsUnknown ? "(unknown)" :
        Value.ToString();
}
</file>

