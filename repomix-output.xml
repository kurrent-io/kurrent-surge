<file path="src/Kurrent.Client/Errors/Exceptions.cs">
// ReSharper disable CheckNamespace

using Google.Rpc;
using Google.Rpc.Exceptions;
using Grpc.Core;
using Kurrent.Client.Errors;
using Kurrent.Rpc;
using Kurrent.Variant;
using Status = Google.Rpc.Status;

namespace Kurrent.Client.Exceptions;

[KurrentOperationError(ServerError.LeaderForwardingTimeout)]
public partial class LeaderForwardingTimeoutException;

[KurrentOperationError(ServerError.ServerNotReady)]
public partial class ServerNotReadyException;

[KurrentOperationError(ServerError.ServerOverloaded)]
public partial class ServerOverloadedException;

[KurrentOperationError(ServerError.NotLeaderNode)]
public partial class NotLeaderNodeException {
    public NodeInfo CurrentLeader { get; private set; } = NodeInfo.None;

    public void AfterParseRpcStatus(Status status, NotLeaderNodeException self) {
        var details = status.GetDetail<NotLeaderNodeErrorDetails>()!;
        self.CurrentLeader = NodeInfo.From(
            details.CurrentLeader.Host,
            details.CurrentLeader.Port,
            details.CurrentLeader.NodeId);
    }
}

delegate dynamic? OperationExceptionParser(Status status, ErrorInfo? errorInfo);

static class ExceptionExtensions {
    static readonly OperationExceptionParser[] GoogleParsers = [
        static (s, e) => CancelledException.From(s, e),
        static (s, e) => UnknownException.From(s, e),
        static (s, e) => InvalidArgumentException.From(s, e),
        static (s, e) => DeadlineExceededException.From(s, e),
        static (s, e) => NotFoundException.From(s, e),
        static (s, e) => AlreadyExistsException.From(s, e),
        static (s, e) => PermissionDeniedException.From(s, e),
        static (s, e) => UnauthenticatedException.From(s, e),
        static (s, e) => ResourceExhaustedException.From(s, e),
        static (s, e) => FailedPreconditionException.From(s, e),
        static (s, e) => AbortedException.From(s, e),
        static (s, e) => OutOfRangeException.From(s, e),
        static (s, e) => UnimplementedException.From(s, e),
        static (s, e) => InternalException.From(s, e),
        static (s, e) => UnavailableException.From(s, e),
        static (s, e) => DataLossException.From(s, e)
    ];

    static readonly OperationExceptionParser[] ServerParsers = [
        static (s, e) => LeaderForwardingTimeoutException.From(s, e),
        static (s, e) => ServerNotReadyException.From(s, e),
        static (s, e) => ServerOverloadedException.From(s, e),
        static (s, e) => NotLeaderNodeException.From(s, e)
    ];

    extension(Exception ex) {
        /// <summary>
        /// Dangerously converts an Exception into a variant error result by trying to parse it using the provided parsers,
        /// followed by the built-in server and standard google parsers.
        /// </summary>
        public TError ToExceptionalErrorResult<TError>(params OperationExceptionParser[] parsers) where TError : class, IVariantException {
            // pass through KurrentException as is (just in case)
            if (ex is KurrentException kex)
                return (dynamic)kex;

            // fast fail for non-RpcException
            if (ex is not RpcException rex)
                return (dynamic)ex;

            // extract status and error info
            var status    = rex.GetRpcStatus();
            var errorInfo = status?.GetDetail<ErrorInfo>();

            // create status fallback
            status ??= new Status {
                Code    = (int)rex.StatusCode,
                Message = rex.Message
            };

            // try to parse using the provided parsers, then server parsers, then google parsers
            // and finally fallback to the original exception
            return parsers
                .Concat(ServerParsers)
                .Concat(GoogleParsers)
                .Select(parse => parse(status, errorInfo))
                .SkipWhile(result => result is null)
                .DefaultIfEmpty(ex)
                .Select(ex => (TError)ex!)
                .First();
        }

        public Exception ToException(params OperationExceptionParser[] parsers) {
            // pass through KurrentException as is (just in case)
            if (ex is KurrentException kex)
                return kex;

            // fast fail for non-RpcException
            if (ex is not RpcException rex)
                return ex;

            // extract status and error info
            var status    = rex.GetRpcStatus();
            var errorInfo = status?.GetDetail<ErrorInfo>();

            // create status fallback
            status ??= new Status {
                Code    = (int)rex.StatusCode,
                Message = rex.Message
            };

            // try to parse using the provided parsers, then server parsers, then google parsers
            // and finally fallback to the original exception
            return parsers
                .Concat(ServerParsers)
                .Concat(GoogleParsers)
                .Select(parse => parse(status, errorInfo))
                .SkipWhile(result => result is null)
                .DefaultIfEmpty(ex)
                .Select(ex => (Exception)ex!)
                .First();
        }
    }
}
</file>

<file path="src/Kurrent.Client/Errors/KurrentErrorDetails.cs">
using System.Net;

namespace Kurrent.Client.Errors;

/// <summary>
/// Detailed information about a Kurrent error, including reason, metadata, retry info, resource info, and auth info.
/// <remarks>
/// This class is used to encapsulate structured error details that can be included in exceptions.
/// It provides a way to centralize and convey rich error information.
/// </remarks>
/// </summary>
[PublicAPI]
public class KurrentErrorDetails {
    public static readonly KurrentErrorDetails None = new();

    public ErrorCode    ErrorCode    { get; set; } = ErrorCode.Unknown;
    public Metadata     Metadata     { get; set; } = Metadata.New;
    public RetryInfo    RetryInfo    { get; set; } = RetryInfo.None;
    public ResourceInfo ResourceInfo { get; set; } = ResourceInfo.None;

    public bool HasMetadata     => Metadata.Count > 0;
    public bool HasRetryInfo    => RetryInfo != RetryInfo.None;
    public bool HasResourceInfo => ResourceInfo != ResourceInfo.None;
}

/// <summary>
/// Information about a specific resource within the system.
/// </summary>
[PublicAPI]
public record ResourceInfo {
    public static readonly ResourceInfo None = new("", "");

    ResourceInfo(string type, string id) {
        Type = type;
        Id   = id;
    }

    /// <summary>
    /// The type of the resource (e.g., "Stream", "Registry", etc.).
    /// </summary>
    public string Type { get; internal init; }

    /// <summary>
    /// The unique identifier of the resource.
    /// </summary>
    public string Id { get; internal init; }

    public static ResourceInfo From(string type, string id) {
        ArgumentException.ThrowIfNullOrWhiteSpace(type);
        ArgumentException.ThrowIfNullOrWhiteSpace(id);
        return new ResourceInfo(type, id);
    }

    public override string ToString() => this != None ? $"{Type}('{Id}')" : "";
}

/// <summary>
/// Information about the current leader node in a clustered deployment.
/// </summary>
[PublicAPI]
public record NodeInfo {
    public static readonly NodeInfo None = new(null!, Guid.Empty);

    NodeInfo(DnsEndPoint endPoint, Guid nodeId) {
        EndPoint = endPoint;
        NodeId   = nodeId;
    }

    /// <summary>
    /// The network endpoint (host and port) of the current leader node.
    /// </summary>
    public DnsEndPoint EndPoint { get; internal init; }

    /// <summary>
    /// The unique instance ID of the current leader node.
    /// </summary>
    public Guid NodeId { get; internal init; }

    public static NodeInfo From(string host, int port, string nodeId) {
        ArgumentException.ThrowIfNullOrWhiteSpace(host);
        ArgumentOutOfRangeException.ThrowIfLessThan(port, 1);
        ArgumentOutOfRangeException.ThrowIfGreaterThan(port, 65535);

        if (!Guid.TryParse(nodeId, out var id))
            throw new ArgumentException("NodeId must be a valid GUID.", nameof(nodeId));

        return new NodeInfo(new DnsEndPoint(host, port), id);
    }

    public static NodeInfo From(DnsEndPoint endpoint, Guid nodeId) => new(endpoint, nodeId);

    public override string ToString() =>
        this != None ? $"{NodeId} @ {EndPoint}" : "";
}

/// <summary>
/// Information about whether an operation can be retried, and if so, after what delay.
/// </summary>
[PublicAPI]
public readonly record struct RetryInfo {
    public static readonly RetryInfo None = new(TimeSpan.MinValue);

    RetryInfo(TimeSpan delay) {
        Delay     = delay;
        Retryable = delay >= TimeSpan.Zero;
    }

    public TimeSpan Delay     { get; internal init; }
    public bool     Retryable { get; internal init; }

    public static RetryInfo From(TimeSpan delay) =>
        delay < TimeSpan.Zero
            ? throw new ArgumentOutOfRangeException(nameof(delay), "Retry Delay must be non-negative ")
            : new RetryInfo(delay);

    public override string ToString() =>
        Retryable
            ? Delay == TimeSpan.Zero
                ? "Retry immediately"
                : $"Retry after {Delay}"
            : "Do not retry";
}
</file>

<file path="src/Kurrent.Client/Errors/KurrentException.cs">
using System.Diagnostics.CodeAnalysis;
using Google.Rpc;
using Kurrent.Client.Errors;
using Kurrent.GoogleRpc;
using RetryInfo = Kurrent.Client.Errors.RetryInfo;
using ResourceInfo = Kurrent.Client.Errors.ResourceInfo;
using Status = Google.Rpc.Status;

namespace Kurrent.Client.Exceptions;

/// <summary>
/// Core and base exception class for all Kurrent-related errors, encapsulating detailed error information.
/// <remarks>
/// This class serves as the foundation for more specific Kurrent exceptions, providing a consistent way to
/// include structured error details such as reason codes, metadata, retry information, resource context, and
/// authentication details.
/// </remarks>
/// </summary>
[PublicAPI]
public class KurrentException : Exception {
    public KurrentException(KurrentErrorDetails details, string message, Exception? innerException = null)
        : base(message, innerException) => ErrorDetails = details;

    public KurrentException(ErrorCode code, string message, Exception? innerException = null)
        : this(new KurrentErrorDetails { ErrorCode = code }, message, innerException) { }

    protected internal KurrentException(ErrorCode code, Status status) : base(status.Message, status.GetDetail<DebugInfo>().ToException()) {
        var details = new KurrentErrorDetails { ErrorCode = code };

        if (status.GetDetail<Google.Rpc.ResourceInfo>() is { } resourceInfo)
            details.ResourceInfo = ResourceInfo.From(resourceInfo.ResourceType, resourceInfo.ResourceName);

        if (status.GetDetail<Google.Rpc.RetryInfo>() is { } retryInfo)
            details.RetryInfo = RetryInfo.From(retryInfo.RetryDelay.ToTimeSpan());

        ErrorDetails = details;
    }

    /// <summary>
    /// Detailed information about a Kurrent error, including reason, metadata, retry info, resource info, and auth info.
    /// </summary>
    public KurrentErrorDetails ErrorDetails { get; init; }

    public override string ToString() => $"[{ErrorDetails.ErrorCode}] {Message}";
}

static class KurrentExceptionExtensions {
    extension(KurrentException) {
        /// <summary>
        /// Attempts to parse the given gRPC Status into a KurrentException.
        /// It is basically a cop-out for the generated exception classes' TryParseRpcStatus methods.
        /// </summary>
        public static bool TryParseRpcStatus(Status status, ErrorInfo? errorInfo, [MaybeNullWhen(false)] out KurrentException ex) {
            var code = errorInfo is not null
                ? ErrorCode.From(errorInfo.Reason)
                : ErrorCode.FromEnum(status.GetGrpcStatusCode());

            ex = new KurrentException(code, status);

            return true;
        }

        public static KurrentException? From(Status status, ErrorInfo? errorInfo = null) =>
            TryParseRpcStatus(status, errorInfo, out var ex) ? ex : null;
    }
}

/// <summary>
/// Interface for Kurrent exceptions that can be parsed from gRPC Status messages.
/// </summary>
public interface IKurrentOperationException<T> where T : KurrentException {
    /// <summary>
    /// The associated error code for this exception type.
    /// It will match against RPC statuses to determine if this exception is the correct one to instantiate.
    /// </summary>
    static abstract ErrorCode Code { get; }

    /// <summary>
    /// Hook called after parsing the RPC status into the exception instance.
    /// Allows for post-processing or additional initialization.
    /// </summary>
    void AfterParseRpcStatus(Status status, T self) { }

    /// <summary>
    /// Attempts to parse the given gRPC Status into an instance of this exception type.
    /// </summary>
    static abstract bool TryParseRpcStatus(Status status, ErrorInfo? errorInfo, [MaybeNullWhen(false)] out T ex);

    /// <summary>
    /// Attempts to parse the given gRPC Status into an instance of this exception type.
    /// </summary>
    static abstract T? From(Status status, ErrorInfo? errorInfo = null);
}
</file>

