<file path="src/Kurrent.Client/Modules/Streams/Metadata/MetadataDecoder.cs">
// ReSharper disable SwitchStatementHandlesSomeKnownEnumValuesWithDefault
// ReSharper disable SwitchExpressionHandlesSomeKnownEnumValuesWithExceptionInDefault

using System.Diagnostics;
using System.Diagnostics.CodeAnalysis;
using System.Text.Json;
using System.Text.Json.Nodes;
using Kurrent.Client.Exceptions;
using Kurrent.Client.Registry;

namespace Kurrent.Client.Streams;

// TODO SS: I don't think that we need to handle anything related with adding schema name/format to metadata anymore.

/// <summary>
/// Provides a base implementation for decoding metadata from serialized byte representations.
/// Serves as an abstraction for specific metadata decoding implementations.
/// </summary>
public abstract class MetadataDecoder : IMetadataDecoder {
    static readonly SchemaName LinkSchemaName = "$>";

    /// <inheritdoc />
    public ValueTask<Metadata> Decode(ReadOnlyMemory<byte> bytes, MetadataDecoderContext context) {
        if (bytes.IsEmpty)
            return new Metadata()
                .AddSchemaNameIfMissing(context.SchemaName)
                .AddSchemaFormatIfMissing(context.SchemaFormat)
                .AsValueTask();

        try {
            if (context.SchemaName == LinkSchemaName)
                return DeserializeLinkMetadata(bytes).AsValueTask();

            return DecodeCore(bytes, context)
                .AddSchemaNameIfMissing(context.SchemaName)
                .AddSchemaFormatIfMissing(context.SchemaFormat)
                .AsValueTask();
        }
        catch (Exception ex) when (ex is not MetadataDecodingException) {
            throw new MetadataDecodingException(GetType(), context, ex);
        }
    }

    static Metadata DeserializeLinkMetadata(ReadOnlyMemory<byte> bytes) {
        // [0] = {DebugViewDictionaryItem<string, JsonValue>} [$v]=1:-1:1:4
        // [1] = {DebugViewDictionaryItem<string, JsonValue>} [$c]=10868
        // [2] = {DebugViewDictionaryItem<string, JsonValue>} [$p]=10868
        // [3] = {DebugViewDictionaryItem<string, JsonValue>} [$causedBy]=373c6630-d8fe-ff2c-16af-e286265e7e98

        var deserialized = JsonSerializer.Deserialize<Dictionary<string, JsonValue>>(
            bytes.Span,
            Schema.Serialization.Json.KurrentJsonContext.Default.Options)!;

        return new Metadata()
            .With(SystemMetadataKeys.SchemaName, LinkSchemaName)
            .With(SystemMetadataKeys.SchemaFormat, SchemaDataFormat.Json)
            .With("$v", deserialized["$v"].ToString())
            .With("$c", deserialized["$c"].GetValue<long>())
            .With("$p", deserialized["$p"].GetValue<long>())
            .WithIf(_ => deserialized.ContainsKey("$o"), "$o", () => StreamName.From(deserialized["$o"].ToString()))
            .With("$causedBy", deserialized["$causedBy"].GetValue<Guid>());
    }

    protected abstract Metadata DecodeCore(ReadOnlyMemory<byte> bytes, MetadataDecoderContext context);
}

/// <summary>
/// Defines a contract for decoding metadata from serialized byte representations.
/// Implementors of this interface should provide functionality to convert serialized binary data
/// into <see cref="Metadata"/> objects.
/// </summary>
public interface IMetadataDecoder {
    /// <summary>
    /// Decodes metadata from a byte array.
    /// </summary>
    /// <param name="bytes">The serialized metadata bytes.</param>
    /// <param name="context">
    /// The context for decoding metadata, providing additional information such as the originating stream's name,
    /// </param>
    /// <returns>The decoded <see cref="Metadata"/> object.</returns>
    ValueTask<Metadata> Decode(ReadOnlyMemory<byte> bytes, MetadataDecoderContext context);
}

/// <summary>
/// Encapsulates metadata decoding context, providing necessary information to decode metadata.
/// </summary>
[PublicAPI]
public readonly record struct MetadataDecoderContext(
    StreamName Stream,
    SchemaName SchemaName,
    SchemaDataFormat SchemaFormat
);

[PublicAPI]
public class MetadataDecodingException(Type decoderType, MetadataDecoderContext decoderContext, Exception innerException)
    : KurrentException(ErrorCode.FromType<MetadataDecodingException>(), ErrorMessage(decoderType, decoderContext, innerException), innerException) {

    public Type                   DecoderType    { get; } = decoderType;
    public MetadataDecoderContext DecoderContext { get; } = decoderContext;

    static string ErrorMessage(Type type, MetadataDecoderContext ctx, Exception ex) =>
        $"Failed to decode '{ctx.SchemaName}' record metadata " +
        $"from '{ctx.Stream}' using instance of '{type.Name}': {ex.Message}";

    [DoesNotReturn, StackTraceHidden]
    public static void Throw(Type decoderType, MetadataDecoderContext decoderContext, Exception innerException) =>
        throw new MetadataDecodingException(decoderType, decoderContext, innerException);
}
</file>

<file path="src/Kurrent.Client/Modules/Streams/Models/Maps/ProtocolMapper.cs">
#pragma warning disable CS8524 // The switch expression does not handle some values of its input type (it is not exhaustive) involving an unnamed enum value.

using System.Collections;
using Google.Protobuf.Collections;
using Google.Protobuf.WellKnownTypes;

namespace Kurrent.Client.Streams;

[PublicAPI]
static class ProtocolMapper {
    public static Metadata ToMetadata(this MapField<string, Value> source) {
        return source.Aggregate(new Metadata(), (meta, entry) => meta.With(entry.Key, MapToMetadataValue(entry.Value)));

        static object? MapToMetadataValue(Value source) =>
            source.KindCase switch {
                Value.KindOneofCase.NullValue   => null,
                Value.KindOneofCase.None        => null,
                Value.KindOneofCase.StringValue => source.StringValue,
                Value.KindOneofCase.BoolValue   => source.BoolValue,
                Value.KindOneofCase.NumberValue => source.NumberValue,
                Value.KindOneofCase.StructValue => source.StructValue.Fields.ToMetadata(),
                Value.KindOneofCase.ListValue   => source.ListValue.Values.Select(MapToMetadataValue)
            };
    }

    public static MapField<string, Value> ToProperties(this Metadata source) {
        return source.Aggregate(
            new MapField<string, Value>(), (seed, entry) => {
                seed.Add(entry.Key, ToValue(entry.Value));
                return seed;
            }
        );
    }

    /// <summary>
    /// This is tricky, because we need to map a lot of different types to a protobuf value
    /// The main challenge is to decide what to do with byte arrays. We can either treat them as strings (base64) or as lists of numbers.
    /// By default we treat them as strings, but if the flag is set to true, we convert them to lists of numbers.
    /// Need to figure this out properly even with numbers, because protobuf only supports double as number type.
    /// perhaps we can go lazy with a try/catch around map to value and if it fails we convert to string?
    /// </summary>
    public static Value ToValue(object? source, bool treatByteArrayAsString = false) {
        if (IsNumber(source))
            return new Value { NumberValue = Convert.ToDouble(source) };

        // somehow I need to check if the source is a collection or enumerable so I can map them to a list value
        if (source is IEnumerable and not string and not byte[] and not Metadata) {
            var values = ((IEnumerable)source).Cast<object?>().Select(val => ToValue(val, treatByteArrayAsString));
            return new Value { ListValue = new ListValue { Values = { values } } };
        }

        return source switch {
            null       => new Value { NullValue   = NullValue.NullValue },
            string x   => new Value { StringValue = x },
            bool x     => new Value { BoolValue   = x },
            Metadata x => new Value { StructValue = new Struct { Fields = { x.ToProperties() } } },

            ReadOnlyMemory<byte> x => new Value { StringValue = Convert.ToBase64String(x.Span) },
            Memory<byte> x         => new Value { StringValue = Convert.ToBase64String(x.Span) },
            ArraySegment<byte> x   => new Value { StringValue = Convert.ToBase64String(x.Array ?? x.ToArray()) },
            byte[] x               => new Value { StringValue = Convert.ToBase64String(x) },

            _ => new Value { StringValue = source.ToString() }
        };

        static bool IsNumber(object? source) =>
            source is int or double or float or decimal or long or short or byte or sbyte or ushort or uint or ulong;
    }

    //public record ValueMappingOptions(bool ConvertBytes = false);

    // extension(object? source) {
    //     /// <summary>
    //     /// This is tricky, because we need to map a lot of different types to a protobuf value
