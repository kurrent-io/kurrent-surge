<Project>

  <!-- Suppress all warnings in Release for non-packable projects (tests, tools, shared infra).
       Evaluated in .targets so IsPackable has its final value from each .csproj. Projects that opt
       into AOT analysis keep their warnings. The trim and AOT diagnostics are the point of that opt-in,
       and a bundled library (IsPackable=false) still ships to consumers. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(IsPackable)' != 'true' And '$(IsAotCompatible)' != 'true'">
    <WarningLevel>0</WarningLevel>
  </PropertyGroup>

  <!--
    Vendor / Bundle / Analyzer infrastructure.

    Metadata flags on references control how they appear in the produced .nupkg:

      PackageReference  Vendor="true"          → ship binaries inside our package,
                                                  hide from nuspec dependencies
      ProjectReference  Bundle="true"          → ship the project's output inside our package, hide
                                                  from nuspec. Nests: whatever the bundled project
                                                  itself bundles, packs as an analyzer, or ships as
                                                  build/*.props ships too, at any depth
      ProjectReference  Analyzer="true"        → wire as a source generator; ship nothing;
                                                  hide from nuspec (SDK-internal generators)
      ProjectReference  PackedAnalyzer="true"  → wire as a source generator AND ship it in
                                                  analyzers/dotnet/cs so it runs in CONSUMER
                                                  compilations; hide from nuspec. Declared once as
                                                  @(PackedAnalyzerProject) (Directory.Build.props)
                                                  and ALSO wired for in-repo source consumers — see
                                                  "Source-generator flow for in-repo consumers" at
                                                  the bottom of this file.
  -->

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <TargetsForTfmSpecificBuildOutput>
      $(TargetsForTfmSpecificBuildOutput);_CollectVendoredAndBundledFiles
    </TargetsForTfmSpecificBuildOutput>
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);_CollectPackedAnalyzers;_CollectBundledBuildProps
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!--
    Evaluation-time metadata for flagged references.

    Analyzer: wires into the Roslyn pipeline at evaluation time (must be early).
    Vendor/Bundle: types flow transitively during build — PrivateAssets is NOT
    set here. It's set by the _SuppressFlaggedDeps-gated group below so
    bundled/vendored types remain available to downstream ProjectReference
    consumers while still being excluded from the nuspec.
  -->
  <ItemGroup>
    <ProjectReference Update="@(ProjectReference->WithMetadataValue('Analyzer', 'true'))"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Update="@(ProjectReference->WithMetadataValue('PackedAnalyzer', 'true'))"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!--
    Suppress Vendor/Bundle references from the nuspec dependency list.
    Evaluation-time so PrivateAssets is visible to the NuGet dependency walker.

    Gated on _SuppressFlaggedDeps, which ONLY _RestoreForPack below passes, never the CLI.
    It must not be gated on _IsPacking: the SDK sets that as a GLOBAL property, so it flows
    into every referenced project. Packing a downstream project (dotnet pack Kurrent.Surge)
    would then restore Kurrent.Surge.Core with its bundled edge private, write
    PrivateAssets="all" into the DOWNSTREAM project's assets file, and strip the bundled
    types from a compilation that needs them (CS0234 on Kurrent.Variant).
  -->
  <ItemGroup Condition="'$(_SuppressFlaggedDeps)' == 'true'">
    <PackageReference Update="@(PackageReference->WithMetadataValue('Vendor', 'true'))"
                      PrivateAssets="all" />
    <ProjectReference Update="@(ProjectReference->WithMetadataValue('Bundle', 'true'))"
                      PrivateAssets="all" />
  </ItemGroup>

  <!--
    Make the suppression above hold regardless of how pack was invoked.

    NuGet's PackTask reads project-to-project dependencies straight from project.assets.json
    (RestoreMetadata.TargetFrameworks[].ProjectReferences[].PrivateAssets) and omits a dependency
    only when PrivateAssets there is "all". That field is written at RESTORE time from the
    PrivateAssets metadata above — which is only set when restore runs under
    _SuppressFlaggedDeps. A pack
    that reuses a build-time restore graph (a no-restore pack, or a no-build pack that skips the
    writing restore, as CI and release do) therefore reads PrivateAssets="None" and leaks the
    bundled project into the nuspec as a phantom dependency (NU1101 on the consumer).

    The PrivateAssets metadata is NOT exposed to PackTask through any MSBuild item it consumes
    (@(_ProjectReferencesWithVersions) only carries version overrides), and the on-disk assets
    file cannot be patched between restore and PackTask. So the only invocation-independent fix is
    to force a pack-context restore here: re-run Restore under _SuppressFlaggedDeps so the assets
    file carries PrivateAssets="all" before PackTask reads it. RestoreForce defeats the
    "up-to-date" skip when a prior non-pack restore already wrote the graph. Running
    BeforeTargets="GenerateNuspec" puts this after Build, so the rewritten graph cannot reach
    the compilation that already happened.

    This only runs while packing (_IsPacking=true) and only when there is something to suppress, so
    it adds nothing to build/test/run — whose restore graph keeps PrivateAssets="None" and lets the
    refs flow transitively to in-repo ProjectReference consumers.
  -->
  <Target Name="_RestoreForPack"
          BeforeTargets="GenerateNuspec"
          Condition="'$(_IsPacking)' == 'true' and
                     ('@(ProjectReference->WithMetadataValue('Bundle', 'true'))' != '' or
                      '@(PackageReference->WithMetadataValue('Vendor', 'true'))' != '')">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Restore"
             Properties="_SuppressFlaggedDeps=true;RestoreForce=true;Configuration=$(Configuration)" />
  </Target>

  <!--
    Collect the binaries that need to ship inside the package and place them
    at the correct package paths (preserving lib/<tfm>/, runtimes/<rid>/native/,
    satellite directories, etc).
  -->
  <Target Name="_CollectVendoredAndBundledFiles"
          DependsOnTargets="ResolveAssemblyReferences;ResolveTargetingPackAssets">

    <!-- Bundled projects: ask each for its own output and, recursively, for everything it bundles.
         GetTargetPath underneath resolves AssemblyName correctly regardless of project filename. -->
    <MSBuild Projects="@(ProjectReference->WithMetadataValue('Bundle', 'true'))"
             Targets="_GetBundledClosure"
             Properties="TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledProjectAssembly" />
    </MSBuild>
    <RemoveDuplicates Inputs="@(_BundledProjectAssembly)">
      <Output TaskParameter="Filtered" ItemName="_BundledProjectAssemblyUnique" />
    </RemoveDuplicates>
    <ItemGroup>
      <BuildOutputInPackage Include="@(_BundledProjectAssemblyUnique)" />
    </ItemGroup>

    <!-- Vendored packages: collect from resolved copy-local paths by NuGetPackageId. -->
    <ItemGroup>
      <_VendorPkg Include="@(PackageReference->WithMetadataValue('Vendor', 'true'))" />
      <_FromVendoredPackages
          Include="@(ReferenceCopyLocalPaths->WithMetadataValue('NuGetPackageId', '%(_VendorPkg.Identity)'))" />
      <_FromVendoredPackages Remove="@(_FromVendoredPackages)"
                             Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>

    <ItemGroup>
      <!-- Managed DLLs → lib/<tfm>/ (BuildOutputInPackage default) -->
      <BuildOutputInPackage Include="@(_FromVendoredPackages)"
                            Condition="'%(_FromVendoredPackages.DestinationSubDirectory)' == ''" />

      <!-- Satellite assemblies → lib/<tfm>/<subdir>/ -->
      <BuildOutputInPackage Include="@(_FromVendoredPackages)"
                            Condition="'%(_FromVendoredPackages.DestinationSubDirectory)' != '' and !$([System.String]::new('%(_FromVendoredPackages.DestinationSubDirectory)').StartsWith('runtimes'))"
                            TargetPath="%(_FromVendoredPackages.DestinationSubDirectory)%(Filename)%(Extension)" />

      <!-- runtimes/<rid>/... lives at the package root, not under lib/ -->
      <TfmSpecificPackageFile Include="@(_FromVendoredPackages)"
                              Condition="$([System.String]::new('%(_FromVendoredPackages.DestinationSubDirectory)').StartsWith('runtimes'))"
                              PackagePath="%(_FromVendoredPackages.DestinationSubDirectory)" />
    </ItemGroup>

  </Target>

  <!--
    The bundle closure. Every project has these targets (this file is imported everywhere), so a
    packable project asks each Bundle reference once and the recursion walks the Bundle flags the
    referenced projects already carry. Nothing is listed by hand.

    _GetBundledClosure          own output DLL + the closure of every Bundle reference
    _GetPackedAnalyzerClosure   own PackedAnalyzer DLLs + the closure of every Bundle reference
    _GetBundledBuildProps       own build/*.props items (None, Pack=true, PackagePath=build)
                                + the closure of every Bundle reference
  -->
  <Target Name="_GetBundledClosure" DependsOnTargets="GetTargetPath" Returns="@(_BundledClosure)">
    <ItemGroup>
      <_BundledClosure Include="@(TargetPathWithTargetPlatformMoniker)" />
    </ItemGroup>
    <MSBuild Projects="@(ProjectReference->WithMetadataValue('Bundle', 'true'))"
             Targets="_GetBundledClosure"
             Properties="TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledClosure" />
    </MSBuild>
  </Target>

  <!-- Generators target netstandard2.0 (Roslyn requirement), so TargetFramework is passed
       explicitly regardless of the referencing project's TFM. Generators that bake their helper
       sources in (Kurrent.CodeAnalysis.Sources.props) return a single DLL; generators with
       project-reference deps must implement GetDependencyTargetPaths. -->
  <Target Name="_GetPackedAnalyzerClosure" Returns="@(_PackedAnalyzerClosure)">
    <MSBuild Projects="@(ProjectReference->WithMetadataValue('PackedAnalyzer', 'true'))"
             Targets="GetTargetPathWithTargetPlatformMoniker"
             Properties="TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="_PackedAnalyzerClosure" />
    </MSBuild>
    <MSBuild Projects="@(ProjectReference->WithMetadataValue('Bundle', 'true'))"
             Targets="_GetPackedAnalyzerClosure"
             Properties="TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_PackedAnalyzerClosure" />
    </MSBuild>
  </Target>

  <Target Name="_GetBundledBuildProps" Returns="@(_BundledBuildProps)">
    <ItemGroup>
      <_BundledBuildProps Include="@(None->WithMetadataValue('Pack', 'true')->WithMetadataValue('PackagePath', 'build'))"
                          Condition="'%(Extension)' == '.props'" />
    </ItemGroup>
    <MSBuild Projects="@(ProjectReference->WithMetadataValue('Bundle', 'true'))"
             Targets="_GetBundledBuildProps"
             Properties="TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledBuildProps" />
    </MSBuild>
  </Target>

  <!--
    Ship PackedAnalyzer references, own and bundled, into analyzers/dotnet/cs so they run in
    consumer compilations.
  -->
  <Target Name="_CollectPackedAnalyzers" DependsOnTargets="_GetPackedAnalyzerClosure">
    <RemoveDuplicates Inputs="@(_PackedAnalyzerClosure)">
      <Output TaskParameter="Filtered" ItemName="_PackedAnalyzerAssembly" />
    </RemoveDuplicates>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_PackedAnalyzerAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <!--
    A bundled project's build/*.props reaches consumers only under THIS package's id. NuGet imports
    build/{PackageId}.props and nothing else. So this target collects the file from the bundle closure
    and renames it on the way in. NuGet treats a PackagePath that ends in the file's own extension as a
    file name. That performs the rename. Two such files cannot both become build/{PackageId}.props, so
    that case is an error rather than a silent overwrite.
  -->
  <Target Name="_CollectBundledBuildProps">
    <MSBuild Projects="@(ProjectReference->WithMetadataValue('Bundle', 'true'))"
             Targets="_GetBundledBuildProps"
             Properties="TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledBuildPropsAll" />
    </MSBuild>
    <RemoveDuplicates Inputs="@(_BundledBuildPropsAll)">
      <Output TaskParameter="Filtered" ItemName="_BundledBuildProps" />
    </RemoveDuplicates>
    <Error Condition="@(_BundledBuildProps->Count()) &gt; 1"
           Text="More than one bundled project ships a build/*.props (@(_BundledBuildProps)); only one can become build/$(PackageId).props." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_BundledBuildProps)" PackagePath="build/$(PackageId).props" />
    </ItemGroup>
  </Target>

  <!--
    ProjectOrPackageReference: declare a dependency by name, resolved as
    ProjectReference (local dev) or PackageReference (CI / explicit opt-in).

    Usage in csproj:
      <ProjectOrPackageReference Include="Kurrent.Surge" />

    ProjectReference mode (default locally):
      dotnet build
      Path derived by convention: src/{Name}/{Name}.csproj

    PackageReference mode (automatic in CI, or manual):
      dotnet build -p:TestPackages=true
      Requires packages in .artifacts/packages/.
      Version comes from Directory.Packages.Versions.props via CPM.
  -->

  <ItemGroup Condition="'$(TestPackages)' != 'true'">
    <ProjectReference Include="@(ProjectOrPackageReference -> '$(RepoRoot)/src/%(Identity)/%(Identity).csproj')" />
  </ItemGroup>

  <ItemGroup Condition="'$(TestPackages)' == 'true'">
    <PackageReference Include="@(ProjectOrPackageReference)" />
  </ItemGroup>

  <!--
    Source-generator flow for in-repo consumers.

    Roslyn analyzers and source generators are NOT transitive through a ProjectReference (by
    design in the SDK), so a project that references an SDK package by SOURCE does not get the
    generators that package ships under analyzers/dotnet/cs — unlike a real NuGet consumer, where
    they flow automatically. To match that experience in-repo, wire the SAME packed analyzers
    (@(PackedAnalyzerProject), the single list in Directory.Build.props) as analyzers for any
    project that references the SDK by source.

    Detection filters @(ProjectReference) by filename via an item-to-item transform
    (WithMetadataValue in Include — the same idiom used above), NOT a property: MSBuild evaluates
    properties before items, so a property cannot read @() here. Skipped when TestPackages=true
    (the package supplies the generators). Generator projects and the SDK roots don't reference the
    SDK by source, so they never match and need no name-based exclusion.
  -->
  <ItemGroup Condition="'$(TestPackages)' != 'true'">
    <_SdkSourceRef Include="@(ProjectReference->WithMetadataValue('Filename', 'Kurrent.Surge'))" />
    <_SdkSourceRef Include="@(ProjectReference->WithMetadataValue('Filename', 'Kurrent.Surge.Core'))" />
  </ItemGroup>

  <ItemGroup Condition="'$(TestPackages)' != 'true' and '@(_SdkSourceRef)' != ''">
    <ProjectReference Include="@(PackedAnalyzerProject)"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
