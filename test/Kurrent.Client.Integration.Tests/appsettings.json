{
  "TestContainers": {
    "KurrentDB": {
      "Image": "docker.kurrent.io/kurrent-staging/kurrentdb:nightly",
      "Enabled": false
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Grpc.Net.Client.Internal": "Error",
        "EventStore.Client.SharingProvider": "Error"
      }
    },
    "Using": [
      "Serilog.Sinks.Seq"
    ],
    "WriteTo": [
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  }
}
