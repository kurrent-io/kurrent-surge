{
  "KurrentDB": {
    "Container": {
      "Registry": "docker.kurrent.io",
      "Image": "kurrent-staging/kurrentdb",
      "Tag": "nightly"
    }
  },
  
  "Serilog": {
    "MinimumLevel": {
