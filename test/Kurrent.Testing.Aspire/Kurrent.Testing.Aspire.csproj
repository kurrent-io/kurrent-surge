<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.1.2" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Required: Aspire embeds DCP/Dashboard paths as AssemblyMetadata attributes.
         test/Directory.Build.props sets GenerateAssemblyInfo=false; override it here. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.KurrentDB" />
  </ItemGroup>
</Project>
