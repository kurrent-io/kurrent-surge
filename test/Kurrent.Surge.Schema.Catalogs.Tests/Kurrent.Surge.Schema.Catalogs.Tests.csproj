<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Using Include="TUnit" />
    <Using Include="Kurrent.Testkit.TUnit.Assertions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generator under test, referenced as a plain library so the CSharpGeneratorDriver harness
         can instantiate it directly. NOT wired as an analyzer here — these tests drive it by hand. -->
    <ProjectReference Include="..\..\src\Kurrent.Surge.Schema.Catalogs.Generators\Kurrent.Surge.Schema.Catalogs.Generators.csproj" />
    <!-- The contracts-only samples project: runtime-visible generated catalogs, and it pulls in
         Kurrent.Surge.Schema.Catalogs transitively (referencing the package directly would trip the
         source-consumer analyzer flow and run the generator on this test assembly too). -->
    <ProjectReference Include="..\Kurrent.Surge.Schema.Catalogs.Tests.Samples\Kurrent.Surge.Schema.Catalogs.Tests.Samples.csproj" />
    <ProjectReference Include="..\Kurrent.Testkit\Kurrent.Testkit.csproj" />
  </ItemGroup>

</Project>
