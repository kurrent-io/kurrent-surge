<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Using Include="TUnit" />
    <Using Include="Kurrent.Testkit.TUnit.Assertions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- Snapshot testing: the full generated output is committed as .verified.cs and any change to it
         shows up as a reviewable diff, rather than as whichever substrings someone thought to assert. -->
    <PackageReference Include="Verify.TUnit" />
    <PackageReference Include="Verify.SourceGenerators" />
    <!-- The harness compiles generated output against this test process's TRUSTED_PLATFORM_ASSEMBLIES,
         and interop-On output references Avro types — so Avro.dll must be in this project's closure.
         The codec package no longer references it. -->
    <PackageReference Include="Apache.Avro" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generator under test, referenced as a plain library so the CSharpGeneratorDriver harness
         can instantiate it directly. NOT wired as an analyzer here — these tests drive it by hand. -->
    <ProjectReference Include="..\..\src\Kurrent.Surge.Generators\Kurrent.Surge.Generators.csproj" />
    <!-- UniqueIdentifierAttribute and IUniqueIdentifier live here — needed for the hand-built
         compilations to bind, and for MetadataReference.CreateFromFile(typeof(...).Assembly.Location). -->
    <ProjectReference Include="..\..\src\Kurrent.Surge.Core\Kurrent.Surge.Core.csproj" />
    <ProjectReference Include="..\Kurrent.Testkit\Kurrent.Testkit.csproj" />
  </ItemGroup>

</Project>
