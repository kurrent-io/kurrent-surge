<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Acceptance sample for `generates_catalog_in_the_contracts_only_samples_assembly`. A
         dependency-light contracts assembly modelling a real smart-home domain that references ONLY
         Kurrent.Surge.Core (no Kurrent.Surge) — exactly what a consumer's domain project looks like.
         It must still get the catalog generator (via the source-consumer analyzer flow), and the
         emitted Use*Catalog() extensions must bind to KurrentClientMessageOptions in Core. So: this
         project compiling IS the acceptance assertion. -->
    <IsPackable>false</IsPackable>
    <!-- Not a test assembly. test/Directory.Build.props defaults IsTestProject=true here; override so
         the MTP test run doesn't try to execute a project with no test framework. -->
    <IsTestProject>false</IsTestProject>
    <AssemblyName>Kurrent.Surge.Schema.Catalogs.Generators.Tests.Samples</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kurrent.Surge.Core\Kurrent.Surge.Core.csproj" />
  </ItemGroup>

</Project>
