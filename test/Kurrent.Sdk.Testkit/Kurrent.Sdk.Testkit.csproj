<Project Sdk="Aspire.AppHost.Sdk/13.4.0">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <!-- Source DCP/Dashboard binaries from the installed Aspire CLI bundle instead of RID-specific
         NuGet packages. Aspire 13.4's SDK resolves those packages via an in-proc PickBestRid task that
         fails to bind in our restore context (MSB4036); the CLI-bundle path skips that target entirely.
         Requires the `aspire` CLI on PATH at build time (else ASPIRE009). See AspireUseCliBundle in
         https://aspire.dev/get-started/aspire-sdk/. -->
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE002</NoWarn>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <UserSecretsId>6969a99a-7018-4a4d-a7a4-b25277053c4e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="TUnit" />
    <Using Include="TUnit.Core" />
    <Using Include="Aspire.Hosting" />
    <Using Include="Aspire.Hosting.ApplicationModel" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kurrent.Client\Kurrent.Client.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Kurrent.Client.MessageCatalogs.Generators\Kurrent.Client.MessageCatalogs.Generators.csproj" Analyzer="true" />
    <ProjectReference Include="..\Kurrent.Testkit\Kurrent.Testkit.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\Aspire.Hosting.KurrentDB\Aspire.Hosting.KurrentDB.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Declare Aspire.Hosting.AppHost explicitly (versionless) so the Aspire.AppHost.Sdk skips its
         implicit, version-pinned injection. Under CPM that implicit ref + the central PackageVersion
         collide as NU1009; an explicit versionless ref takes the version from Directory.Packages.props. -->
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Testing" />
  </ItemGroup>
</Project>
