<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Under test/ but not a test assembly: the harness would try to enumerate tests and fail. -->
    <IsTestProject>false</IsTestProject>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kurrent.Surge.Codecs.Avro\Kurrent.Surge.Codecs.Avro.csproj" />
    <!-- Analyzers are not transitive through a ProjectReference, so the codec generator is wired
         explicitly; a NuGet consumer receives it from analyzers/dotnet/cs. -->
    <ProjectReference Include="..\..\src\Kurrent.Surge.Codecs.Avro.Generators\Kurrent.Surge.Codecs.Avro.Generators.csproj" Analyzer="true" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Schemas/*.avsc" />
    <!-- Also copied out, because AvroJsonWriter is driven by schema text at run time rather than by a
         generated type, and the probe has to hand it the real schema rather than a literal that can drift. -->
    <None Include="Schemas/*.avsc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
