{
  "type": "record",
  "name": "ExportCoverage",
  "namespace": "kurrent.surge.codecs.avro.tests.corpus",
  "doc": "Carries the constructs whose Avro facts a standard JSON Schema keyword can express: the exact size of a fixed, a bytes default, an enum default, and a logical type that exports as its base type.",
  "fields": [
    { "name": "checksum", "type": { "type": "fixed", "name": "Checksum", "size": 17 }, "default": "ÿþABCDEFGHIJKLMNO" },
    { "name": "status", "type": { "type": "enum", "name": "Status", "symbols": ["Unknown", "Active", "Sealed"], "default": "Unknown" } },
    { "name": "observedAt", "type": { "type": "long", "logicalType": "timestamp-micros" } },
    { "name": "recordedAt", "type": { "type": "long", "logicalType": "local-timestamp-micros" } },
    { "name": "sighting", "default": null, "type": [
        "null",
        { "type": "record", "name": "Cat", "fields": [ { "name": "lives", "type": "int" } ] },
        { "type": "record", "name": "Dog", "fields": [ { "name": "bark", "type": "string" } ] }
      ] }
  ]
}
