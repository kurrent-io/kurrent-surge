<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\src\Kurrent.Surge.Codecs.Avro\Kurrent.Surge.Codecs.Avro.csproj" />
    <!-- Analyzers are not transitive through a ProjectReference, so referencing the codec by source
         does not bring its packed generator the way a NuGet consumer would get it from
         analyzers/dotnet/cs. Wire it explicitly so these tests exercise the generated codec. -->
    <ProjectReference Include="..\..\src\Kurrent.Surge.Codecs.Avro.Generators\Kurrent.Surge.Codecs.Avro.Generators.csproj" Analyzer="true" />
    <ProjectReference Include="..\Kurrent.Testkit\Kurrent.Testkit.csproj" />
    <!-- The schema registry validates with NJsonSchema through this project, so gate 3 asserts against the
         validator that actually runs rather than against a second implementation that might disagree. -->
    <ProjectReference Include="..\..\src\Kurrent.Surge.Schema.Validation\Kurrent.Surge.Schema.Validation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit" />
    <Using Include="Bogus" />
    <Using Include="Avro" />
    <Using Include="Avro.Specific" />
    <Using Include="Kurrent.Surge.Client.Streams" />
    <Using Include="Kurrent.Surge.Schema" />
    <Using Include="Kurrent.Surge.Schema.Catalogs" />
    <Using Include="Kurrent.Testkit" />
    <Using Include="Kurrent.Testkit.TUnit" />
    <Using Include="Kurrent.Testkit.TUnit.Assertions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <!-- .avsc is the only input format the generator reads today; see Kurrent.Surge.Codecs.Avro/README.md. -->
    <AdditionalFiles Include="Schemas/*.avsc" />
    <!-- AvroJsonWriter takes schema JSON, and the .avsc is the only source of a specification-valid one:
         Apache's LogicalSchema.ToString() nests the base under 'type' when that base is a named type,
         which nothing outside Apache.Avro for C# can parse. See AvroJsonWriterTests. -->
    <None Update="Schemas/*.avsc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The AvroJsonSchema round trip runs over every .avsc in the repository, so the schemas the other
         two projects own are copied in beside this project's own. Copied, not added as AdditionalFiles:
         the generator would otherwise emit a second message type for a schema another project declares,
         and ComplexOrder.avsc exists in both. Sub-folders are preserved for the same reason. -->
    <None Include="..\Kurrent.Surge.Codecs.Avro.AotProbe\Schemas\*.avsc" Link="Corpus\AotProbe\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\perf\Kurrent.Surge.Benchmarks\Schemas\*.avsc" Link="Corpus\Benchmarks\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Corpus\*.avsc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Opts into the richer timestamp-nanos type so its conversion across ISpecificRecord is covered by a
       real round trip, and exercises the MSBuild-property path into the generator end to end. The Long
       default is asserted at the generator level instead. A ProjectReference does not import the
       package's build/*.props the way a NuGet consumer would, so the property is declared visible here. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="KurrentAvroNanosecondTimestamps" />
    <CompilerVisibleProperty Include="KurrentAvroApacheInterop" />
  </ItemGroup>

  <PropertyGroup>
    <KurrentAvroNanosecondTimestamps>NanoInstant</KurrentAvroNanosecondTimestamps>
    <!-- Apache is the parity oracle here, so generated types must carry the surface its writers need. -->
    <KurrentAvroApacheInterop>On</KurrentAvroApacheInterop>
  </PropertyGroup>
</Project>
