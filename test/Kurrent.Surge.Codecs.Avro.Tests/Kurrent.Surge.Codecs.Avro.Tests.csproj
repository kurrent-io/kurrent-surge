<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\src\Kurrent.Surge.Codecs.Avro\Kurrent.Surge.Codecs.Avro.csproj" />
    <!-- Analyzers are not transitive through a ProjectReference, so referencing the codec by source
         does not bring its packed generator the way a NuGet consumer would get it from
         analyzers/dotnet/cs. Wire it explicitly so these tests exercise the generated codec. -->
    <ProjectReference Include="..\..\src\Kurrent.Surge.Codecs.Avro.Generators\Kurrent.Surge.Codecs.Avro.Generators.csproj" Analyzer="true" />
    <ProjectReference Include="..\Kurrent.Testkit\Kurrent.Testkit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit" />
    <Using Include="Bogus" />
    <Using Include="Avro" />
    <Using Include="Avro.Specific" />
    <Using Include="Kurrent.Surge.Client.Streams" />
    <Using Include="Kurrent.Surge.Schema" />
    <Using Include="Kurrent.Surge.Schema.Catalogs" />
    <Using Include="Kurrent.Testkit" />
    <Using Include="Kurrent.Testkit.TUnit" />
    <Using Include="Kurrent.Testkit.TUnit.Assertions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <!-- .avsc is the only input format the generator reads today; see Kurrent.Surge.Codecs.Avro/README.md. -->
    <AdditionalFiles Include="Schemas/*.avsc" />
  </ItemGroup>
</Project>
