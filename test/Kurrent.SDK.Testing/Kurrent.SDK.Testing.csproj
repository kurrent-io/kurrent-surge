<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.1.2" />

  <PropertyGroup>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <IsAspireHost>false</IsAspireHost>
    <NoWarn>$(NoWarn);ASPIRE002</NoWarn>
    <!--
      OS dependent packages update package.lock.json #6184
      https://github.com/dotnet/aspire/issues/6184

      Aspire SDK pulls platform-specific packages (e.g. Aspire.Dashboard.Sdk.linux-x64 vs osx-x64),
      making the lock file non-portable across dev machines and CI.
    -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="TUnit" />
    <Using Include="TUnit.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kurrent.Testing\Kurrent.Testing.csproj" />
    <ProjectReference Include="..\Kurrent.Testing.Datasets\Kurrent.Testing.Datasets.csproj" />
    <ProjectReference Include="..\..\src\Kurrent.Client\Kurrent.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="TUnit" />
  </ItemGroup>
</Project>
