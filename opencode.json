{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-sonnet-4-5",
  "share": "disabled",
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 100000
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "microsoft-docs": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp"
    }
  },
  "lsp": {
    "csharp": {
      "disabled": false
    },
    "pyright": {
      "disabled": false
    }
  },
  "command": {
    "setup-remote": {
      "description": "Run remote setup script",
      "template": "Run python3 \"$PWD\"/scripts/setup-remote.py and summarize the result."
    },
    "plan-doc": {
      "description": "Create dated plan document",
      "template": "Create an implementation plan document in `.project/docs/plans` named `YYYY-MM-DD-<feature-name>.md` for: $ARGUMENTS"
    }
  }
}
