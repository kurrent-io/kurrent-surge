---
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/types';
/**
 * The six capabilities, as one ruled block.
 *
 * A lattice rather than cards: shared 1px borders at zero gap and zero radius,
 * so the group reads as one table. `grid-auto-rows: 1fr` keeps every rectangle
 * identical regardless of what it holds.
 */

type Card = {
  num: string;
  label: string;
  title: string;
  body: string;
  ok: string;
  icon: StarlightIcon;
  link: { href: string; text: string };
  marks?: boolean;
  expr?: boolean;
};

const cards: Card[] = [
  {
    num: '01',
    label: 'Hosted runtime',
    title: 'Processing, already wired',
    body: 'Write the handler. The runtime owns the subscription, the checkpoints and the shutdown — and gives them back on request.',
    ok: 'Nothing to wire. Nothing to remember.',
    icon: 'download',
    link: { href: '/kurrent-surge/processors/', text: 'Read the guide' },
  },
  {
    num: '02',
    label: 'Messages',
    title: 'Serialization you never see',
    body: 'Many kinds of message on one stream, each in its own format. Every record carries the schema that decodes it back into a CLR type.',
    ok: 'JSON, Protobuf and Avro. Same stream.',
    icon: 'comment',
    link: { href: '/kurrent-surge/schema/', text: 'See the schema layer' },
    marks: true,
  },
  {
    num: '03',
    label: 'Atomic writes',
    title: 'One append, many streams',
    body: 'Several streams, one transaction, a revision guard on each. Every one lands, or none does.',
    ok: 'No saga. No outbox.',
    icon: 'random',
    link: { href: '/kurrent-surge/streams/', text: 'Browse the streams API' },
  },
  {
    num: '04',
    label: 'Connection',
    title: 'Resilience in the core',
    body: 'Retry on every method, and a real gRPC load balancer that ranks nodes from gossip and follows the leader election underneath it.',
    ok: 'Your code never finds out.',
    icon: 'rss',
    link: { href: '/kurrent-surge/client/clusters-and-discovery/', text: 'See how it routes' },
  },
  {
    num: '05',
    label: 'Record filters',
    title: 'A WHERE clause, not a prefix',
    body: 'Filter by stream, category, schema, an index, or a field inside the message. Bound parameters, one expression.',
    ok: 'One predicate. Both halves.',
    icon: 'magnifier',
    link: { href: '/kurrent-surge/streams/filters/', text: 'See the filter syntax' },
    expr: true,
  },
  {
    num: '06',
    label: 'Management',
    title: 'Connectors, indexes and nodes, from code',
    body: 'Start a connector. Build a secondary index. Register a schema. Scavenge a node. All from the client you already opened.',
    ok: 'No console. No scripts. No curl.',
    icon: 'server',
    link: { href: '/kurrent-surge/client/connectors/', text: 'See what it manages' },
  },
];
---

<section class="caps not-content">
  <div class="wrap">
    <p class="eyebrow">What you get</p>
    <h2>Six capabilities, <b>one package</b>.</h2>

    <ul class="setup">
      <li>
        <Icon name="approve-check-circle" />
        <span>KurrentDB stores an ordered log, not a set of queues.</span>
      </li>
      <li>
        <Icon name="approve-check-circle" />
        <span>Most clients hand you bytes and a callback.</span>
      </li>
      <li>
        <Icon name="approve-check-circle" />
        <span>Surge hands you your own messages, and runs the loop around them.</span>
      </li>
    </ul>

    <div class="block">
      <div class="lattice">
        {cards.map((c) => (
          <div class="cell">
            <div class="cell__top">
              <span class="num">{c.num}</span>
              <Icon name={c.icon} />
            </div>
            <p class="label">{c.label}</p>
            <h3>{c.title}</h3>
            <p class="body">{c.body}</p>

            {c.marks && (
              <div class="marks">
                <svg viewBox="0 0 32 32" aria-label="JSON"><path fill="#f5de19" d="M4.014 14.976a2.5 2.5 0 0 0 1.567-.518a2.38 2.38 0 0 0 .805-1.358a15.3 15.3 0 0 0 .214-2.944q.012-2.085.075-2.747a5.2 5.2 0 0 1 .418-1.686a3 3 0 0 1 .755-1.018A3.05 3.05 0 0 1 9 4.125A6.8 6.8 0 0 1 10.544 4h.7v1.96h-.387a2.34 2.34 0 0 0-1.723.468a3.4 3.4 0 0 0-.425 2.092a36 36 0 0 1-.137 4.133a4.7 4.7 0 0 1-.768 2.06A4.6 4.6 0 0 1 6.1 16a3.8 3.8 0 0 1 1.992 1.754a8.9 8.9 0 0 1 .618 3.865q0 2.435.05 2.9a1.76 1.76 0 0 0 .504 1.181a2.64 2.64 0 0 0 1.592.337h.387V28h-.7a5.7 5.7 0 0 1-1.773-.2a2.97 2.97 0 0 1-1.324-.93a3.35 3.35 0 0 1-.681-1.63a24 24 0 0 1-.165-3.234a16.5 16.5 0 0 0-.214-3.106a2.4 2.4 0 0 0-.805-1.361a2.5 2.5 0 0 0-1.567-.524Zm23.972 2.035a2.5 2.5 0 0 0-1.567.524a2.4 2.4 0 0 0-.805 1.361a16.5 16.5 0 0 0-.212 3.109a24 24 0 0 1-.169 3.234a3.35 3.35 0 0 1-.681 1.63a2.97 2.97 0 0 1-1.324.93a5.7 5.7 0 0 1-1.773.2h-.7V26.04h.387a2.64 2.64 0 0 0 1.592-.337a1.76 1.76 0 0 0 .506-1.186q.05-.462.05-2.9a8.9 8.9 0 0 1 .618-3.865A3.8 3.8 0 0 1 25.9 16a4.6 4.6 0 0 1-1.7-1.286a4.7 4.7 0 0 1-.768-2.06a36 36 0 0 1-.137-4.133a3.4 3.4 0 0 0-.425-2.092a2.34 2.34 0 0 0-1.723-.468h-.387V4h.7a6.8 6.8 0 0 1 1.54.125a3.05 3.05 0 0 1 1.149.581a3 3 0 0 1 .755 1.018a5.2 5.2 0 0 1 .418 1.686q.062.662.075 2.747a15.3 15.3 0 0 0 .212 2.947a2.38 2.38 0 0 0 .805 1.355a2.5 2.5 0 0 0 1.567.518Z"/></svg>
                <svg viewBox="0 0 32 32" aria-label="Protobuf"><path fill="#d44235" d="m5.218 11.768l2.429-3.312h6.623l-5.74 7.728H5.218z"/><path fill="#f7bb07" d="M23.175 15.816h3.46v4.49l-2.503 3.237h-6.476z"/><path fill="#4081ec" d="M2.348 16.037c0-.399.007-.402 2.87-4.269l9.052 11.775H7.794c-5.443-7.047-5.446-7.056-5.446-7.506"/><path fill="#0f9855" d="M17.656 8.456h6.402c5.358 7 5.59 7.26 5.594 7.58c.003.322-.047.469-3.018 4.27z"/></svg>
                <svg viewBox="0 0 24 24" aria-label="Avro"><path fill="#30638e" d="M11.704 3.324s-.464.428.024.982c.363.412.904.16.904.16s.5-.274.12-.85c-.492-.75-1.048-.292-1.048-.292M23.927 22L5.456 13.966S-.58 10.32.046 8.88c.608-1.393 5.988 1.415 6.557 1.544c.569.13.886-.221.896-.466c.017-.354-.799-1.366-.376-1.798c.422-.431 1.8.408 1.8.408l1.12.757L23.926 22Zm.073-.076L11.81 8.74S9.615 6.306 9.706 5.61c.091-.698 3.007 1.527 3.007 1.527s.324.305.632.252c.307-.05-.022-.55-.022-.55s-.504-1.142-.167-1.347c.338-.203 1.191.657 1.191.657s.213.215.437.157c.224-.06.104-.539.104-.539s-1.542-3.471-.87-3.73c1.026-.396 2.487 2.476 2.977 3.37C17.118 5.654 24 21.924 24 21.924M4.978 5.611s-.626.404.07 1.181c.639.716 1.208.345 1.208.345s.59-.352.024-1.017c-.748-.877-1.302-.51-1.302-.51Zm16.31 15.604l-13.87-3.867l-.885-2.551z"/></svg>
              </div>
            )}

            {c.expr && (
              <div class="expr">category = <span class="s">'player'</span> AND data.fee &gt; 40000000</div>
            )}

            <p class="ok">{c.ok}</p>
            <a class="link" href={c.link.href}>{c.link.text} &rarr;</a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* The reading column for this page. Declared per component because Astro
     scopes styles, and home.css only loads on the old standalone index. */
  .wrap {
    max-width: 82rem;
    margin-inline: auto;
    padding-inline: 2rem;
  }

  .caps {
    border-top: 1px solid var(--border);
    padding: 64px 0;
  }

  /* home.css's `.sect__lbl`, matched property for property. `.wrap` is carried
     for specificity: this is a <p>, and surge.css's `.sl-markdown-content
     :is(p, li)` is (0,1,1), which takes the weight off a lone class. */
  .wrap .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-family: var(--font-eyebrow);
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  .wrap .eyebrow::before { content: ""; width: 28px; height: 1px; flex: 0 0 auto; background: var(--accent); }

  /* `.caps .wrap` is carried for specificity alone — see the note on the h3
     below; surge.css styles `.content-panel h2` at (0,1,1). */
  .caps .wrap h2 {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(28px, 3.6vw, 42px);
    line-height: 1.05;
    letter-spacing: -0.018em;
    color: var(--fg);
    margin: 14px 0 0;
    text-wrap: balance;
  }
  .caps .wrap h2 b { font-weight: 300; color: var(--accent); }

  /* Context, gap, answer — the setup the grid then answers six times. */
  .setup { list-style: none; margin: 20px 0 0; padding: 0; display: grid; gap: 9px; }
  /* Same mark as the hero's properties list — one tick, drawn once. */
  .setup li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 11px;
    align-items: baseline;
    font-size: 18px;
    color: var(--fg-1);
  }
  .setup :global(svg) { width: 16px; height: 16px; color: var(--outcome); margin-top: 0.18em; }

  .block { border: 1px solid var(--border); margin-top: 34px; }

  /* One-pixel gaps over a border-coloured ground draw every rule, so no cell
     needs nth-child arithmetic that breaks when a cell is added. */
  .lattice {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 1px;
    background: var(--border);
  }
  @media (max-width: 51rem) { .lattice { grid-template-columns: 1fr; } }

  .cell {
    background: var(--bg);
    padding: 28px 30px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: background-color 180ms ease;
  }
  /* The wash stays on the accent — it is the surface, not the interaction. The
     three marks that answer the pointer move to --lit. */
  .cell:hover { background: color-mix(in oklab, var(--accent) 5%, var(--bg)); }
  .cell:hover .num { border-color: color-mix(in oklab, var(--lit) 55%, transparent); color: var(--lit); }
  .cell:hover .cell__top :global(svg) { color: var(--lit); }
  /* The title keeps its own colour on hover. Recolouring the largest type on
     the card put the accent on five elements at once, and DESIGN.md's One
     Family Rule has no second hue to spend on it — things are told apart by
     weight, size and position instead. The hover now moves one accent, onto
     the link, which is the thing the pointer is heading for. */
  .lattice .cell:hover .link { color: var(--lit); }

  /* align-self:stretch — the cell is a flex column with align-items:flex-start,
     which would otherwise shrink this row and strand the icon beside the number. */
  .cell__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    align-self: stretch;
    margin-bottom: 18px;
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 30px;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--fg-dim);
    font-variant-numeric: tabular-nums;
    transition: color 180ms ease, border-color 180ms ease;
  }
  .cell__top :global(svg) { width: 19px; height: 19px; color: var(--fg-fade); transition: color 180ms ease; }

  .label {
    font-family: var(--font-mono);
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 7px;
  }
  /* `.lattice .cell` is carried for specificity alone. surge.css styles
     `.sl-markdown-content h3` at (0,1,1) with its own margins, weight and
     line-height, and Astro compiles a component's scope hash as `:where()`,
     which counts for nothing — a bare `h3` here is (0,0,1) and loses all four
     properties to it. */
  .lattice .cell h3 {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 26px;
    line-height: 1.22;
    letter-spacing: -0.015em;
    color: var(--fg);
    margin: 0;
    text-wrap: balance;
  }
  .body { margin: 11px 0 0; font-size: 16px; line-height: 1.55; color: var(--fg-1); max-width: 56ch; }

  .marks { display: flex; align-items: center; gap: 26px; margin-top: 18px; }
  .marks svg { width: 46px; height: 46px; display: block; }

  .expr {
    margin-top: 16px;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 13px 15px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--code-fg);
    overflow-x: auto;
  }
  .expr .s { color: #d3a3f0; }

  .ok {
    position: relative;
    padding-left: 16px;
    margin: 18px 0 0;
    font-family: var(--font-mono);
    font-size: 15px;
    line-height: 1.5;
    color: var(--outcome);
  }
  .ok::before { content: "\2022"; position: absolute; left: 0; top: 0; }

  /* home.css's `.cell__link`, copied — the same device on both landing pages.
     The vertical padding is the hit area, not the look: at 12px mono the text box
     is 21px tall, under the 24px WCAG 2.2 target-size floor. The margin drops by
     the same 7px the padding adds, so the text sits where it did before. */
  .lattice .cell .link {
    margin-top: 13px;
    padding-block: 7px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--fg-dim);
    text-decoration: none;
    border-bottom: 1px dotted transparent;
    transition: color 160ms ease, border-color 160ms ease;
  }
  /* Mix, Never Match — the underline is a mix of --lit, not a literal. */
  .lattice .cell .link:hover {
    color: var(--lit);
    border-bottom-color: color-mix(in oklab, var(--lit) 45%, transparent);
  }
  .lattice .cell .link:focus-visible { outline: 2px solid var(--lit); outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
