---
// Splits the configured site title so the last word carries the accent.
// Starlight's own SiteTitle renders the title as one escaped string, and the
// `title` config option takes no markup, so a component override is the only
// supported way to colour part of it.
import logo from '../assets/logo.svg';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;

const split = siteTitle.lastIndexOf(' ');
const lead = split === -1 ? '' : siteTitle.slice(0, split + 1);
const tail = split === -1 ? siteTitle : siteTitle.slice(split + 1);
---

<a href={siteTitleHref} class="site-title sl-flex">
  {/* Decorative: the site title renders beside the mark, so an alt description
      would announce the same name twice. */}
  <img src={logo.src} width={logo.width} height={logo.height} alt="" />
  <span translate="no">{lead}<span class="site-title__accent">{tail}</span></span>
</a>

<style>
  /* Mirrors Starlight's own .site-title rule, which lives in
     `@layer starlight.core` and is replaced wholesale by this override.
     The size is the one deliberate departure: one step up its scale, h4 to h3. */
  .site-title {
    align-items: center;
    gap: var(--sl-nav-gap);
    font-size: var(--sl-text-h3);
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  .site-title:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  span {
    overflow: hidden;
  }
  /* Also from Starlight's own rule. Its copy lives in the component this file
     replaces, so without it the logo renders at its intrinsic 512px. */
  img {
    height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: 0 50%;
  }
  .site-title__accent {
    color: var(--accent);
  }
</style>
