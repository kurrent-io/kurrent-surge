---
// The landing page stands outside the Starlight collection, so it imports the
// stylesheets itself rather than receiving them from customCss. Typefaces come
// from the <Font /> components in the head below, matching Head.astro.
import { Font } from "astro:assets";
import { Code } from "@astrojs/starlight/components";
import MotionField from "../components/MotionField.astro";
import "../styles/surge.css";
import "../styles/home.css";

// Astro never rewrites authored hrefs for `base`; prefix them here, the way
// Starlight's own pathWithBase does.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path: string) => `${base}${path}`;

// This page renders its own head, so none of Starlight's generated metadata
// reaches it. Social crawlers need absolute URLs, which `Astro.site` supplies.
const pageUrl = new URL(`${base}/`, Astro.site).href;
const ogImage = new URL(withBase("/og-card.png"), Astro.site).href;
const description =
  "Kurrent Surge is the .NET SDK for KurrentDB and the Kurrent Platform. Append and read streams, register schemas, manage connectors, and hand a handler to a runtime that owns the subscription, the checkpoints and the shutdown.";

const DOCS_HREF = "/getting-started/";
const PROCESSORS_HREF = "/processors/";

const processorSample = `using Kurrent.Surge;
using Kurrent.Surge.Client.Streams;
using Kurrent.Surge.Processors;

public class TransferWatch : MessageProcessor {
    public TransferWatch() {
        Process<PlayerTransferred>((transfer, ctx) =>
            ctx.Logger.LogInformation("{Player} joined {Club} for {Fee:C}",
                transfer.PlayerName, transfer.ToClub, transfer.Fee));

        Process<PlayerRegistered>((player, ctx) =>
            ctx.Logger.LogInformation("{Player} registered at {Club}",
                player.Name, player.Club));
    }
}

var builder = WebApplication.CreateBuilder(args);

builder.Services.AddKurrentSurge(surge => {
    surge.Connection("kurrentdb://localhost:2113");

    surge.AddProcessor<TransferWatch>("transfer-watch", prx =>
        prx.Subscription.Filter = RecordFilter.ByCategory("player"));
});

await builder.Build().RunAsync();`;

// Every value here is the shipped default, not an illustration.
const defaults = [
  { k: "Batch size", v: "500 records" },
  { k: "Batch window", v: "100 ms" },
  { k: "Read-ahead", v: "×2" },
  { k: "Checkpoint interval", v: "30 s" },
  { k: "Reconnect backoff", v: "500 ms → 30 s" },
];

const guarantees = [
  {
    title: "A failed record is never checkpointed past.",
    body: "Restart resumes at or before it, so the work is retried rather than skipped. That is the guarantee the rest of the runtime is built to keep.",
  },
  {
    title: "Shutdown drains.",
    body: "SIGINT and SIGTERM finish the batch in flight and commit its position before the process exits. A container stop drains rather than kills.",
  },
  {
    title: "Reconnection does not give up.",
    body: "Exponential backoff between 500 ms and 30 seconds, unlimited by default. A long-lived worker should outlive a transient transport fault, not be ended by one.",
  },
  {
    title: "Delivery is at-least-once.",
    body: "Written down plainly, as a property of the system rather than a setting you failed to find. Nothing on this page pretends otherwise.",
  },
  {
    title: "Twelve metrics, no wiring.",
    body: "Emitted through System.Diagnostics.Metrics, so OpenTelemetry, Prometheus and dotnet-counters read them as they are. Lag, batch duration, checkpoint failures and uncommitted work included.",
  },
  {
    title: "No dead-letter queue, by decision.",
    body: "An ordered log does not have the problem a dead-letter queue solves. A stopped processor is recoverable and a skipped record is not, so stopping is the default.",
  },
];

const modules = [
  {
    num: "01",
    label: "STREAMS",
    title: "Append, read,\nand say what you expected.",
    body: "Optimistic concurrency on every append. Read forwards or backwards, filter by category or schema, and manage streams and their metadata from the same module.",
    link: { href: "/streams/", text: "Browse the streams API" },
  },
  {
    num: "02",
    label: "SCHEMA & REGISTRY",
    title: "Declare once.\nEvolve safely.",
    body: "A catalog maps a CLR type to a schema name. JSON, Protobuf and Avro are all built in, chosen per record and read back from the record itself. Register a breaking rename and the registry refuses it.",
    link: { href: "/schema/", text: "See the schema layer" },
  },
  {
    num: "03",
    label: "PROCESSORS",
    title: "Write a handler.\nThe runtime runs it.",
    body: "No subscription loop, no checkpoint bookkeeping, no reconnect policy to hand-roll. Implement the handler and the runtime owns everything around it.",
    link: { href: PROCESSORS_HREF, text: "Read the guide" },
  },
  {
    num: "04",
    label: "CONNECTORS",
    title: "KurrentDB runs them.\nYou manage them here.",
    body: "Connectors are server-side pipelines. Kurrent Surge creates, configures, starts and inspects them from your own code or your appsettings.json — Kafka, MongoDB, Elasticsearch, RabbitMQ, Pulsar, SQL, HTTP and Serilog among the sinks.",
    link: { href: "/client/connectors/", text: "See what it manages" },
  },
  {
    num: "05",
    label: "ROUTING",
    title: "Leader changes stay\ninside the channel.",
    body: "A gRPC load balancing policy of our own, not a wrapper around one address. Gossip discovery, nodes ranked by preference, and an election followed without a reconnect you write.",
    link: { href: "/client/clusters-and-discovery/", text: "See how it routes" },
  },
  {
    num: "06",
    label: "ADMIN & INDEXES",
    title: "Operate the node.\nQuery by payload.",
    body: "Node administration and scavenging sit on the same client. Secondary indexes let a read find records by a field in the payload instead of by stream name.",
    link: { href: "/client/admin/", text: "Open the admin module" },
  },
];

// Drawn from the 18 runnable projects under examples/, not written for the page.
const examples = [
  { name: "Fraud detection", body: "A time-windowed, multi-step pattern match across a sequence of transactions." },
  { name: "Clickstream sessions", body: "Gap-based session windows with a configurable timeout, and entry and exit page analysis." },
  { name: "Order enrichment", body: "A stream-table join against lookup tables built from reference streams, with missing data handled." },
  { name: "IoT monitoring", body: "Rolling-window statistics and standard-deviation anomaly detection, per sensor." },
  { name: "Leaderboard", body: "Redis sorted sets as external state, with a REST query API over the processed result." },
  { name: "Processor with Postgres", body: "Aggregates held in memory and flushed to PostgreSQL on the checkpoint barrier." },
];

const waysIn = [
  { href: "/migration/from-eventstoredb/", text: "From EventStoreDB" },
  { href: "/migration/from-kurrentdb-v1/", text: "From KurrentDB v1" },
  { href: "/migration/breaking-changes/", text: "Breaking changes" },
];

---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Kurrent Surge, the .NET SDK for KurrentDB and the Kurrent Platform</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={pageUrl} />
  <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
  {/* This page renders its own head, so Starlight's `head` config never reaches
      it. The ICO carries Safari below version 26, which shows no icon at all
      for an SVG-only declaration. */}
  <link rel="icon" href={withBase("/favicon.ico")} sizes="48x48" />
  <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} sizes="180x180" />
  <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
  {/* Same reason: none of Starlight's og/twitter tags reach this page, and it
      is the one most likely to be shared. */}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Kurrent Surge" />
  <meta property="og:locale" content="en" />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:title" content="Kurrent Surge, the .NET SDK for KurrentDB and the Kurrent Platform" />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Kurrent Surge — the .NET SDK for KurrentDB" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <Font
    cssVariable="--font-poppins"
    preload={[
      { subset: "latin", style: "normal", weight: "400" },
      { subset: "latin", style: "normal", weight: "600" },
    ]}
  />
  <Font cssVariable="--font-fira-code" />
  <script is:inline>document.documentElement.dataset.theme = "dark";</script>
</head>
<body>

<!-- Fixed to the viewport, so it sits behind every section rather than inside
     the hero. Its reach is graded by the host, not by this markup. -->
<MotionField />

<section class="hero">
  <div class="wrap">
    <h1 class="hero__h1 hero__h1--name">Kurrent <span class="accent">Surge</span></h1>

    <div class="hero__grid">
      <div>
        <p class="hero__lede">
          You write the handler.<br />The runtime owns the loop.
        </p>

        <p class="hero__sub">
          The .NET SDK for KurrentDB and the Kurrent Platform. Append and read streams, register
          schemas, manage connectors, and <b>process what arrives</b> — one client, one connection.
        </p>

        <div class="hero__cta">
          <a class="btn-primary" href={withBase(DOCS_HREF)}>Get started &rarr;</a>
          <a class="btn-secondary" href={withBase(PROCESSORS_HREF)}>See processors</a>
        </div>
      </div>

      <div>
        <p class="eyebrow" style="margin: 0 0 14px;">INSTALL</p>
        <pre class="mono hero__install-code"><code>dotnet add package Kurrent.Surge</code></pre>

        <p class="eyebrow" style="margin: 0 0 14px;">WHAT A PROCESSOR DOES BY DEFAULT</p>
        <div class="hero__panel">
          {defaults.map((d) => (
            <div class="spec__row">
              <span class="spec__k">{d.k}</span>
              <span class="spec__v">{d.v}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="sect">
  <div class="wrap">
    <p class="sect__lbl">A COMPLETE STREAM PROCESSOR</p>
    <h2 class="sect__h">This is the entire program.</h2>

    <div style="margin-top: 24px;">
      <Code code={processorSample} lang="csharp" />
    </div>

    <p style="margin-top: 24px; color: var(--fg-dim); max-width: 68ch;">
      There is no subscription loop here because you do not write one. The processor registers as a
      hosted service, reads in batches, commits its own position, reconnects on a transport fault,
      and drains what it is holding when the container stops.
    </p>
  </div>
</section>

<section class="sect">
  <div class="wrap">
    <p class="sect__lbl">WHAT THE RUNTIME GUARANTEES</p>
    <h2 class="sect__h">The loop, written correctly.</h2>

    <div class="lattice lattice--2">
      {guarantees.map((g) => (
        <div class="cell">
          <h3 class="cell__h">{g.title}</h3>
          <p class="cell__body" style="margin-bottom: 0;">{g.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="sect">
  <div class="wrap">
    <p class="sect__lbl">ONE CLIENT, FIVE MODULES</p>
    <h2 class="sect__h">One connection. Everything on it.</h2>

    <div class="lattice lattice--2">
      {modules.map((m) => (
        <div class="cell">
          <p class="cell__eyebrow">
            <span class="cell__num">{m.num}</span>
            <span class="cell__lbl">{m.label}</span>
          </p>
          <h3 class="cell__h" style="white-space: pre-line;">{m.title}</h3>
          <p class="cell__body">{m.body}</p>
          <a class="cell__link" href={withBase(m.link.href)}>{m.link.text} &rarr;</a>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="sect">
  <div class="wrap">
    <p class="sect__lbl">EIGHTEEN RUNNABLE EXAMPLES</p>
    <h2 class="sect__h">Not a hello world between them.</h2>

    <div class="rows">
      {examples.map((e) => (
        <div class="rows__row">
          <span class="rows__k">{e.name}</span>
          <span class="rows__v">{e.body}</span>
        </div>
      ))}
    </div>

    <p style="margin-top: 22px; color: var(--fg-dim); max-width: 68ch;">
      Each one runs against a local KurrentDB and carries its own README. The processor guide walks
      the same ground in order.
    </p>
  </div>
</section>

<section class="sect" style="padding-bottom: 96px;">
  <div class="wrap">
    <p class="sect__lbl">COMING FROM SOMETHING ELSE</p>
    <h2 class="sect__h">There is a way in.</h2>
    <p style="color: var(--fg-dim); margin: 14px 0 0; max-width: 68ch;">
      Kurrent Surge is new. The path onto it is not left as an exercise.
    </p>

    <div class="ways-in">
      {waysIn.map((w) => (
        <a class="btn-secondary" href={withBase(w.href)}>{w.text}</a>
      ))}
    </div>
  </div>
</section>

</body>
</html>
