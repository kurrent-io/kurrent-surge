{
  "ConnectionStrings": {
    "kurrentdb": "kurrentdb://admin:changeit@localhost:2113?tls=false"
  },
  "Connector": {
    "Id": "kafka-sink-payments",
    "Settings": {
      "instanceTypeName": "kafka-sink",
      "bootstrapServers": "localhost:9092",
      "topic": "payments",
      "subscription": {
        "filter": {
          "scope": "stream",
          "filterType": "prefix",
          "expression": "paymentPlan-"
        },
        "initialPosition": "latest"
      },
      "partitionKeyExtraction": {
        "enabled": "true",
        "source": "streamSuffix"
      },
      "WaitForBrokerAck": "false",
      "compression": {
        "type": "Gzip"
      }
    }
  }
}
