<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <AfterMicrosoftNETSdkTargets>$(AfterMicrosoftNETSdkTargets);$(MSBuildThisFileDirectory)src/NonPackable.targets</AfterMicrosoftNETSdkTargets>

    <!-- Include only en-US satellite resources to reduce package size -->
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>

    <!-- Exclude all .DotSettings files from being included -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/*.DotSettings</DefaultItemExcludes>

    <!-- AOT/Trimming — surface all warnings, never suppress -->
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <!-- Flag referenced assemblies not marked AOT-compatible (IL3058). Only fires on projects
         that opt into AOT analysis (IsAotCompatible), so it's inert for tests and netstandard2.0 generators. -->
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>

    <!-- Warnings -->
    <!-- NETSDK1057 - You are using a preview version of .NET -->
    <!-- RS2008: Enable analyzer release tracking for the analyzer project containing rule `[RULE_CODE]` -->
    <!-- TestCaseGenerators - TUnit0001: Test argument types don't match method parameters -->
    <!-- TestCaseGenerators - TUnit0038: No data source provided -->
    <!-- CS8509: The switch expression does not handle all possible values of its input type (it is not exhaustive) -->
    <!-- CS8524: The switch expression does not handle some values of its input type (it is not exhaustive) involving an unnamed enum value -->
    <!-- IDE0130: namespace doesn't match folder — curated namespaces for now, tighten as we go -->
    <NoWarn>$(NoWarn);NETSDK1057;RS2008;TUnit0001;TUnit0038;CS8509;CS8524;IDE0130;</NoWarn>

    <!-- CI builds -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Define directories -->
    <RepoRoot>$([System.IO.Directory]::GetParent($(MSBuildThisFileDirectory)).FullName)</RepoRoot>
    <SharedDir>$(MSBuildThisFileDirectory)/src/Shared/</SharedDir>
    <TestsSharedDir>$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory), 'tests', 'Shared'))</TestsSharedDir>
  </PropertyGroup>

  <!--
    Source generators that ship inside SDK packages as analyzers (analyzers/dotnet/cs). Single
    source of truth: Kurrent.Surge packs these (PackedAnalyzer), and Directory.Build.targets wires
    the same set as analyzers for in-repo projects that reference the SDK by source — analyzers are
    not transitive through a ProjectReference, so source consumers need them added explicitly.
    Add a future packed analyzer here once; both the package and source consumers pick it up.
  -->
  <ItemGroup>
    <PackedAnalyzerProject Include="$(RepoRoot)/src/Kurrent.Surge.Schema.Catalogs.Generators/Kurrent.Surge.Schema.Catalogs.Generators.csproj" />
  </ItemGroup>

  <ItemGroup Label="Default Packages">
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
    <Using Include="JetBrains.Annotations" />
  </ItemGroup>

  <!--
  ================================================================
  NuGet Package Metadata
  ================================================================
  Shared defaults for every package. Deliberately unconditional: gating on IsPackable
  here is the classic .props pitfall — projects set IsPackable in their .csproj, which
  evaluates AFTER this file, so the condition is always false and the metadata silently
  never applies. Pack-only properties are inert on non-packable projects, so no gate is
  needed. Per-package metadata (Title, Description, PackageTags, or any override of the
  values below) lives in each .csproj and wins because it evaluates later.
  -->
  <PropertyGroup Label="NuGet Package Metadata">
    <Authors>Kurrent Inc.</Authors>
    <Company>Kurrent Inc.</Company>
    <Copyright>Copyright © 2011-$([System.DateTime]::Now.Year) $(Company)</Copyright>

    <PackageIcon>ouro.png</PackageIcon>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/kurrent-io/kurrent-sdk-dotnet</PackageProjectUrl>
    <PackageReleaseNotes>https://kurrent.io/blog/</PackageReleaseNotes>

    <RepositoryUrl>https://github.com/kurrent-io/kurrent-sdk-dotnet</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Label="Symbol Package Settings">
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup Label="NuGet Package Dependencies" Condition="'$(IsPackable)'=='true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <None Include="$(RepoRoot)\ouro.png" Pack="true" PackagePath="\" />
    <None Include="$(RepoRoot)\LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
