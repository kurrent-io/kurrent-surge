<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>

    <!-- Include only en-US satellite resources to reduce package size -->
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>

    <!-- Exclude all .DotSettings files from being included -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/*.DotSettings</DefaultItemExcludes>

    <!-- Warnings -->
    <!-- NETSDK1057 - You are using a preview version of .NET -->
    <!-- RS2008: Enable analyzer release tracking for the analyzer project containing rule `[RULE_CODE]` -->
    <NoWarn>$(NoWarn);NETSDK1057;RS2008</NoWarn>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>

    <!-- CI builds -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Define the repository root directory -->
    <RepoRoot>$([System.IO.Directory]::GetParent($(MSBuildThisFileDirectory)).FullName)</RepoRoot>
  </PropertyGroup>

  <ItemGroup Label="Default Packages">
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
    <Using Include="JetBrains.Annotations" />
  </ItemGroup>

  <!--
  ================================================================
  NuGet Package Metadata
  ================================================================
  -->
  <PropertyGroup Label="NuGet Package Metadata" Condition="'$(IsPackable)' == 'true'">
    <Authors>Kurrent Inc.</Authors>
    <Company>Kurrent Inc.</Company>
    <Copyright>Copyright © 2011-$([System.DateTime]::Now.Year) $(Company)</Copyright>

    <PackageIcon>ouro.png</PackageIcon>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/kurrent-io/Kurrent.Client</PackageProjectUrl>
    <PackageReleaseNotes>https://kurrent.io/blog/</PackageReleaseNotes>

    <RepositoryUrl>https://github.com/kurrent-io/Kurrent.Client</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Label="Symbol Package Settings" Condition="'$(IsPackable)'=='true'">
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup Label="NuGet Package Dependencies" Condition="'$(IsPackable)'=='true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <None Include="$(RepoRoot)\ouro.png" Pack="true" PackagePath="\" />
    <None Include="$(RepoRoot)\LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
