<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- https://github.com/dotnet/sdk/issues/51873 — MTP ignores IsTestProject=false -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <RootNamespace>Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kurrent.Surge\Kurrent.Surge.csproj" />
    <ProjectReference Include="..\..\src\Kurrent.Surge.Core\Kurrent.Surge.Core.csproj" />
    <!-- Aliased: Kurrent.Surge.MessagePack and Kurrent.Surge.MessagePack.Nerdbank both put their
         MessagePackSchemaSerializer/Options types in the identical namespace
         Kurrent.Surge.Client.Schema.Serialization.MessagePack. Referencing both unaliased in the
         same project is a compile-time ambiguity (CS0433); extern alias disambiguates. -->
    <ProjectReference Include="..\..\src\Kurrent.Surge.MessagePack\Kurrent.Surge.MessagePack.csproj" Aliases="MsgPackOfficial" />
    <ProjectReference Include="..\..\src\Kurrent.Surge.MessagePack.Nerdbank\Kurrent.Surge.MessagePack.Nerdbank.csproj" Aliases="MsgPackNerdbank" />
    <ProjectReference Include="..\..\test\Kurrent.Surge.Tests\Kurrent.Surge.Tests.csproj" />
    <ProjectReference Include="..\..\test\Kurrent.Surge.Testkit\Kurrent.Surge.Testkit.csproj" />
    <ProjectReference Include="..\..\test\Kurrent.Testkit\Kurrent.Testkit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Benchmarks\Processors\" />
  </ItemGroup>
</Project>
