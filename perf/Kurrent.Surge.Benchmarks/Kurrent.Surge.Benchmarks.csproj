<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- https://github.com/dotnet/sdk/issues/51873 — MTP ignores IsTestProject=false -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <RootNamespace>Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kurrent.Surge\Kurrent.Surge.csproj" />
    <ProjectReference Include="..\..\src\Kurrent.Surge.Core\Kurrent.Surge.Core.csproj" />
    <ProjectReference Include="..\..\src\Kurrent.Surge.Codecs.Avro\Kurrent.Surge.Codecs.Avro.csproj" />
    <!-- Analyzers are not transitive through a ProjectReference, so the codec generator is wired
         explicitly; a NuGet consumer receives it from analyzers/dotnet/cs. -->
    <ProjectReference Include="..\..\src\Kurrent.Surge.Codecs.Avro.Generators\Kurrent.Surge.Codecs.Avro.Generators.csproj" Analyzer="true" />
    <ProjectReference Include="..\..\src\Kurrent.Surge.Codecs.MessagePack\Kurrent.Surge.Codecs.MessagePack.csproj" />
    <ProjectReference Include="..\..\src\Kurrent.Surge.Codecs.NerdbankMessagePack\Kurrent.Surge.Codecs.NerdbankMessagePack.csproj" />
    <ProjectReference Include="..\..\test\Kurrent.Surge.Tests\Kurrent.Surge.Tests.csproj" />
    <ProjectReference Include="..\..\test\Kurrent.Surge.Testkit\Kurrent.Surge.Testkit.csproj" />
    <ProjectReference Include="..\..\test\Kurrent.Testkit\Kurrent.Testkit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Schemas/*.avsc" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Benchmarks\Processors\" />
  </ItemGroup>
</Project>
