<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- https://github.com/dotnet/sdk/issues/51873 — MTP ignores IsTestProject=false -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <RootNamespace>Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kurrent.Surge\Kurrent.Surge.csproj" />
    <ProjectReference Include="..\..\src\Kurrent.Surge.Core\Kurrent.Surge.Core.csproj" />
    <ProjectReference Include="..\..\src\Kurrent.Surge.Codecs.Avro\Kurrent.Surge.Codecs.Avro.csproj" />
    <ProjectReference Include="..\..\src\Kurrent.Surge.RecordFilters\Kurrent.Surge.RecordFilters.csproj" />
    <!-- Analyzers are not transitive through a ProjectReference, so the codec generator is wired
         explicitly; a NuGet consumer receives it from analyzers/dotnet/cs. -->
    <ProjectReference Include="..\..\src\Kurrent.Surge.Codecs.Avro.Generators\Kurrent.Surge.Codecs.Avro.Generators.csproj" Analyzer="true" />
    <ProjectReference Include="..\..\src\Kurrent.Surge.Codecs.MessagePack\Kurrent.Surge.Codecs.MessagePack.csproj" />
    <ProjectReference Include="..\..\src\Kurrent.Surge.Codecs.NerdbankMessagePack\Kurrent.Surge.Codecs.NerdbankMessagePack.csproj" />
    <!-- The original transcoder is the correctness oracle and the perf baseline for the two
         experimental writers, so it is measured in the same run rather than from memory. -->
    <ProjectReference Include="..\..\src\ProtobufTranscoder\ProtobufTranscoder.csproj" />
    <!-- Carries the probe schema and the protoc-generated types the typed ceiling is measured with. -->
    <ProjectReference Include="..\..\test\Kurrent.Surge.Core.Tests\Kurrent.Surge.Core.Tests.csproj" />
    <ProjectReference Include="..\..\test\Kurrent.Surge.Tests\Kurrent.Surge.Tests.csproj" />
    <ProjectReference Include="..\..\test\Kurrent.Surge.Testkit\Kurrent.Surge.Testkit.csproj" />
    <ProjectReference Include="..\..\test\Kurrent.Testkit\Kurrent.Testkit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Schemas/*.avsc" />
    <!-- Also copied out, because AvroJsonSchemaBenchmarks is driven by schema text at run time rather
         than by a generated type. Update, not Include: the SDK's default glob already owns these. -->
    <None Update="Schemas/*.avsc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- AvroLogicalTypeBenchmarks measures the NanoInstant conversion across ISpecificRecord, which the
       Long default erases away. A ProjectReference does not import the package's build/*.props the way a
       NuGet consumer would, so the property is declared visible here. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="KurrentAvroNanosecondTimestamps" />
    <CompilerVisibleProperty Include="KurrentAvroApacheInterop" />
  </ItemGroup>

  <PropertyGroup>
    <KurrentAvroNanosecondTimestamps>NanoInstant</KurrentAvroNanosecondTimestamps>
    <!-- Apache is the parity oracle here, so generated types must carry the surface its writers need. -->
    <KurrentAvroApacheInterop>On</KurrentAvroApacheInterop>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Benchmarks\Processors\" />
  </ItemGroup>
</Project>
