{
  "name": "Kurrent .NET SDK",
  
  // All tools are baked into the Dockerfile for fast startup.
  // Only docker-in-docker stays as a feature because it needs
  // entrypoint wiring and privileged mode.
  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  "remoteUser": "vscode",

  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

  "containerEnv": {
    "HISTFILE": "/commandhistory/.zsh_history",
    // `dotnet dev-certs https --trust` exits 4 unless the dev-cert trust directory is
    // on SSL_CERT_DIR alongside the active OpenSSL cert store. Homebrew is first on
    // PATH, so the active store is its openssl@3, not the system one.
    "SSL_CERT_DIR": "/home/vscode/.aspnet/dev-certs/trust:/home/linuxbrew/.linuxbrew/etc/openssl@3/certs",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "TESTINGPLATFORM_TELEMETRY_OPTOUT": "1",
    "TUNIT_DISABLE_LOGO": "true",
    "TUNIT_DISABLE_HTML_REPORTER": "true",
    "TUNIT_DISABLE_JUNIT_REPORTER": "true"
  },

  "remoteEnv": {
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
    "NUGET_AUTH_TOKEN": "${localEnv:NUGET_AUTH_TOKEN}",
    "NuGetPackageSourceCredentials_GitHub": "Username=pat;Password=${localEnv:NUGET_AUTH_TOKEN}",
    "DOTNET_ENVIRONMENT": "Development",
    "ASPNETCORE_ENVIRONMENT": "Development"
  },

  "secrets": {
    "GITHUB_TOKEN": {
      "description": "GitHub PAT for private package access and gh CLI"
    },
    "NUGET_AUTH_TOKEN": {
      "description": "GitHub PAT for NuGet feed authentication (read:packages scope)"
    }
  },

  // Persistent named volumes scoped per project and container instance.
  // These mount inside the container's home directory (not the workspace),
  // so they don't create root-owned directories on the host filesystem.
  "mounts": [
    "source=${localWorkspaceFolderBasename}-${devcontainerId}-commandhistory,target=/commandhistory,type=volume",
    "source=${localWorkspaceFolderBasename}-${devcontainerId}-nuget-cache,target=/home/vscode/.nuget,type=volume",
    "source=${localWorkspaceFolderBasename}-${devcontainerId}-dotnet-tools,target=/home/vscode/.dotnet/tools,type=volume"
  ],

  "otherPortsAttributes": { "onAutoForward": "silent" },

  "customizations": {
    "vscode": {
      "settings": {
        "remote.autoForwardPorts": true,
        "remote.autoForwardPortsSource": "hybrid",
        "remote.otherPortsAttributes": {
          "onAutoForward": "ignore"
        },
        
        "dotnet.defaultSolution": "Kurrent.Surge.slnx",
        "dotnet.testWindow.useTestingPlatformProtocol": true,
        
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'FiraCode Nerd Font', 'MesloLGS NF', monospace",
        
        "files.exclude": { "**/bin": true, "**/obj": true },
        "search.exclude": { "**/bin": true, "**/obj": true },
        "files.watcherExclude": { "**/bin": true, "**/obj": true, "**/.git/objects": true }
      },
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-azuretools.vscode-docker",
        "EditorConfig.EditorConfig",
        "microsoft-aspire.aspire-vscode"
      ]
    },
    "jetbrains": {
      "backend": "Rider",
      "settings": {
        "dotnet.defaultSolution": "Kurrent.Surge.slnx"
      },
      "plugins": []
    }
  },

  "onCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}",
  "updateContentCommand": "dotnet restore",
  "postCreateCommand": "bash .devcontainer/verify.sh",
  "postStartCommand": "dotnet dev-certs https --trust",
  "waitFor": "postCreateCommand"
}
