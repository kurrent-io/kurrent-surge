using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Localization;
using System.Globalization;
using System.Security.Claims;
using System.Threading.Tasks;

namespace LocalizationExample.CultureProviders
{
    // ===================================
    // Example 1: User Profile Culture Provider
    // ===================================

    /// <summary>
    /// Reads culture from authenticated user's profile stored in database.
    /// </summary>
    public class UserProfileCultureProvider : RequestCultureProvider
    {
        private readonly IUserService _userService;

        public UserProfileCultureProvider(IUserService userService)
        {
            _userService = userService;
        }

        public override async Task<ProviderCultureResult> DetermineProviderCultureResult(HttpContext httpContext)
        {
            if (httpContext == null)
                throw new ArgumentNullException(nameof(httpContext));

            // Only for authenticated users
            if (!httpContext.User.Identity?.IsAuthenticated ?? true)
                return await NullProviderCultureResult;

            // Get user ID from claims
            var userId = httpContext.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (string.IsNullOrEmpty(userId))
                return await NullProviderCultureResult;

            // Retrieve user's preferred culture from database
            var userCulture = await _userService.GetUserCultureAsync(userId);

            if (string.IsNullOrEmpty(userCulture))
                return await NullProviderCultureResult;

            // Validate culture
            try
            {
                var culture = new CultureInfo(userCulture);
                return new ProviderCultureResult(culture.Name);
            }
            catch (CultureNotFoundException)
            {
                // Invalid culture in database
                return await NullProviderCultureResult;
            }
        }
    }

    // ===================================
    // Example 2: Subdomain Culture Provider
    // ===================================

    /// <summary>
    /// Determines culture based on subdomain (e.g., es.example.com, fr.example.com).
    /// </summary>
    public class SubdomainCultureProvider : RequestCultureProvider
    {
        private readonly Dictionary<string, string> _subdomainCultureMap = new()
        {
            { "es", "es-MX" },
            { "fr", "fr-CA" },
            { "de", "de-DE" },
            { "ja", "ja-JP" }
        };

        public override Task<ProviderCultureResult> DetermineProviderCultureResult(HttpContext httpContext)
        {
            if (httpContext == null)
                throw new ArgumentNullException(nameof(httpContext));

            var host = httpContext.Request.Host.Host;

            // Extract subdomain (assumes format: subdomain.domain.com)
            var parts = host.Split('.');
            if (parts.Length >= 3)
            {
                var subdomain = parts[0];

                if (_subdomainCultureMap.TryGetValue(subdomain, out string culture))
                {
                    return Task.FromResult(new ProviderCultureResult(culture));
                }
            }

            // No subdomain or unmapped subdomain
            return NullProviderCultureResult;
        }
    }

    // ===================================
    // Example 3: Custom Header Culture Provider
    // ===================================

    /// <summary>
    /// Reads culture from custom HTTP header (X-Culture or X-Preferred-Language).
    /// </summary>
    public class CustomHeaderCultureProvider : RequestCultureProvider
    {
        public string HeaderName { get; set; } = "X-Culture";

        public override Task<ProviderCultureResult> DetermineProviderCultureResult(HttpContext httpContext)
        {
            if (httpContext == null)
                throw new ArgumentNullException(nameof(httpContext));

            if (!httpContext.Request.Headers.TryGetValue(HeaderName, out var headerValue))
                return NullProviderCultureResult;

            var cultureName = headerValue.ToString();

            if (string.IsNullOrWhiteSpace(cultureName))
                return NullProviderCultureResult;

            // Validate culture
            try
            {
                var culture = new CultureInfo(cultureName);
                return Task.FromResult(new ProviderCultureResult(culture.Name));
            }
            catch (CultureNotFoundException)
            {
                return NullProviderCultureResult;
            }
        }
    }

    // ===================================
    // Example 4: IP Geolocation Culture Provider
    // ===================================

    /// <summary>
    /// Determines culture based on client's IP address geolocation.
    /// </summary>
    public class IpGeolocationCultureProvider : RequestCultureProvider
    {
        private readonly IGeolocationService _geolocationService;

        public IpGeolocationCultureProvider(IGeolocationService geolocationService)
        {
            _geolocationService = geolocationService;
        }

        public override async Task<ProviderCultureResult> DetermineProviderCultureResult(HttpContext httpContext)
        {
            if (httpContext == null)
                throw new ArgumentNullException(nameof(httpContext));

            // Get client IP address
            var ipAddress = httpContext.Connection.RemoteIpAddress?.ToString();
            if (string.IsNullOrEmpty(ipAddress))
                return await NullProviderCultureResult;

            // Look up country from IP
            var country = await _geolocationService.GetCountryFromIpAsync(ipAddress);
            if (country == null)
                return await NullProviderCultureResult;

            // Map country to culture
            var culture = MapCountryToCulture(country);
            if (culture == null)
                return await NullProviderCultureResult;

            return new ProviderCultureResult(culture);
        }

        private string MapCountryToCulture(string countryCode)
        {
            return countryCode switch
            {
                "US" => "en-US",
                "MX" => "es-MX",
                "ES" => "es-ES",
                "FR" => "fr-FR",
                "CA" => "en-CA",  // Could be fr-CA, needs more logic
                "DE" => "de-DE",
                "JP" => "ja-JP",
                "CN" => "zh-CN",
                _ => null
            };
        }
    }

    // ===================================
    // Example 5: Session Storage Culture Provider
    // ===================================

    /// <summary>
    /// Reads culture from session storage.
    /// </summary>
    public class SessionCultureProvider : RequestCultureProvider
    {
        public string SessionKey { get; set; } = "Culture";

        public override Task<ProviderCultureResult> DetermineProviderCultureResult(HttpContext httpContext)
        {
            if (httpContext == null)
                throw new ArgumentNullException(nameof(httpContext));

            // Ensure session is available
            if (!httpContext.Session.IsAvailable)
                return NullProviderCultureResult;

            var cultureName = httpContext.Session.GetString(SessionKey);

            if (string.IsNullOrWhiteSpace(cultureName))
                return NullProviderCultureResult;

            try
            {
                var culture = new CultureInfo(cultureName);
                return Task.FromResult(new ProviderCultureResult(culture.Name));
            }
            catch (CultureNotFoundException)
            {
                return NullProviderCultureResult;
            }
        }
    }

    // ===================================
    // Example 6: Composite Culture Provider (Priority Chain)
    // ===================================

    /// <summary>
    /// Tries multiple strategies in order until one succeeds.
    /// </summary>
    public class CompositeCultureProvider : RequestCultureProvider
    {
        private readonly List<IRequestCultureProvider> _providers;

        public CompositeCultureProvider(params IRequestCultureProvider[] providers)
        {
            _providers = new List<IRequestCultureProvider>(providers);
        }

        public override async Task<ProviderCultureResult> DetermineProviderCultureResult(HttpContext httpContext)
        {
            foreach (var provider in _providers)
            {
                var result = await provider.DetermineProviderCultureResult(httpContext);
                if (result != null)
                {
                    return result;
                }
            }

            return await NullProviderCultureResult;
        }
    }

