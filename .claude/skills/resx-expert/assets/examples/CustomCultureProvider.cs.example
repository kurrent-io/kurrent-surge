    // ===================================
    // Supporting Interfaces
    // ===================================

    public interface IUserService
    {
        Task<string> GetUserCultureAsync(string userId);
        Task SetUserCultureAsync(string userId, string culture);
    }

    public interface IGeolocationService
    {
        Task<string> GetCountryFromIpAsync(string ipAddress);
    }

    // ===================================
    // Example Implementations (Stub)
    // ===================================

    public class UserService : IUserService
    {
        private readonly ApplicationDbContext _dbContext;

        public UserService(ApplicationDbContext dbContext)
        {
            _dbContext = dbContext;
        }

        public async Task<string> GetUserCultureAsync(string userId)
        {
            var user = await _dbContext.Users.FindAsync(userId);
            return user?.PreferredCulture;
        }

        public async Task SetUserCultureAsync(string userId, string culture)
        {
            var user = await _dbContext.Users.FindAsync(userId);
            if (user != null)
            {
                user.PreferredCulture = culture;
                await _dbContext.SaveChangesAsync();
            }
        }
    }

    public class GeolocationService : IGeolocationService
    {
        private readonly HttpClient _httpClient;

        public GeolocationService(HttpClient httpClient)
        {
            _httpClient = httpClient;
        }

        public async Task<string> GetCountryFromIpAsync(string ipAddress)
        {
            // Example using a geolocation API
            try
            {
                var response = await _httpClient.GetAsync($"https://api.ipgeolocation.io/ipgeo?apiKey=YOUR_API_KEY&ip={ipAddress}");
                if (response.IsSuccessStatusCode)
                {
                    var data = await response.Content.ReadFromJsonAsync<GeolocationResponse>();
                    return data?.CountryCode2;
                }
            }
            catch
            {
                // Handle errors
            }

            return null;
        }
    }

    public class GeolocationResponse
    {
        public string CountryCode2 { get; set; }
        public string CountryName { get; set; }
    }

    // Placeholder DbContext
    public class ApplicationDbContext
    {
        public DbSet<User> Users { get; set; }

        public Task<User> FindAsync(string userId) => Task.FromResult<User>(null);
        public Task<int> SaveChangesAsync() => Task.FromResult(0);
    }

    public class User
    {
        public string Id { get; set; }
        public string PreferredCulture { get; set; }
    }

    public class DbSet<T>
    {
        public Task<T> FindAsync(params object[] keyValues) => Task.FromResult(default(T));
    }
}
