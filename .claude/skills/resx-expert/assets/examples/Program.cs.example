// Resource File Structure
// ===================================
/*
YourApp/
├── Resources/
│   ├── SharedResources.resx                # Shared across app
│   ├── SharedResources.es-MX.resx
│   ├── SharedResources.fr-CA.resx
│   ├── Controllers/
│   │   ├── HomeController.resx             # Controller-specific
│   │   ├── HomeController.es-MX.resx
│   │   ├── ApiController.resx
│   │   └── ApiController.es-MX.resx
│   └── Views/
│       ├── Home/
│       │   ├── Index.resx                  # View-specific
│       │   ├── Index.es-MX.resx
│       │   ├── About.resx
│       │   └── About.es-MX.resx
│       └── Shared/
│           ├── _Layout.resx
│           └── _Layout.es-MX.resx
└── Program.cs
*/
