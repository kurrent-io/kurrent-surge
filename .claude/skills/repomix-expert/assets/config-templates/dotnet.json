{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "style": "json",
    "filePath": "dotnet-analysis.json",
    "compress": true,
    "removeComments": false,
    "topFilesLength": 20
  },
  "include": [
    "**/*.cs",
    "**/*.cshtml",
    "**/*.csproj",
    "**/*.sln",
    "**/*.json",
    "**/*.md"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/bin/**",
      "**/obj/**",
      "**/*.Designer.cs",
      "**/Migrations/**",
      "**/.vs/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
