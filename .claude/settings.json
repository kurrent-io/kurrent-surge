{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Glob",
      "Grep",
      "LS",
      "Bash",
      "WebFetch",
      "WebSearch",
      "Task",
      "mcp__ide__getDiagnostics",
      "mcp__plugin_microsoft-docs_microsoft-learn__*",
      "mcp__plugin_context7_context7__*",
      "mcp__plugin_github_github__*",
      "Skill(microsoft-docs:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./appsettings.Development.json)",
      "Read(./appsettings.*.Local.json)",
      "Read(./secrets.json)",
      "Read(./**/secrets.json)",
      "Read(./**/launchSettings.json)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)",
      "Read(./**/*secret*)",
      "Read(./**/*password*)",
      "Read(./**/*credential*)",
      "Read(./**/*token*.json)"
    ]
  },
  "extraKnownMarketplaces": {
    "microsoft-docs-marketplace": {
      "source": {
        "source": "github",
        "repo": "microsoftdocs/mcp"
      }
    }
  },
  "enableAllProjectMcpServers": false,
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "microsoft-docs@microsoft-docs-marketplace": true
  }
}
