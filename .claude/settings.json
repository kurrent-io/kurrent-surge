{
  "permissions": {
    "deny": [
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)",
      "Read(./**/*credential*)",
      "Read(./**/*password*)",
      "Read(./**/*secret*)",
      "Read(./**/*token*.json)",
      "Read(./**/launchSettings.json)",
      "Read(./**/secrets.json)",
      "Read(./**/secrets/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./appsettings.*.Local.json)",
      "Read(./appsettings.Development.json)",
      "Read(./secrets.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/setup-remote.py",
            "timeout": 300,
            "statusMessage": "Setting up remote environment..."
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "docs/node_modules"
    ],
    "baseRef": "head"
  }
}
