{
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": 1,
    "CLAUDE_CODE_EFFORT_LEVEL": "high",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": 1,
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": 1,
    "ENABLE_TOOL_SEARCH": 1,
    "DISABLE_TELEMETRY": 1,
    "DISABLE_ERROR_REPORTING": 1
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Agent",
      "Bash",
      "CronCreate",
      "CronDelete",
      "CronList",
      "Edit",
      "EnterPlanMode",
      "EnterWorktree",
      "ExitPlanMode",
      "ExitWorktree",
      "Glob",
      "Grep",
      "LSP",
      "ListMcpResourcesTool",
      "NotebookEdit",
      "Read",
      "ReadMcpResourceTool",
      "SendMessage",
      "Skill",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "TeamCreate",
      "TeamDelete",
      "ToolSearch",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__claude-in-chrome__*",
      "mcp__plugin_context7_context7__*",
      "mcp__plugin_microsoft-docs_microsoft-learn__*",
      "mcp__rider__*"
    ],
    "deny": [
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)",
      "Read(./**/*credential*)",
      "Read(./**/*password*)",
      "Read(./**/*secret*)",
      "Read(./**/*token*.json)",
      "Read(./**/launchSettings.json)",
      "Read(./**/secrets.json)",
      "Read(./**/secrets/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./appsettings.*.Local.json)",
      "Read(./appsettings.Development.json)",
      "Read(./secrets.json)",
      "mcp__rider__execute_run_configuration",
      "mcp__rider__get_run_configurations",
      "mcp__rider__execute_terminal_command"
    ]
  },
  "includeGitInstructions": false,
  "cleanupPeriodDays": 7,
  "worktree": {
    "symlinkDirectories": ["node_modules"]
  },
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "microsoft-docs@microsoft-docs-marketplace": true,
    "dotnet-skills@dotnet-skills": true,
    "csharp-lsp@claude-plugins-official": true,
    "dotnet-nuget-proxy@dotnet-nuget-proxy": true
  },
  "extraKnownMarketplaces": {
    "microsoft-docs-marketplace": {
      "source": {
        "source": "github",
        "repo": "microsoftdocs/mcp"
      }
    },
    "dotnet-skills": {
      "source": {
        "source": "github",
        "repo": "Aaronontheweb/dotnet-skills"
      }
    },
    "dotnet-nuget-proxy": {
      "source": {
        "source": "github",
        "repo": "logiclabs/dotnet-nuget-proxy-skill"
      }
    }
  }
}
