{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": 64000,
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": 1,
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": 0,
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": 95,
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": 1,
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": 1,
    "ENABLE_TOOL_SEARCH": 1,
    "DISABLE_TELEMETRY": 1,
    "DISABLE_ERROR_REPORTING": 1
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "AskUserQuestion",
      "Bash",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "Task",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__plugin_context7_context7__*",
      "mcp__plugin_microsoft-docs_microsoft-learn__*",
      "mcp__rider__*",
      "Skill(microsoft-docs:*)",
      "Skill(dotnet-skills:*)",
      "Skill(dotnet-nuget-proxy:*)"
    ],
    "deny": [
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)",
      "Read(./**/*credential*)",
      "Read(./**/*password*)",
      "Read(./**/*secret*)",
      "Read(./**/*token*.json)",
      "Read(./**/launchSettings.json)",
      "Read(./**/secrets.json)",
      "Read(./**/secrets/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./appsettings.*.Local.json)",
      "Read(./appsettings.Development.json)",
      "Read(./secrets.json)",
      "mcp__rider__execute_run_configuration",
      "mcp__rider__get_run_configurations",
      "mcp__rider__execute_terminal_command"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "microsoft-docs@microsoft-docs-marketplace": true,
    "dotnet-skills@dotnet-skills": true,
    "csharp-lsp@claude-plugins-official": true,
    "dotnet-nuget-proxy@dotnet-nuget-proxy": true
  },
  "extraKnownMarketplaces": {
    "microsoft-docs-marketplace": {
      "source": {
        "source": "github",
        "repo": "microsoftdocs/mcp"
      }
    },
    "dotnet-skills": {
      "source": {
        "source": "github",
        "repo": "Aaronontheweb/dotnet-skills"
      }
    },
    "dotnet-nuget-proxy": {
      "source": {
        "source": "github",
        "repo": "logiclabs/dotnet-nuget-proxy-skill"
      }
    }
  },
  "spinnerTipsEnabled": false
}
