{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Glob",
      "Grep",
      "LS",
      "Bash",
      "WebFetch",
      "WebSearch",
      "Task",
      "mcp__ide__getDiagnostics",
      "Skill(csharp-craftsman)",
      "Skill(git-conventional-commits-expert)",
      "Skill(microsoft-docs-expert)",
      "Skill(repomix-expert)",
      "Skill(resx-expert)",
      "Skill(tunit-master)",
      "Skill(dotnet-logging-expert)",
      "Skill(tldr-expert)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./appsettings.Development.json)",
      "Read(./appsettings.*.Local.json)",
      "Read(./secrets.json)",
      "Read(./**/secrets.json)",
      "Read(./**/launchSettings.json)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)",
      "Read(./**/*secret*)",
      "Read(./**/*password*)",
      "Read(./**/*credential*)",
      "Read(./**/*token*.json)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-compact-reload.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": false,
    "microsoft-docs@microsoft-docs-marketplace": true,
    "omnisharp@claude-code-lsps": true
  }
}
