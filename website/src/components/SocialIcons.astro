---
// Extends the default social icons with links out to the other Kurrent sites.
// SocialIcons is the only header slot Starlight exposes for arbitrary links,
// so the links and their dividers live here rather than in the stylesheet.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const sites = [
  { label: 'KurrentDB', href: 'https://kurrentdb.kurrent.io/' },
  { label: 'Capacitor', href: 'https://capacitor.kurrent.io/' },
];
---

<Default />

{
  sites.map((site, i) => (
    <a href={site.href} class:list={['site-link', { 'site-link--lead': i === 0 }]}>
      {site.label}
    </a>
  ))
}

<style>
  .site-link {
    /* The divider is the link's own leading border, so it sits at the text
       height without a spacer element. Between one site link and the next it
       is a hairline: DESIGN.md allows exactly two 3px rules on the site, and
       a second accent bar here would make three and read as two separate
       groups rather than one list. */
    border-inline-start: 1px solid var(--border);
    padding-inline-start: 16px;
    margin-inline-start: 4px;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
  }
  /* The accent bar marks where the icons end and the site links begin, so it
     belongs to the first link only. Marked with a class rather than
     `:first-of-type`: the social icons are anchors too, so type matching here
     counts them and the rule lands on the wrong element. */
  .site-link--lead {
    border-inline-start: 3px solid var(--accent);
    margin-inline-start: 0;
  }
  .site-link:hover {
    color: var(--accent);
  }
  /* Offset stays at 2px even though the first link carries a 3px leading
     border: the outline wraps the border box, so the two never overlap. */
  .site-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
