---
// A two-state toggle in place of Starlight's dark/light/auto <select>, plus a
// typeface picker. Both are reader preferences, so they share the header
// cluster.
//
// Starlight's own storage key and data-theme attribute are reused, so its
// ThemeProvider still restores the choice before first paint.
import { Icon } from '@astrojs/starlight/components';
---

<button type="button" class="theme-toggle" data-theme-toggle>
  <Icon name="sun" class="theme-toggle__sun" />
  <Icon name="moon" class="theme-toggle__moon" />
  <span class="sr-only">Toggle dark mode</span>
</button>

<button
  type="button"
  class="font-toggle"
  data-font-toggle
  aria-pressed="false"
  title="Switch to a dyslexia-friendly typeface"
>
  <span aria-hidden="true">Aa</span>
  <span class="sr-only">Use a dyslexia-friendly typeface</span>
</button>

<style>
  .theme-toggle,
  .font-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2rem;
    block-size: 2rem;
    border: none;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }
  .theme-toggle:hover,
  .font-toggle:hover {
    color: var(--sl-color-white);
  }
  .theme-toggle:focus-visible,
  .font-toggle:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  /* One glyph at a time: the sun offers the light theme, the moon the dark. */
  :global([data-theme='dark']) .theme-toggle__moon,
  :global(:root:not([data-theme='light'])) .theme-toggle__moon {
    display: none;
  }
  :global([data-theme='light']) .theme-toggle__sun {
    display: none;
  }
  :global([data-theme='light']) .theme-toggle__moon {
    display: block;
  }

  .font-toggle {
    padding-inline: 0.4rem;
    font-family: var(--sl-font-system-mono);
    font-size: 13px;
    font-weight: 600;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
  }
  .font-toggle:hover {
    border-color: var(--sl-color-text-accent);
  }
  .font-toggle[aria-pressed='true'] {
    color: var(--sl-color-text-invert);
    background: var(--sl-color-text-accent);
    border-color: var(--sl-color-text-accent);
  }
</style>

<script>
  function initHeaderToggles() {
    const root = document.documentElement;

    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
      const label = () => {
        const dark = root.dataset.theme !== 'light';
        button.title = dark ? 'Switch to the light theme' : 'Switch to the dark theme';
      };

      button.addEventListener('click', () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try {
          // Starlight's own key, so its pre-paint script restores this choice.
          localStorage.setItem('starlight-theme', next);
        } catch {}
        label();
      });

      label();
    });

    document.querySelectorAll<HTMLButtonElement>('[data-font-toggle]').forEach((button) => {
      const sync = () => {
        const on = root.dataset.font === 'dyslexic';
        button.setAttribute('aria-pressed', String(on));
        button.title = on
          ? 'Switch back to the default typeface'
          : 'Switch to a dyslexia-friendly typeface';
      };

      button.addEventListener('click', () => {
        const on = root.dataset.font === 'dyslexic';
        if (on) delete root.dataset.font;
        else root.dataset.font = 'dyslexic';
        try {
          localStorage.setItem('surge-font', on ? 'default' : 'dyslexic');
        } catch {}
        sync();
      });

      sync();
    });
  }

  initHeaderToggles();
  document.addEventListener('astro:page-load', initHeaderToggles);
</script>
