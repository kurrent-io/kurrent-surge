{
  "mcpServers": {
    "jbcontext": {
      "type": "stdio",
      "command": "jbcontext",
      "args": [
        "mcp"
      ],
      "env": {}
    },
    "starwind-ui": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@starwind-ui/mcp"
      ],
      "env": {}
    },
    "omnniroute": {
      "type": "http",
      "url": "http://localhost:20128/api/mcp/stream",
      "headers": {
        "Authorization": "Bearer ${OMNIROUTER_API_KEY}"
      }
    }
  }
}