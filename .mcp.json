{
  "mcpServers": {
    "jbcontext": {
      "type": "stdio",
      "command": "jbcontext",
      "args": [
        "mcp"
      ],
      "env": {}
    },
    "starwind-ui": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@starwind-ui/mcp"
      ],
      "env": {}
    }
  }
}
