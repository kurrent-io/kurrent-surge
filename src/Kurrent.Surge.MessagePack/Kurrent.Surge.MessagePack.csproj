<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kurrent.Surge.Codecs.MessagePack</PackageId>
    <IsPackable>true</IsPackable>
    <Title>Kurrent Surge MessagePack Serializer</Title>
    <Product>Kurrent Surge MessagePack Serializer</Product>
    <Description>A schema serializer for the Kurrent .NET SDK backed by the official MessagePack-CSharp library, restricted to source-generated (never reflection-based) resolvers for Native AOT and trimming compatibility. Register your own MessagePackAnalyzer-generated resolver for consumer message types.</Description>
    <PackageTags>kurrent kurrentdb surge messagepack serialization schema aot</PackageTags>
  </PropertyGroup>

  <!-- AOT/Trimming Support -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Public dependency: Kurrent.Surge.MessagePack.nupkg depends on Kurrent.Surge.Core.nupkg,
         which declares ISchemaCodec — the pure, dependency-free codec surface this package
         plugs into. -->
    <ProjectReference Include="..\Kurrent.Surge.Core\Kurrent.Surge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" />
  </ItemGroup>

</Project>
