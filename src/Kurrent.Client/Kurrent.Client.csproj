<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Kurrent.Client</PackageId>
    <IsPackable>true</IsPackable>
    <Title>Kurrent .NET Client</Title>
    <Product>Kurrent .NET Client</Product>
    <Description>The official .NET client for the Kurrent Platform. Get the open source or commercial versions of KurrentDB from https://kurrent.io/</Description>
    <PackageTags>kurrent kurrentdb client sdk eventstore event-sourcing</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeHttpRuleProtos>true</IncludeHttpRuleProtos>
<!--    &lt;!&ndash; Embed project reference assemblies (e.g. Kurrent.Variant.dll) into lib/{tfm}/ during pack &ndash;&gt;-->
<!--    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackProjectDependencies</TargetsForTfmSpecificBuildOutput>-->
<!--    &lt;!&ndash; Embed source generator DLLs into analyzers/dotnet/cs/ during pack &ndash;&gt;-->
<!--    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackSourceGenerators</TargetsForTfmSpecificContentInPackage>-->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <RootNamespace>Kurrent</RootNamespace>
    
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin the logical name so it stays stable regardless of RootNamespace.
         The generated Designer references "Kurrent.Client.Resources.ErrorMessages". -->
    <EmbeddedResource Update="Resources\ErrorMessages.resx"
                      LogicalName="Kurrent.Client.Resources.ErrorMessages.resources" />
  </ItemGroup>

  <!-- AOT/Trimming Support -->
  <!--  <PropertyGroup>-->
  <!--    <IsTrimmable>true</IsTrimmable>-->
  <!--    <IsAotCompatible>true</IsAotCompatible>-->
  <!--    <PublishAot>true</PublishAot>-->
  <!--    <PublishTrimmed>true</PublishTrimmed>-->
  <!--  </PropertyGroup>-->

  <ItemGroup>
    <ProjectReference Include="..\Kurrent.Client.SourceGenerators\Kurrent.Client.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Variant.SourceGenerators\Variant.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Variant\Variant.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Api.CommonProtos" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Google.Protobuf.Tools" />
    <PackageReference Include="Grpc.StatusProto" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
<!--    <PackageReference Include="Microsoft.Extensions.Diagnostics.ExceptionSummarization" />-->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" /> <!-- for the backdoor client -->
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" />
    <PackageReference Include="NJsonSchema" />
    <PackageReference Include="NodaTime.Serialization.SystemTextJson" />
  </ItemGroup>

  <ItemGroup>
    <!-- protocol -->
    <Protobuf ProtoRoot="../../proto/kurrentdb/protocol"
              Include="../../proto/kurrentdb/protocol/**/*.proto"
              Link="proto\kurrentdb\protocol\%(RecursiveDir)/%(FileName)%(Extension)"
              AdditionalImportDirs="../../proto"
              Access="Internal"
              GrpcServices="Client"
              Exclude="../../proto/kurrentdb/protocol/v1/code.proto;../../proto/kurrentdb/protocol/v1/status.proto;../../proto/kurrentdb/protocol/v0/**/*.proto" />

    <!-- kurrent -->
    <Protobuf ProtoRoot="../../proto/kurrent"
              Include="../../proto/kurrent/**/*.proto"
              Link="proto\kurrent\%(RecursiveDir)/%(FileName)%(Extension)"
              AdditionalImportDirs="../../proto"
              Access="Public" />

    <!-- google -->
    <Protobuf ProtoRoot="../../proto/google"
              Include="../../proto/google/**/*.proto"
              Link="proto\google\%(RecursiveDir)/%(FileName)%(Extension)"
              Access="Internal"
              ProtoCompile="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kurrent.Client" />
    <InternalsVisibleTo Include="Kurrent.Client.Tests" />
    <InternalsVisibleTo Include="Kurrent.Streaming" />
    <InternalsVisibleTo Include="Kurrent.Sdk.Testkit" />
    <InternalsVisibleTo Include="Kurrent.Sdk.Testkit.Hosting" />
    <InternalsVisibleTo Include="Aspire.Hosting.KurrentDB" />
    <InternalsVisibleTo Include="Kurrent.Client.Benchmarks" />
  </ItemGroup>

  <Import Project="..\Packable.targets" />

</Project>
