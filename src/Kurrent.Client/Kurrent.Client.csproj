<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Kurrent.Client</PackageId>
    <IsPackable>true</IsPackable>
    <Title>Kurrent .NET Client</Title>
    <Product>Kurrent .NET Client</Product>
    <Description>The official .NET client for the Kurrent Platform. Get the open source or commercial versions of KurrentDB from https://kurrent.io/</Description>
    <PackageTags>kurrent kurrentdb client sdk eventstore event-sourcing</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeHttpRuleProtos>true</IncludeHttpRuleProtos>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <RootNamespace>Kurrent</RootNamespace>
    
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <!-- AOT/Trimming Support -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The contract layer: client interfaces + the data types they accept/return. A normal package
         dependency (not bundled) — Kurrent.Client.nupkg depends on Kurrent.Abstractions.nupkg. -->
    <ProjectReference Include="..\Kurrent.Abstractions\Kurrent.Abstractions.csproj" />
    <ProjectReference Include="..\Kurrent.Client.SourceGenerators\Kurrent.Client.SourceGenerators.csproj" Analyzer="true" />
    <ProjectReference Include="..\Variant.SourceGenerators\Variant.SourceGenerators.csproj" Analyzer="true" />
    <!-- The message declaration layer (SchemaName, catalogs, resolver, naming) lives here now.
         PrivateAssets="none" so the nuspec dependency carries ALL assets: the catalog generator ships
         in Kurrent.Schema.Catalogs's analyzers/dotnet/cs and must flow to consumers that install
         Kurrent.Client (NuGet excludes Build,Analyzers on dependency edges by default). The generator
         is wired onto THIS project's own compilation by Directory.Build.targets (_SdkSourceRef). -->
    <ProjectReference Include="..\Kurrent.Schema.Catalogs\Kurrent.Schema.Catalogs.csproj" PrivateAssets="none" />
    <!-- Variant.SourceGenerators (above) still runs here for the client's own IVariant unions
         (TransportSecurity, ClientCredentials). The Variant RUNTIME assembly is NOT bundled here:
         Kurrent.Abstractions bundles it, and Kurrent.Client gets it transitively through that package
         reference. Bundling it in both would ship Kurrent.Variant.dll twice and conflict at restore. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Api.CommonProtos" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Google.Protobuf.Tools" PrivateAssets="All" />
    <PackageReference Include="Grpc.StatusProto" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
<!--    <PackageReference Include="Microsoft.Extensions.Diagnostics.ExceptionSummarization" />-->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" />
    <PackageReference Include="NJsonSchema" />
    <PackageReference Include="NodaTime.Serialization.SystemTextJson" />
  </ItemGroup>

  <ItemGroup>
    <!-- protocol -->
    <Protobuf ProtoRoot="../../proto/kurrentdb/protocol"
              Include="../../proto/kurrentdb/protocol/**/*.proto"
              Link="Contracts\kurrentdb\protocol\%(RecursiveDir)/%(FileName)%(Extension)"
              AdditionalImportDirs="../../proto"
              Access="Internal"
              GrpcServices="Client"
              Exclude="../../proto/kurrentdb/protocol/v1/code.proto;../../proto/kurrentdb/protocol/v1/status.proto;../../proto/kurrentdb/protocol/v0/**/*.proto" />

    <!-- kurrent -->
    <Protobuf ProtoRoot="../../proto/kurrent"
              Include="../../proto/kurrent/rpc/**/*.proto"
              Link="Contracts\kurrent\rpc\%(RecursiveDir)/%(FileName)%(Extension)"
              AdditionalImportDirs="../../proto"
              Access="Public" />

    <!-- google -->
    <Protobuf ProtoRoot="../../proto/google"
              Include="../../proto/google/**/*.proto"
              Link="Contracts\google\%(RecursiveDir)/%(FileName)%(Extension)"
              Access="Internal"
              ProtoCompile="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kurrent.Client" />
    <InternalsVisibleTo Include="Kurrent.Client.Arrow" />
    <InternalsVisibleTo Include="Kurrent.Client.Tests" />
    <InternalsVisibleTo Include="Kurrent.Streaming" />
    <InternalsVisibleTo Include="Kurrent.Streaming.Tests" />
    <InternalsVisibleTo Include="Kurrent.Sdk.Testkit" />
    <InternalsVisibleTo Include="Kurrent.Sdk.Testkit.Hosting" />
    <InternalsVisibleTo Include="Aspire.Hosting.KurrentDB" />
    <InternalsVisibleTo Include="Kurrent.Client.Benchmarks" />
  </ItemGroup>


</Project>
