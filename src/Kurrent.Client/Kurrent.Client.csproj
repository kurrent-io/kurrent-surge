<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Kurrent.Client</PackageId>
    <IsPackable>true</IsPackable>
    <Title>Kurrent .NET Client</Title>
    <Product>Kurrent .NET Client</Product>
    <Description>The official .NET client for the Kurrent Platform. Get the open source or commercial versions of KurrentDB from https://kurrent.io/</Description>
    <PackageTags>kurrent kurrentdb client sdk eventstore event-sourcing</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeHttpRuleProtos>true</IncludeHttpRuleProtos>
    <!-- Embed project reference assemblies (e.g. Kurrent.Variant.dll) into lib/{tfm}/ during pack -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackProjectDependencies</TargetsForTfmSpecificBuildOutput>
    <!-- Embed source generator DLLs into analyzers/dotnet/cs/ during pack -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackSourceGenerators</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!-- AOT/Trimming Support -->
  <!--  <PropertyGroup>-->
  <!--    <IsTrimmable>true</IsTrimmable>-->
  <!--    <IsAotCompatible>true</IsAotCompatible>-->
  <!--    <PublishAot>true</PublishAot>-->
  <!--    <PublishTrimmed>true</PublishTrimmed>-->
  <!--  </PropertyGroup>-->

  <ItemGroup>
    <ProjectReference Include="..\Kurrent.Client.SourceGenerators\Kurrent.Client.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Variant.SourceGenerators\Variant.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Variant\Variant.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNext.Threading" />
    <PackageReference Include="Google.Api.CommonProtos" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Google.Protobuf.Tools" />
    <PackageReference Include="Grpc.StatusProto" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="Humanizer.Core" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.ExceptionSummarization" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" /> <!-- for the backdoor client -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" />
    <PackageReference Include="NJsonSchema" />
    <PackageReference Include="NodaTime.Serialization.SystemTextJson" />
  </ItemGroup>

  <ItemGroup>
    <!-- protocol -->
    <Protobuf ProtoRoot="../../proto/kurrentdb/protocol"
              Include="../../proto/kurrentdb/protocol/**/*.proto"
              Link="proto\kurrentdb\protocol\%(RecursiveDir)/%(FileName)%(Extension)"
              AdditionalImportDirs="../../proto"
              Access="Internal"
              GrpcServices="Client"
              Exclude="../../proto/kurrentdb/protocol/v1/code.proto;../../proto/kurrentdb/protocol/v1/status.proto;../../proto/kurrentdb/protocol/v0/**/*.proto" />

    <!-- kurrent -->
    <Protobuf ProtoRoot="../../proto/kurrent"
              Include="../../proto/kurrent/**/*.proto"
              Link="proto\kurrent\%(RecursiveDir)/%(FileName)%(Extension)"
              AdditionalImportDirs="../../proto"
              Access="Public" />

    <!-- google -->
    <Protobuf ProtoRoot="../../proto/google"
              Include="../../proto/google/**/*.proto"
              Link="proto\google\%(RecursiveDir)/%(FileName)%(Extension)"
              Access="Internal"
              ProtoCompile="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kurrent.Client" />
    <InternalsVisibleTo Include="Kurrent.Client.Tests" />
    <InternalsVisibleTo Include="Kurrent.Client.Integration.Tests" />
    <InternalsVisibleTo Include="Kurrent.Processors" />
    <InternalsVisibleTo Include="Kurrent.Sdk.Testkit" />
    <InternalsVisibleTo Include="Kurrent.SDK.Testing" />
  </ItemGroup>

  <!--
    Embed internal project-reference DLLs into the NuGet package.

    Why: Projects like Variant are internal — they can't be published as separate
    packages. Without this target, NuGet would list them as package dependencies
    that don't exist on any feed, breaking consumers.

    How it works: MSBuild tags every resolved assembly with NuGetPackageId metadata.
    NuGet-sourced assemblies get the package id (e.g. "Google.Protobuf").
    Project-reference assemblies get an empty string.
    We filter on that to include only project-built DLLs.

    Source generators (ReferenceOutputAssembly="false") never appear in
    ReferenceCopyLocalPaths, so they are excluded automatically.

    Result: only Kurrent.Variant.dll is embedded. NuGet dependencies remain
    declared in the nuspec and resolved at restore time.
  -->
  <Target Name="PackProjectDependencies">
    <ItemGroup>
      <!-- NuGetPackageId is empty = came from a project reference, not a NuGet package -->
      <_ProjectRefDlls Include="@(ReferenceCopyLocalPaths)"
                       Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' == '' AND '%(Extension)' == '.dll'" />
      <!-- The main assembly is already packed by the SDK -->
      <_ProjectRefDlls Remove="@(_ProjectRefDlls)"
                       Condition="'%(FileName)' == '$(AssemblyName)'" />
      <!-- Ship in lib/{tfm}/ alongside Kurrent.Client.dll -->
      <BuildOutputInPackage Include="@(_ProjectRefDlls)" />
    </ItemGroup>
  </Target>

  <!--
    Embed source-generator DLLs into analyzers/dotnet/cs/ inside the NuGet package.

    Source generators are referenced with OutputItemType="Analyzer" and
    ReferenceOutputAssembly="false", so they never appear in ReferenceCopyLocalPaths
    and are excluded by PackProjectDependencies above. This target collects them
    separately and places them where NuGet expects Roslyn analyzers.

    TargetFramework=netstandard2.0 is passed explicitly because generator projects
    target netstandard2.0 (required by Roslyn), not the consuming project's TFMs.
  -->
  <Target Name="PackSourceGenerators">
    <MSBuild Projects="@(ProjectReference)"
             Condition="'%(ProjectReference.OutputItemType)' == 'Analyzer'"
             Targets="GetTargetPath"
             Properties="TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="_SourceGeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_SourceGeneratorAssembly)"
                              PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
