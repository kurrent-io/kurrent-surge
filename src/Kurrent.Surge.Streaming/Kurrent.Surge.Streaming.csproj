<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kurrent.Streaming</PackageId>
    <IsPackable>true</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <Title>Kurrent .NET Processors</Title>
    <Product>Kurrent .NET Processors</Product>
    <Description>An event processing framework for the Kurrent Platform. Build streaming processors with automatic checkpointing and partitioning.</Description>
    <PackageTags>kurrent kurrentdb processors event-processing stream-processing event-sourcing</PackageTags>
    <RootNamespace>Kurrent</RootNamespace>

    <!-- The source-generated metric attributes expose `Unit` and the generic `[Gauge<T>]` under the
         EXTEXP0003 experimental gate (Microsoft.Extensions.Diagnostics.Metrics). We rely on both for
         base-unit (s/By) instruments and pushed lag gauges. -->
    <NoWarn>$(NoWarn);EXTEXP0003</NoWarn>

    <!-- <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator> -->
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets="none" so the nuspec dependency on Kurrent.Client includes ALL assets:
         the message catalog generator ships in Kurrent.Client's analyzers/dotnet/cs and must
         flow to consumers that install only Kurrent.Streaming (NuGet excludes Build,Analyzers
         on dependency edges by default). -->
    <ProjectReference Include="..\Kurrent.Surge\Kurrent.Surge.csproj" PrivateAssets="none" />
  </ItemGroup>

  <!-- AOT/Trimming Support -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
<!--    <ProjectReference Include="..\Kurrent.Client.SourceGenerators\Kurrent.Client.SourceGenerators.csproj" Analyzer="true" />-->
    <ProjectReference Include="..\Kurrent.Surge.Core\Kurrent.Surge.Core.csproj" />
    <ProjectReference Include="..\Variant.SourceGenerators\Variant.SourceGenerators.csproj" Analyzer="true" />
    <ProjectReference Include="..\Variant\Variant.csproj" Bundle="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kurrent.Streaming.Tests" />
    <InternalsVisibleTo Include="Kurrent.Streaming.Integration.Tests" />
    <InternalsVisibleTo Include="Kurrent.Client.Benchmarks" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Google.Protobuf.Tools" PrivateAssets="All" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="OpenTelemetry.Api" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Polly.Extensions" />
  </ItemGroup>


  <!-- The streaming proto contracts (checkpoints.proto: PartitionsCheckpointed, CheckpointReset,
       PartitionPosition) are compiled by Kurrent.Streaming.Core and consumed here through the project
       reference above. Compiling the proto here as well would emit a SECOND set of public contract types
       in this assembly; the same-assembly copy wins at compile time, so the store would append types the
       Core-owned message catalog never mapped — SchemaNameNotMappedException at serialize. One owner. -->

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>



</Project>
