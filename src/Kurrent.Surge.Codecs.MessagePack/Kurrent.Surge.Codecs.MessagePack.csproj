<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kurrent.Surge.Codecs.MessagePack</PackageId>
    <IsPackable>true</IsPackable>
    <Title>Kurrent Surge MessagePack Codec</Title>
    <Product>Kurrent Surge MessagePack Codec</Product>
    <Description>MessagePack codec for Kurrent Surge, built on the official MessagePack-CSharp library. Native AOT and trim safe. Requires a source-generated resolver for your message types.</Description>
    <PackageTags>kurrent kurrentdb surge messagepack serialization schema aot</PackageTags>
  </PropertyGroup>

  <!-- AOT/Trimming Support -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Public dependency: Kurrent.Surge.Codecs.MessagePack.nupkg depends on Kurrent.Surge.Core.nupkg,
         which declares ISchemaCodec — the pure, dependency-free codec surface this package
         plugs into. -->
    <ProjectReference Include="..\Kurrent.Surge.Core\Kurrent.Surge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" />
  </ItemGroup>

</Project>
