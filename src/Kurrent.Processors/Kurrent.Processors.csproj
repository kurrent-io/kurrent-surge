<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kurrent.Processors</PackageId>
    <IsPackable>true</IsPackable>
    <Title>Kurrent .NET Processors</Title>
    <Product>Kurrent .NET Processors</Product>
    <Description>An event processing framework for the Kurrent Platform. Build streaming processors with automatic checkpointing and partitioning.</Description>
    <PackageTags>kurrent kurrentdb processors event-processing stream-processing event-sourcing</PackageTags>
    <!-- Embed project reference assemblies (e.g. Kurrent.Variant.dll) into lib/{tfm}/ during pack -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackProjectDependencies</TargetsForTfmSpecificBuildOutput>
    <!-- Embed source generator DLLs into analyzers/dotnet/cs/ during pack -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackSourceGenerators</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kurrent.Client\Kurrent.Client.csproj" />
  </ItemGroup>

  <!-- AOT/Trimming Support -->
  <!--  <PropertyGroup>-->
  <!--    <IsTrimmable>true</IsTrimmable>-->
  <!--    <IsAotCompatible>true</IsAotCompatible>-->
  <!--    <PublishAot>true</PublishAot>-->
  <!--    <PublishTrimmed>true</PublishTrimmed>-->
  <!--  </PropertyGroup>-->

  <ItemGroup>
    <!-- Source Generators: Embed as analyzer, don't propagate as dependency -->
    <ProjectReference Include="..\Kurrent.Client.SourceGenerators\Kurrent.Client.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />

    <ProjectReference Include="..\Variant.SourceGenerators\Variant.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />

    <!-- Runtime Library: Include assembly but don't propagate as dependency -->
    <ProjectReference Include="..\Variant\Variant.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kurrent.Processors.Tests" />
    <InternalsVisibleTo Include="Kurrent.Processors.Integration.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HashDepot" />
    <PackageReference Include="NodaTime.Serialization.SystemTextJson" />
    <PackageReference Include="OpenTelemetry.Api" />
    <PackageReference Include="shortid" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\ErrorMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ErrorMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Remove="Leases\**" />
    <EmbeddedResource Remove="Locks\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Leases\**" />
    <Compile Remove="Locks\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Leases\**" />
    <None Remove="Locks\**" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Hosting\" />
    <Folder Include="Options\" />
  </ItemGroup>

  <!--
    Embed internal project-reference DLLs into the NuGet package.

    Only project references with PrivateAssets="all" are embedded — these are
    internal libraries that don't ship as their own packages (e.g. Kurrent.Variant).

    Project references WITHOUT PrivateAssets="all" (e.g. Kurrent.Client) are
    declared as NuGet dependencies automatically by the SDK — not embedded.

    Source generators (ReferenceOutputAssembly="false") are excluded by the
    Condition below.

    GetTargetPath is a lightweight MSBuild target that returns the output
    assembly path without triggering a build. Passing TargetFramework ensures
    we get the correct TFM-specific assembly.
  -->
  <Target Name="PackProjectDependencies">
    <MSBuild Projects="@(ProjectReference)"
             Condition="'%(ProjectReference.PrivateAssets)' == 'all'
                        AND '%(ProjectReference.ReferenceOutputAssembly)' != 'false'"
             Targets="GetTargetPath"
             Properties="TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_PrivateProjectAssembly" />
    </MSBuild>
    <ItemGroup>
      <BuildOutputInPackage Include="@(_PrivateProjectAssembly)" />
    </ItemGroup>
  </Target>

  <!--
    Embed source-generator DLLs into analyzers/dotnet/cs/ inside the NuGet package.

    Source generators are referenced with OutputItemType="Analyzer" and
    ReferenceOutputAssembly="false", so they never appear in ReferenceCopyLocalPaths
    and are excluded by PackProjectDependencies above. This target collects them
    separately and places them where NuGet expects Roslyn analyzers.

    TargetFramework=netstandard2.0 is passed explicitly because generator projects
    target netstandard2.0 (required by Roslyn), not the consuming project's TFMs.
  -->
  <Target Name="PackSourceGenerators">
    <MSBuild Projects="@(ProjectReference)"
             Condition="'%(ProjectReference.OutputItemType)' == 'Analyzer'"
             Targets="GetTargetPath"
             Properties="TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="_SourceGeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_SourceGeneratorAssembly)"
                              PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
