<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kurrent.Streaming</PackageId>
    <IsPackable>true</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <Title>Kurrent .NET Processors</Title>
    <Product>Kurrent .NET Processors</Product>
    <Description>An event processing framework for the Kurrent Platform. Build streaming processors with automatic checkpointing and partitioning.</Description>
    <PackageTags>kurrent kurrentdb processors event-processing stream-processing event-sourcing</PackageTags>

<!--    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>-->
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets="none" so the nuspec dependency on Kurrent.Client includes ALL assets:
         the message catalog generator ships in Kurrent.Client's analyzers/dotnet/cs and must
         flow to consumers that install only Kurrent.Streaming (NuGet excludes Build,Analyzers
         on dependency edges by default). -->
    <ProjectReference Include="..\Kurrent.Client\Kurrent.Client.csproj" PrivateAssets="none" />
  </ItemGroup>

  <!-- AOT/Trimming Support -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kurrent.Client.SourceGenerators\Kurrent.Client.SourceGenerators.csproj" Analyzer="true" />
    <ProjectReference Include="..\Kurrent.Client.MessageCatalogs.Generators\Kurrent.Client.MessageCatalogs.Generators.csproj" Analyzer="true" />
    <ProjectReference Include="..\Variant.SourceGenerators\Variant.SourceGenerators.csproj" Analyzer="true" />
    <ProjectReference Include="..\Variant\Variant.csproj" Bundle="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kurrent.Streaming.Tests" />
    <InternalsVisibleTo Include="Kurrent.Streaming.Integration.Tests" />
    <InternalsVisibleTo Include="Kurrent.Client.Benchmarks" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full" />
    <PackageReference Include="kurrent.quack" />
    <PackageReference Include="NodaTime.Serialization.SystemTextJson" />
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\ErrorMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ErrorMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Remove="Leases\**" />
    <EmbeddedResource Remove="Locks\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Leases\**" />
    <Compile Remove="Locks\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Leases\**" />
    <None Remove="Locks\**" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Checkpointing\Storage\" />
    <Folder Include="Hosting\" />
    <Folder Include="Configuration\" />
    <Folder Include="Processors\" />
  </ItemGroup>



</Project>
