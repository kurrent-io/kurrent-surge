<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Kurrent</RootNamespace>
    <IsPackable>false</IsPackable>
    <AssemblyName>Kurrent.Variant</AssemblyName>
    <!-- Embed PDB in the DLL so debuggers can step in when this assembly is -->
    <!-- shipped inside another package (Kurrent.Client, Kurrent.Processors) -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kurrent.Variant.Tests" />
  </ItemGroup>
</Project>
