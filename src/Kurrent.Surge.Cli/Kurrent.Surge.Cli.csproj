<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageId>Kurrent.Surge.Cli</PackageId>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>surge</ToolCommandName>
    <Title>Kurrent Surge CLI</Title>
    <Product>Kurrent Surge CLI</Product>
    <Description>Command-line tool for Hugging Face model acquisition — inspect, download, and locate the local cache — over Kurrent.Surge.AI.HuggingFace.</Description>
    <PackageTags>kurrent surge cli huggingface onnx gguf safetensors model download</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <RootNamespace>Kurrent.Surge.Cli</RootNamespace>
  </PropertyGroup>

  <!-- AOT/Trimming Support -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kurrent.Surge.AI.HuggingFace\Kurrent.Surge.AI.HuggingFace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Kurrent.Surge.AI.HuggingFace" />
    <Using Include="System.CommandLine" />
    <Using Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kurrent.Surge.Cli.Tests" />
  </ItemGroup>
</Project>
