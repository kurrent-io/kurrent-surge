<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kurrent.Surge.MessagePack.Nerdbank</PackageId>
    <IsPackable>true</IsPackable>
    <Title>Kurrent Surge MessagePack Serializer (Nerdbank)</Title>
    <Product>Kurrent Surge MessagePack Serializer (Nerdbank)</Product>
    <Description>An ISchemaCodec for the Kurrent .NET SDK backed by Nerdbank.MessagePack, the AOT- and trim-safe successor to classic MessagePack-CSharp built on PolyType type shapes with no reflection fallback. Consumers register their message types on a PolyType witness class and supply its generated ITypeShapeProvider through MessagePackSchemaSerializerOptions.</Description>
    <PackageTags>kurrent kurrentdb surge messagepack msgpack serialization aot polytype</PackageTags>
  </PropertyGroup>

  <!-- AOT/Trimming Support -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Public dependency: Kurrent.Surge.Core is itself a published package and declares
         ISchemaCodec — the pure, dependency-free codec surface this package plugs into. -->
    <ProjectReference Include="..\Kurrent.Surge.Core\Kurrent.Surge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.MessagePack" />
  </ItemGroup>

</Project>
