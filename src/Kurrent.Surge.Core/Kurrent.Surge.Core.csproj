<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kurrent.Surge.Core</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Kurrent.Surge</RootNamespace>
    <Title>Kurrent .NET Abstractions</Title>
    <Product>Kurrent .NET Abstractions</Product>
    <Description>The contract layer for the Kurrent .NET SDK: the client and stream-processing interfaces and the data types they exchange — options, results, value objects, filters, and the streaming wire contracts — plus the message declaration layer (catalogs, schema names, naming strategies) with its compile-time catalog generator, and the built-in JSON, Protobuf, and Avro codecs with the compile-time Avro codec generator. No gRPC client or transport. Reference this to depend on the Kurrent contracts without the implementation.</Description>
    <PackageTags>kurrent kurrentdb abstractions contracts sdk event-sourcing stream-processing</PackageTags>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>

    <!-- The source-generated metric attributes (Unit, generic [Gauge<T>]) sit behind the
         EXTEXP0003 experimental gate (Microsoft.Extensions.Diagnostics.Metrics), used by the
         streaming instruments merged in from Kurrent.Streaming.Core. -->
    <NoWarn>$(NoWarn);EXTEXP0003</NoWarn>
  </PropertyGroup>

  <!-- AOT/Trimming Support -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generates the union plumbing for the IVariant contract types that move here
         (SubscribeMessage, ReadMessage, ExpectedStreamState, ConsistencyCheck, SchemaIdentifier).
         Variant ships bundled (not a standalone package), so its runtime assembly flows inside
         this package and transitively to Kurrent.Surge. -->
    <ProjectReference Include="..\Variant.SourceGenerators\Variant.SourceGenerators.csproj" Analyzer="true" />
    <!-- One merged generator assembly: unique identifiers from [UniqueIdentifier], and the Avro
         message types and AOT-safe codecs from .avsc AdditionalFiles. Packed so both run in
         consumer compilations. Referenced directly rather than added to @(PackedAnalyzerProject) —
         that list is shared, so adding it there would ship this generator inside every other
         packed package too. -->
    <ProjectReference Include="..\Kurrent.Surge.Generators\Kurrent.Surge.Generators.csproj" PackedAnalyzer="true" />
    <ProjectReference Include="..\Variant\Variant.csproj" Bundle="true" />
    <!-- The filter engine behind RecordFilter/ExpressionFilter. Bundled rather than referenced as a
         package: it is not published on its own, so its assembly ships inside this one. -->
    <ProjectReference Include="..\Kurrent.Surge.RecordFilters\Kurrent.Surge.RecordFilters.csproj" Bundle="true" />
    <!-- The message-catalog generator. It runs on THIS compilation (the streaming proto contracts need
         their generated catalog — checkpoint appends fail to map without it) and ships in
         analyzers/dotnet/cs so it runs in consumer compilations. @(PackedAnalyzerProject) is the shared
         list (Directory.Build.props); Directory.Build.targets wires the same set onto in-repo source
         consumers, since analyzers are not transitive through a ProjectReference. -->
    <ProjectReference Include="@(PackedAnalyzerProject)" PackedAnalyzer="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet imports build/{PackageId}.props into the consumer's build automatically, which is what
         makes the KurrentAvro* properties visible to the codec generator. -->
    <None Include="build\**" Pack="true" PackagePath="build" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Avro schema model and its parser are shared with the codec generator rather than
         reimplemented. AvroJsonWriter reads a schema at run time, the generator reads the same schema
         at compile time, and a second parser would be a second reading of the Avro specification to
         keep in step. These files depend on nothing but the BCL, so they compile here as they do
         under netstandard2.0. -->
    <Compile Include="..\Kurrent.Surge.Generators\Json\JsonValue.cs" Link="Schema\Codecs\Avro\Schema\JsonValue.cs" />
    <Compile Include="..\Kurrent.Surge.Generators\Model\AvroSchema.cs" Link="Schema\Codecs\Avro\Schema\AvroSchema.cs" />
    <Compile Include="..\Kurrent.Surge.Generators\Model\AvroSchemaParser.cs" Link="Schema\Codecs\Avro\Schema\AvroSchemaParser.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Google.Protobuf.Tools" PrivateAssets="All" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />

    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.AutoActivation" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Resilience" />

    <PackageReference Include="NJsonSchema" />
    <!-- Public dependency: NanoInstantExtensions exposes NodaTime.Instant, and the NodaTime time model
         emits its types into the consumer's generated code. A public surface must not rest on the
         transitive reference NodaTime.Serialization.SystemTextJson happens to carry. -->
    <PackageReference Include="NodaTime" />
    <PackageReference Include="NodaTime.Serialization.SystemTextJson" />

    <PackageReference Include="Ulid" />
  </ItemGroup>

  <ItemGroup>
    <!-- Streaming wire contracts merged from Kurrent.Streaming.Core. Message types only
         (no GrpcServices); Access=Public so consumers see them. -->
    <Protobuf ProtoRoot="../../proto/kurrent"
              Include="../../proto/kurrent/streaming/**/*.proto"
              Link="Contracts\%(RecursiveDir)/%(FileName)%(Extension)"
              AdditionalImportDirs="../../proto"
              Access="Public" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Moved contract types carry internal members the implementation writes (e.g. Record.Value
         has an internal set; the Internal/Validation infra is internal). The assemblies that touch
         those internals are granted access here. -->
    <!-- The AvroJsonSchema round-trip gate compares parsed schema models, and the model and its
         parser are internal. -->
    <InternalsVisibleTo Include="Kurrent.Surge.Codecs.Avro.Tests" />
    <InternalsVisibleTo Include="Aspire.Hosting.KurrentDB" />
    <InternalsVisibleTo Include="Kurrent.Surge" />
    <InternalsVisibleTo Include="Kurrent.Surge.Arrow" />
    <InternalsVisibleTo Include="Kurrent.Surge.Schema.Validation" />
    <InternalsVisibleTo Include="Kurrent.Surge.Tests" />
    <InternalsVisibleTo Include="Kurrent.Surge.Streaming.Tests" />
    <InternalsVisibleTo Include="Kurrent.Surge.Benchmarks" />
    <InternalsVisibleTo Include="Kurrent.Surge.Testkit" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Client\Modules\Streams\Filters\ExpressionFilter\" />
    <Folder Include="Experimental\Components\" />
    <Folder Include="Schema\Codecs\Protobuf\Experimental\" />
  </ItemGroup>

</Project>
