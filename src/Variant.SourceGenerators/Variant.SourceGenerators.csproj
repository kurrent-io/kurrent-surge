<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Kurrent.Variant.SourceGenerators</RootNamespace>
    <AssemblyName>Kurrent.Variant.SourceGenerators</AssemblyName>

    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>

      <!-- This ensures the project itself is treated as an analyzer package -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>
    
  <ItemGroup>
    <ProjectReference Include="..\Kurrent.CodeAnalysis\Kurrent.CodeAnalysis.csproj"
                      PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPaths</GetTargetPathDependsOn>
    <GetTargetPathWithTargetPlatformMonikerDependsOn>$(GetTargetPathWithTargetPlatformMonikerDependsOn);GetDependencyTargetPaths</GetTargetPathWithTargetPlatformMonikerDependsOn>
  </PropertyGroup>

  <!-- Forward Kurrent.CodeAnalysis.dll through GetTargetPath so consumers that reference
       this generator as OutputItemType="Analyzer" pick it up as an analyzer too. -->
  <Target Name="GetDependencyTargetPaths" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker
          Include="@(ReferenceCopyLocalPaths)"
          Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'Kurrent.CodeAnalysis' AND '%(ReferenceCopyLocalPaths.Extension)' == '.dll'"
          IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>
</Project>
