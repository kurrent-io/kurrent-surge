<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kurrent.Surge.Codecs.NerdbankMessagePack</PackageId>
    <IsPackable>true</IsPackable>
    <Title>Kurrent Surge MessagePack Codec (Nerdbank)</Title>
    <Product>Kurrent Surge MessagePack Codec (Nerdbank)</Product>
    <Description>MessagePack codec for Kurrent Surge, built on Nerdbank.MessagePack. Native AOT and trim safe.</Description>
    <PackageTags>kurrent kurrentdb surge messagepack msgpack serialization aot polytype</PackageTags>
  </PropertyGroup>

  <!-- AOT/Trimming Support -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Public dependency: Kurrent.Surge.Core is itself a published package and declares
         ISchemaCodec — the pure, dependency-free codec surface this package plugs into. -->
    <ProjectReference Include="..\Kurrent.Surge.Core\Kurrent.Surge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.MessagePack" />
  </ItemGroup>

</Project>
