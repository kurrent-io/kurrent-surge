<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Plain helper library of Roslyn utilities for BUILDING source generators. NOT an
         analyzer and never packaged: its source is compiled directly into each generator
         via Kurrent.CodeAnalysis.Sources.props. This project remains only as the source
         home and the unit-test target (Kurrent.CodeAnalysis.Tests). -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Description>Thin ergonomic layer over Roslyn's incremental source generator API. Provides value-equatable TypeInfo records, a fluent selector builder, and safe-by-construction cache semantics.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <IncludeAssets>analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PolySharp">
      <IncludeAssets>analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <PolySharpIncludeRuntimeSupportedAttributes>true</PolySharpIncludeRuntimeSupportedAttributes>
  </PropertyGroup>
</Project>
