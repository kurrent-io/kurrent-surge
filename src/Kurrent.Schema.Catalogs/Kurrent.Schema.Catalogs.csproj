<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kurrent.Schema.Catalogs</PackageId>
    <IsPackable>true</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <Title>Kurrent .NET Schema Catalogs</Title>
    <Product>Kurrent .NET Schema Catalogs</Product>
    <Description>The message declaration layer for the Kurrent Platform. Declare which message types exist and the wire names they carry from dependency-light contracts/domain assemblies — no gRPC, no client. The Kurrent client references the same package, so both sides speak the same types.</Description>
    <PackageTags>kurrent kurrentdb schema message-catalog contracts event-sourcing</PackageTags>
  </PropertyGroup>

  <!-- AOT/Trimming Support -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The message catalog generator ships INSIDE this package (analyzers/dotnet/cs) so catalogs
         generate in consumer compilations. @(PackedAnalyzerProject) is the shared list
         (Directory.Build.props); Directory.Build.targets wires the same set for in-repo source
         consumers (analyzers are not transitive through a ProjectReference). -->
    <ProjectReference Include="@(PackedAnalyzerProject)" PackedAnalyzer="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- BuildResolver in Kurrent.Client still calls internal MessageCatalogDiscovery.GetCatalogs();
         discovery stays internal to this package, so the client needs visibility. -->
    <InternalsVisibleTo Include="Kurrent.Client" />
    <InternalsVisibleTo Include="Kurrent.Schema.Catalogs.Tests" />
    <InternalsVisibleTo Include="Kurrent.Client.Tests" />
    <InternalsVisibleTo Include="Kurrent.Sdk.Testkit" />
    <InternalsVisibleTo Include="Kurrent.Streaming" />
    <InternalsVisibleTo Include="Kurrent.Streaming.Core" />
    <InternalsVisibleTo Include="Kurrent.Streaming.Tests" />
  </ItemGroup>

</Project>
