<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kurrent.Surge.Mcp</PackageId>
    <IsPackable>true</IsPackable>
    <Title>Kurrent Surge MCP Task Store</Title>
    <Product>Kurrent Surge MCP Task Store</Product>
    <Description>Self-contained DuckDB-backed IMcpTaskStore for the Model Context Protocol C# SDK (ModelContextProtocol.Core 2.0). Durable, restart-surviving task persistence for MCP servers.</Description>
    <PackageTags>kurrent mcp model-context-protocol task-store duckdb</PackageTags>
    <!-- IMcpTaskStore and the task protocol types are marked experimental in the MCP SDK. -->
    <NoWarn>$(NoWarn);MCPEXP001</NoWarn>
  </PropertyGroup>

  <!-- AOT/Trimming Support -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Source-generate the options binder so DuckDBTaskStoreOptions can be read from IConfiguration under AOT. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" />
    <PackageReference Include="DuckDB.NET.Data.Full" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="kurrent.quack" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kurrent.Surge.Mcp.Tests" />
  </ItemGroup>

</Project>
