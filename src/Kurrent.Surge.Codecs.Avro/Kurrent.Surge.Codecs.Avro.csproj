<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kurrent.Surge.Codecs.Avro</PackageId>
    <IsPackable>true</IsPackable>
    <Title>Kurrent Surge Avro Codec</Title>
    <Product>Kurrent Surge Avro Codec</Product>
    <Description>Avro codec for Kurrent Surge, built on the official Apache.Avro library. Message types and their encode/decode code are generated from .avsc schema files at compile time. Native AOT and trim safe.</Description>
    <PackageTags>kurrent kurrentdb surge avro serialization schema aot</PackageTags>
  </PropertyGroup>

  <!-- AOT/Trimming Support -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Public dependency: Kurrent.Surge.Codecs.Avro.nupkg depends on Kurrent.Surge.Core.nupkg, which
         declares ISchemaCodec — the pure, dependency-free codec surface this package plugs into. -->
    <ProjectReference Include="..\Kurrent.Surge.Core\Kurrent.Surge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet imports build/{PackageId}.props into the consumer's build automatically, which is what
         makes the KurrentAvro* properties visible to the generator. -->
    <None Include="build\**" Pack="true" PackagePath="build" />
  </ItemGroup>

  <ItemGroup>
    <!-- The AvroJsonSchema round-trip gate compares parsed schema models, and the model and its parser are
         internal. Comparing exported text instead would mean resolving inherited namespaces in the test
         project — a second reading of the Avro specification, which is what linking the parser avoids. -->
    <InternalsVisibleTo Include="Kurrent.Surge.Codecs.Avro.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The schema model and its parser are shared with the generator rather than reimplemented.
         AvroJsonWriter reads a schema at run time, the generator reads the same schema at compile time,
         and a second parser would be a second reading of the Avro specification to keep in step. These
         files depend on nothing but the BCL, so they compile here as they do under netstandard2.0. -->
    <Compile Include="..\Kurrent.Surge.Codecs.Avro.Generators\Json\JsonValue.cs" Link="Schema\JsonValue.cs" />
    <Compile Include="..\Kurrent.Surge.Codecs.Avro.Generators\Model\AvroSchema.cs" Link="Schema\AvroSchema.cs" />
    <Compile Include="..\Kurrent.Surge.Codecs.Avro.Generators\Model\AvroSchemaParser.cs" Link="Schema\AvroSchemaParser.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Avro" />
    <!-- Public dependency: NanoInstantExtensions exposes NodaTime.Instant, and the NodaTime time model
         emits its types into the consumer's generated code. It reaches here transitively through
         Kurrent.Surge.Core today, but a public surface must not rest on someone else's dependency. -->
    <PackageReference Include="NodaTime" />
    <!-- Emits the message types and the AOT-safe encode/decode code for each .avsc AdditionalFile.
         Referenced directly rather than added to @(PackedAnalyzerProject) — that list is shared, so
         adding it there would ship this generator inside every other packed package too. -->
    <ProjectReference Include="..\Kurrent.Surge.Codecs.Avro.Generators\Kurrent.Surge.Codecs.Avro.Generators.csproj" PackedAnalyzer="true" />
  </ItemGroup>

</Project>
