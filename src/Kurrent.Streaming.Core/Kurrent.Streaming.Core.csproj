<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kurrent.Streaming.Core</PackageId>
    <IsPackable>true</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <Title>Kurrent .NET Processors</Title>
    <Product>Kurrent .NET Processors</Product>
    <Description>An event processing framework for the Kurrent Platform. Build streaming processors with automatic checkpointing and partitioning.</Description>
    <PackageTags>kurrent kurrentdb processors event-processing stream-processing event-sourcing</PackageTags>
    <RootNamespace>Kurrent</RootNamespace>

    <!-- The source-generated metric attributes expose `Unit` and the generic `[Gauge<T>]` under the
         EXTEXP0003 experimental gate (Microsoft.Extensions.Diagnostics.Metrics). We rely on both for
         base-unit (s/By) instruments and pushed lag gauges. -->
    <NoWarn>$(NoWarn);EXTEXP0003</NoWarn>

    <!-- <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator> -->
  </PropertyGroup>

  <!-- AOT/Trimming Support -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
<!--    <ProjectReference Include="..\Kurrent.Client.SourceGenerators\Kurrent.Client.SourceGenerators.csproj" Analyzer="true" />-->
    <ProjectReference Include="..\Kurrent.Surge.Core\Kurrent.Surge.Core.csproj" />
    <!-- Direct (not just transitive via Surge.Core) for two reasons: the filename triggers the
         in-repo packed-analyzer wiring in Directory.Build.targets, so the message catalog
         generator runs on THIS compilation (the streaming proto contracts need their generated
         catalog — checkpoint appends fail to map without it); and PrivateAssets="none" makes the
         nuspec dependency carry ALL assets so NuGet consumers receive the same generator
         (analyzers are excluded on dependency edges by default). -->
    <ProjectReference Include="..\Kurrent.Schema.Catalogs\Kurrent.Schema.Catalogs.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\Variant.SourceGenerators\Variant.SourceGenerators.csproj" Analyzer="true" />
    <ProjectReference Include="..\Variant\Variant.csproj" Bundle="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kurrent.Surge.Streaming" />
    <InternalsVisibleTo Include="Kurrent.Streaming.Tests" />
    <InternalsVisibleTo Include="Kurrent.Streaming.Integration.Tests" />
    <InternalsVisibleTo Include="Kurrent.Client.Benchmarks" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Google.Protobuf.Tools" PrivateAssets="All" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="OpenTelemetry.Api" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Polly.Extensions" />
  </ItemGroup>


  <ItemGroup>
    <Protobuf ProtoRoot="../../proto/kurrent"
              Include="../../proto/kurrent/streaming/**/*.proto"
              Link="Contracts\%(RecursiveDir)/%(FileName)%(Extension)"
              AdditionalImportDirs="../../proto"
              Access="Public" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>



</Project>
